{% doc %}
  @prompt
    Create a new dynamic cart upsell block for the cart page. For every distinct cart product that has a product metafield displayed in Shopify admin as “Featured Frame”, retrieve the referenced frame product and render an upsell card for that frame. Each card must show the frame’s featured image, title, price, and an Add to cart button, without removing or changing the customer’s existing cart items. Do not render the block when none of the cart products have a Featured Frame metafield value. Deduplicate repeated matching frames when multiple cart items refer to the same frame. Make the metafield namespace and key configurable in the block settings, with sensible defaults for a product-reference metafield named Featured Frame. Ensure it is polished, responsive, accessible, and matches the existing theme styling.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% assign featured_frames = '' | split: ',' %}
{% assign featured_frame_ids = '' | split: ',' %}
{% for cart_item in cart.items %}
  {% assign frame_metafield = cart_item.product.metafields[block.settings.metafield_namespace][block.settings.metafield_key] %}
  {% if frame_metafield != blank and frame_metafield.value != blank %}
    {% assign frame_product = frame_metafield.value %}
    {% assign frame_id = frame_product.id | append: '' %}
    {% unless featured_frame_ids contains frame_id %}
      {% assign featured_frame_ids = featured_frame_ids | push: frame_id %}
      {% assign featured_frames = featured_frames | push: frame_product %}
    {% endunless %}
  {% endif %}
{% endfor %}
{% if featured_frames.size > 0 %}
  {% style %}
    .ai-cart-upsell-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;margin:{{ block.settings.spacing_top }}px auto {{ block.settings.spacing_bottom }}px;color:{{ block.settings.text_color }};}
    .ai-cart-upsell-{{ ai_gen_id }}__heading{margin:0 0 20px;font-size:24px;line-height:1.2;color:{{ block.settings.text_color }};}
    .ai-cart-upsell-{{ ai_gen_id }}__grid{display:grid;grid-template-columns:repeat({{ block.settings.columns }},minmax(0,1fr));gap:16px;}
    .ai-cart-upsell-{{ ai_gen_id }}__card{display:flex;flex-direction:column;min-width:0;border:1px solid {{ block.settings.border_color }};background:{{ block.settings.card_background }};padding:12px;}
    .ai-cart-upsell-{{ ai_gen_id }}__image-link{display:block;aspect-ratio:1 / 1;overflow:hidden;background:#f4f4f4;}
    .ai-cart-upsell-{{ ai_gen_id }}__image{display:block;width:100%;height:100%;object-fit:cover;}
    .ai-cart-upsell-{{ ai_gen_id }}__content{display:flex;flex:1;flex-direction:column;gap:8px;padding-top:14px;}
    .ai-cart-upsell-{{ ai_gen_id }}__title{margin:0;font-size:16px;line-height:1.35;color:{{ block.settings.text_color }};}
    .ai-cart-upsell-{{ ai_gen_id }}__title a{color:inherit;text-decoration:none;}
    .ai-cart-upsell-{{ ai_gen_id }}__title a:hover,.ai-cart-upsell-{{ ai_gen_id }}__title a:focus-visible{text-decoration:underline;}
    .ai-cart-upsell-{{ ai_gen_id }}__price{color:{{ block.settings.text_color }};font-size:15px;}
    .ai-cart-upsell-{{ ai_gen_id }}__button{width:100%;margin-top:auto;padding:11px 14px;border:1px solid {{ block.settings.button_background }};border-radius:{{ block.settings.button_radius }}px;background:{{ block.settings.button_background }};color:{{ block.settings.button_text }};cursor:pointer;font:inherit;font-size:14px;}
    .ai-cart-upsell-{{ ai_gen_id }}__button:hover,.ai-cart-upsell-{{ ai_gen_id }}__button:focus-visible{opacity:.86;}
    .ai-cart-upsell-{{ ai_gen_id }}__button[disabled]{cursor:wait;opacity:.6;}
    @media screen and (max-width:749px){.ai-cart-upsell-{{ ai_gen_id }}{width:100%;}.ai-cart-upsell-{{ ai_gen_id }}__grid{grid-template-columns:repeat({{ block.settings.mobile_columns }},minmax(0,1fr));}}
  {% endstyle %}
  <cart-frame-upsell-{{ ai_gen_id }} class="ai-cart-upsell-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
    {% if block.settings.heading != blank %}<h2 class="ai-cart-upsell-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>{% endif %}
    <div class="ai-cart-upsell-{{ ai_gen_id }}__grid">
      {% for frame_product in featured_frames %}
        {% assign frame_variant = frame_product.selected_or_first_available_variant %}
        {% if frame_variant.available %}
          <article class="ai-cart-upsell-{{ ai_gen_id }}__card">
            <a class="ai-cart-upsell-{{ ai_gen_id }}__image-link" href="{{ frame_product.url }}" aria-label="View {{ frame_product.title | escape }}">
              {% if frame_product.featured_image %}<img class="ai-cart-upsell-{{ ai_gen_id }}__image" src="{{ frame_product.featured_image | image_url: width: 700 }}" alt="{{ frame_product.featured_image.alt | default: frame_product.title | escape }}" loading="lazy" width="700" height="700">{% else %}<div class="ai-cart-upsell-{{ ai_gen_id }}__image">{{ 'product-apparel-1' | placeholder_svg_tag }}</div>{% endif %}
            </a>
            <div class="ai-cart-upsell-{{ ai_gen_id }}__content">
              <h3 class="ai-cart-upsell-{{ ai_gen_id }}__title"><a href="{{ frame_product.url }}">{{ frame_product.title | escape }}</a></h3>
              <div class="ai-cart-upsell-{{ ai_gen_id }}__price">{{ frame_variant.price | money }}</div>
              <button class="ai-cart-upsell-{{ ai_gen_id }}__button" type="button" data-variant-id="{{ frame_variant.id }}">{{ block.settings.button_label | escape }}</button>
            </div>
          </article>
        {% endif %}
      {% endfor %}
    </div>
  </cart-frame-upsell-{{ ai_gen_id }}>
  <script>
    (function(){class CartFrameUpsell{{ ai_gen_id }} extends HTMLElement{connectedCallback(){this.querySelectorAll('[data-variant-id]').forEach((button)=>button.addEventListener('click',()=>this.addItem(button)));}async addItem(button){if(button.disabled)return;button.disabled=true;const label=button.textContent;button.textContent='Adding…';try{const response=await fetch(window.Shopify.routes.root+'cart/add.js',{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify({items:[{id:Number(button.dataset.variantId),quantity:1}]})});if(!response.ok)throw new Error('Cart request failed');document.dispatchEvent(new CustomEvent('cart:refresh',{bubbles:true}));button.textContent='Added';window.setTimeout(()=>{button.textContent=label;button.disabled=false;},1400);}catch(error){button.textContent='Try again';button.disabled=false;}}}if(!customElements.get('cart-frame-upsell-{{ ai_gen_id }}'))customElements.define('cart-frame-upsell-{{ ai_gen_id }}',CartFrameUpsell{{ ai_gen_id }});})();
  </script>
{% endif %}
{% schema %}{"name":"Cart frame upsells","tag":null,"class":"cart-frame-upsells-block","settings":[{"type":"header","content":"Content"},{"type":"text","id":"heading","label":"Heading","default":"Complete your artwork"},{"type":"text","id":"button_label","label":"Button label","default":"Add frame"},{"type":"text","id":"metafield_namespace","label":"Metafield namespace","default":"custom"},{"type":"text","id":"metafield_key","label":"Metafield key","default":"featured_frame"},{"type":"header","content":"Layout"},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"select","id":"columns","label":"Columns","options":[{"value":"2","label":"2"},{"value":"3","label":"3"},{"value":"4","label":"4"}],"default":"3"},{"type":"select","id":"mobile_columns","label":"Columns on mobile","options":[{"value":"1","label":"1"},{"value":"2","label":"2"}],"default":"2"},{"type":"range","id":"spacing_top","label":"Top spacing","min":0,"max":60,"step":5,"unit":"px","default":25},{"type":"range","id":"spacing_bottom","label":"Bottom spacing","min":0,"max":60,"step":5,"unit":"px","default":25},{"type":"header","content":"Style"},{"type":"color","id":"text_color","label":"Text","default":"#465A5E"},{"type":"color","id":"card_background","label":"Card background","default":"#FFFFFF"},{"type":"color","id":"border_color","label":"Border","default":"#CDD7DB"},{"type":"color","id":"button_background","label":"Button background","default":"#465A5E"},{"type":"color","id":"button_text","label":"Button text","default":"#FFFFFF"},{"type":"range","id":"button_radius","label":"Button radius","min":0,"max":40,"step":2,"unit":"px","default":0}],"presets":[{"name":"Cart frame upsells"}]}{% endschema %}