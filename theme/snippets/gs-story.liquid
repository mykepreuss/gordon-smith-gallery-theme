{% doc %}
  A long-read page's text as a story (DS-145; DESIGN.md §6.11): one reading column, with
  the text's own pictures and quotes set into it the way a magazine would, from what they are and
  how much text they have around them. Staff choose nothing but the page's template.

  The text is split at its H2 headings. In each part, pictures with nothing between them are a group,
  and a group belongs to the text before it, or to the text after it when only a heading comes
  before it:
  - Long text (120 words or more for each picture): the pictures are spread through it, the first
    before its first paragraph, each offset into the margin with the text wrapping round them.
  - A quote stays where the text puts it, offset the same way, as a pull quote; one that ends its
    part stands in the column between the parts.
  Offset pictures and quotes alternate right and left down the page (CSS).
  - Short text and one picture: the text, with its heading, and the picture side by side, across
    the column and its right margin.
  - Otherwise (two or more pictures, or a picture with no text before it): a row across the page,
    each picture as wide as its shape needs for them all to stand the same height. A row holds
    three at most: more make rows as even as they can be, the longer first. A paragraph of
    eight words or fewer straight after a row is its credit, under it in the caption style.
  The page's first paragraph is its lede, in the deck size. Below 750 px every picture takes the
  column, where the story puts it.

  @param {string} text - The page text, from gs-page-text

  @example
  {%- render 'gs-story', text: text -%}
{% enddoc %}
{%- liquid
  assign cut_item = '<!--gs-item-->'
  assign cut_fig = '<!--gs-fig-->'
  # Words of text for each picture spread through it.
  assign words_per_picture = 120
  assign quote_list = ''
  assign quotes = quote_list | split: cut_fig
  assign page_offsets = 0
  assign blocks = text | split: '<h2'
-%}
<div class="gs-story">
  <div class="gs-prose gs-story__flow">
    {%- for block in blocks -%}
      {%- liquid
        if block == blank
          continue
        endif
        assign html = block
        unless forloop.first
          assign html = '<h2' | append: block
        endunless
        # The page's first paragraph, when the text opens with one, is the lede.
        if forloop.first
          assign opening = html | strip | slice: 0, 3
          if opening == '<p>' or opening == '<p '
            assign html = html | replace_first: '<p', '<p class="gs-story__lede"'
          endif
        endif

        # The part as a sequence: text, a group of pictures, text, ... Each item is 'T' or 'G' and
        # its HTML; a group's figures are joined by cut_fig.
        assign items = ''
        assign group = ''
        assign chunks = html | split: '<figure'
        for chunk in chunks
          if forloop.first
            assign pending = chunk
            continue
          endif
          assign inner = chunk | split: '</figure>' | first
          assign run = chunk | remove_first: inner | remove_first: '</figure>'
          assign opening_tag = '<figure'
          assign ratio = ''
          if inner contains ' width="' and inner contains ' height="'
            assign fw = inner | split: ' width="' | last | split: '"' | first | plus: 0
            assign fh = inner | split: ' height="' | last | split: '"' | first | plus: 0
            if fw > 0 and fh > 0
              assign ratio = fw | times: 1.0 | divided_by: fh | round: 3
              # A tall photo, or a square or tall video, is offset narrower.
              unless inner contains 'gs-figure--artwork' or inner contains 'gs-quote'
                if fh > fw
                  assign opening_tag = '<figure data-gs-tall'
                elsif fh == fw and inner contains '<iframe'
                  assign opening_tag = '<figure data-gs-tall'
                endif
              endunless
            endif
          endif
          if ratio != ''
            assign opening_tag = opening_tag | append: ' style="--gs-r: ' | append: ratio | append: '"'
          endif
          assign fig = opening_tag | append: inner | append: '</figure>'
          if pending == blank and group != ''
            assign group = group | append: cut_fig | append: fig
          else
            if group != ''
              assign items = items | append: 'G' | append: group | append: cut_item
            endif
            assign items = items | append: 'T' | append: pending | append: cut_item
            assign group = fig
          endif
          assign pending = run
        endfor
        if group != ''
          assign items = items | append: 'G' | append: group | append: cut_item
        endif
        assign items = items | append: 'T' | append: pending

        # Lay each group out with the text before it.
        assign out = ''
        assign before = ''
        assign after_row = false
        assign item_list = items | split: cut_item

        # A group with nothing but a heading before it belongs to the text after it (Plan your
        # visit's entrance photo, straight after "Getting Here"): it moves after that text, so it is
        # laid out with it. A quote stays where it is.
        assign reordered = ''
        assign held = ''
        assign text_before = false
        for item in item_list
          assign kind = item | slice: 0, 1
          if kind == 'T'
            assign reordered = reordered | append: item | append: cut_item
            if held != ''
              assign reordered = reordered | append: held | append: cut_item
              assign held = ''
            endif
            assign text_before = false
            if item contains '<p' or item contains '<ul' or item contains '<ol' or item contains '<blockquote' or item contains '<table'
              assign text_before = true
            endif
          else
            assign is_quote = false
            if item contains 'gs-quote'
              assign is_quote = true
            endif
            if text_before == false and forloop.last == false and is_quote == false
              assign held = item
            else
              assign reordered = reordered | append: item | append: cut_item
            endif
          endif
        endfor
        if held != ''
          assign reordered = reordered | append: held
        endif
        assign item_list = reordered | split: cut_item
        for item in item_list
          assign kind = item | slice: 0, 1
          assign body = item | remove_first: kind
          if kind == 'T'
            # A paragraph of eight words or fewer straight after a row is its credit
            # ("Photography by ..."): it sits under the row, in the caption style.
            if after_row
              assign lead_p = body | strip
              assign starts = lead_p | slice: 0, 3
              if starts == '<p>'
                assign credit = lead_p | split: '</p>' | first | append: '</p>'
                assign credit_words = credit | strip_html | strip | split: ' ' | size
                if credit_words > 0 and credit_words <= 8
                  assign credit_tag = credit | replace_first: '<p>', '<p class="gs-story__credit">'
                  assign out = out | append: credit_tag
                  assign body = lead_p | remove_first: credit
                endif
              endif
            endif
            assign after_row = false
            assign before = before | append: body
            continue
          endif
          assign figs = body | split: cut_fig
          assign count = figs.size
          # A quote stays where the text puts it, offset as a pull quote. It holds its place in the
          # text as a marker, so the text around it still counts as one run for the pictures after
          # it, and is put back when the part is done.
          if count == 1 and body contains 'gs-quote'
            assign quote_mark = '<!--gs-q:' | append: quotes.size | append: '-->'
            assign quote_tag = body | replace_first: '<figure', '<figure data-gs-story="offset"'
            assign quote_list = quote_list | append: quote_tag | append: cut_fig
            assign quotes = quote_list | split: cut_fig
            assign before = before | append: quote_mark
            continue
          endif
          assign words = before | strip_html | strip | split: ' ' | size
          assign needed = words_per_picture | times: count
          if words >= needed
            # Spread through the text, each before a paragraph: the first before the first. A
            # picture due straight after a pull quote waits for the next paragraph.
            assign pieces = before | split: '<p'
            assign paragraphs = 0
            for piece in pieces offset: 1
              assign starts = piece | slice: 0, 1
              if starts == '>' or starts == ' '
                assign paragraphs = paragraphs | plus: 1
              endif
            endfor
            assign spread = ''
            assign carry = ''
            assign index = 0
            for piece in pieces
              if forloop.first
                assign spread = spread | append: piece
                continue
              endif
              assign starts = piece | slice: 0, 1
              if starts == '>' or starts == ' '
                for f in figs
                  assign target = forloop.index0 | times: paragraphs | divided_by: count
                  if target == index
                    assign placed_fig = f | replace_first: '<figure', '<figure data-gs-story="offset"'
                    assign carry = carry | append: placed_fig
                  endif
                endfor
                if carry != ''
                  assign tail = spread | strip | split: '<!--gs-q:' | last | append: ''
                  assign tail_size = tail | size
                  assign after_quote = false
                  if tail_size < 8 and tail contains '-->'
                    assign after_quote = true
                  endif
                  unless after_quote
                    assign spread = spread | append: carry
                    assign carry = ''
                  endunless
                endif
                assign index = index | plus: 1
              endif
              assign spread = spread | append: '<p' | append: piece
            endfor
            # Text without paragraphs (a list): the pictures lead it.
            if index == 0
              assign lead = ''
              for f in figs
                assign placed_fig = f | replace_first: '<figure', '<figure data-gs-story="offset"'
                assign lead = lead | append: placed_fig
              endfor
              assign spread = lead | append: spread
            else
              assign spread = spread | append: carry
            endif
            assign out = out | append: spread
          elsif count == 1 and words > 0
            # Short text beside its picture, its heading with it. The picture takes the side the
            # last offset didn't, so the page keeps its zig-zag.
            assign rest = before | strip
            assign so_far = out | append: before
            assign offsets = so_far | split: 'data-gs-story="offset"' | size | minus: 1
            assign marks = so_far | split: '<!--gs-q:' | size | minus: 1
            assign offsets = offsets | plus: marks | plus: page_offsets | modulo: 2
            assign split_class = 'gs-story__split'
            if offsets == 1
              assign split_class = 'gs-story__split gs-story__split--flip'
            endif
            assign out = out | append: '<div class="' | append: split_class | append: '"><div class="gs-prose">' | append: rest | append: '</div>' | append: figs[0] | append: '</div>'
          else
            # A row holds three pictures at most. More make rows as even as they can be, the
            # longer first: four are two and two, five three and two, seven three, two and two.
            assign lines = count | plus: 2 | divided_by: 3
            assign per_line = count | divided_by: lines
            assign longer = count | modulo: lines
            assign rows = ''
            assign line = ''
            assign in_line = 0
            assign line_index = 0
            for f in figs
              assign line = line | append: f
              assign in_line = in_line | plus: 1
              assign line_size = per_line
              if line_index < longer
                assign line_size = per_line | plus: 1
              endif
              if in_line == line_size
                assign rows = rows | append: '<div class="gs-story__row">' | append: line | append: '</div>'
                assign line = ''
                assign in_line = 0
                assign line_index = line_index | plus: 1
              endif
            endfor
            assign out = out | append: before | append: rows
            assign after_row = true
          endif
          assign before = ''
        endfor
        assign out = out | append: before
        # A quote that ends its part has no text to sit beside: it stands in the column as a pull
        # quote between the parts, not offset.
        assign probe = out | strip | append: '|end'
        for q in quotes
          assign quote_mark = '<!--gs-q:' | append: forloop.index0 | append: '-->'
          assign mark_end = quote_mark | append: '|end'
          if probe contains mark_end
            assign pull = q | replace_first: ' data-gs-story="offset"', ''
            assign pull = '<div class="gs-story__pull">' | append: pull | append: '</div>'
            assign out = out | replace: quote_mark, pull
          else
            assign out = out | replace: quote_mark, q
          endif
        endfor
        assign part_offsets = out | split: 'data-gs-story="offset"' | size | minus: 1
        assign page_offsets = page_offsets | plus: part_offsets
      -%}
      {{ out }}
    {%- endfor -%}
  </div>
</div>
