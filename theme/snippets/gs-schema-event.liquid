{% doc %}
  One event as schema.org data (DS-154): a JSON object with the event's title, times, place,
  picture, summary, its exhibition, the organisation that runs it and its tickets or registration link. Events
  have no page of their own (content model part 5), so the same event has the same @id wherever
  it is listed, and its address is its programme's page, else the Upcoming events page.

  Every event is in the building, so the place is the gallery, with the event's location
  ("Main Floor") before its name. The picture is the event's own, else its exhibition's key
  image, else its programme page's, as the event's row shows (DS-150).

  Prints the object alone, without a script tag or @context.

  @param {object} event - An event entry
  @param {string} base - The site's address, without a closing slash

  @example
  {%- render 'gs-schema-event', event: event, base: shop.url -%}
{% enddoc %}
{%- liquid
  assign exhibition = event.exhibition.value
  assign programme = event.programme_page.value
  assign image = event.image.value
  if image == blank and exhibition != blank
    assign image = exhibition.key_image.value
  endif
  if image == blank and programme != blank
    assign image = programme.metafields.custom.hero_image.value
  endif
  assign url = settings.events_page.url
  if programme != blank
    assign url = programme.url
  elsif exhibition != blank
    assign url = exhibition.system.url
  endif
  assign summary = event.summary.value | newline_to_br | strip_newlines | replace: '<br />', ' ' | split: ' ' | join: ' '
  # Who runs it: the organisation of its programme page, else of its exhibition; blank is the Gallery.
  assign organiser = programme.metafields.custom.programme.value
  if organiser == blank and exhibition != blank
    assign organiser = exhibition.programme.value
  endif
-%}
{
  "@type": "Event",
  "@id": {{ base | append: '/#event-' | append: event.system.handle | json }},
  "name": {{ event.title.value | json }},
  "startDate": {{ event.starts.value | date: '%Y-%m-%dT%H:%M:%S%:z' | json }}
  {%- if event.ends.value != blank -%},"endDate": {{ event.ends.value | date: '%Y-%m-%dT%H:%M:%S%:z' | json }}{%- endif -%}
  ,"eventStatus": "https://schema.org/EventScheduled"
  ,"eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode"
  ,"location": {%- render 'gs-schema-place', base: base, room: event.location.value -%}
  {%- if url != blank -%},"url": {{ base | append: url | json }}{%- endif -%}
  {%- if image != blank -%},"image": {{ image | image_url: width: 1200 | prepend: 'https:' | json }}{%- endif -%}
  {%- if summary != blank -%},"description": {{ summary | json }}{%- endif -%}
  {%- if exhibition != blank -%}
    ,"superEvent": {
      "@type": "ExhibitionEvent",
      "@id": {{ base | append: exhibition.system.url | append: '#exhibition' | json }},
      "name": {{ exhibition.title.value | json }},
      "url": {{ base | append: exhibition.system.url | json }}
    }
  {%- endif -%}
  ,"organizer": {%- render 'gs-schema-org', base: base, programme: organiser -%}
  {%- if event.tickets.value.url != blank -%}
    ,"offers": {
      "@type": "Offer",
      "url": {{ event.tickets.value.url | json }}
    }
  {%- endif -%}
}
