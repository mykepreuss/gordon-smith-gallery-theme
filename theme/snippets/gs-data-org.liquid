{% doc %}
  One of the three organisations as structured data (DS-163): the Gallery, Artists for Kids or
  The Gordon and Marion Smith Foundation, from a programme field's value. Blank is the Gallery,
  as everywhere else (gs-programme). One JSON object without its script tag.

  Each organisation has one name for machines (its @id), so a page, an exhibition, an event and
  a lesson that belong to it all point at the same thing. The short form is that name, the
  organisation's name and its page. The full form, printed on the organisation's own page, adds
  its logo. The Gallery's full form is gs-data-place, where it is an ArtGallery with its
  address and hours. A mention of it here is an Organization under the same name for machines
  (DS-173): Google takes every ArtGallery on a page for a local business and notes what it
  lacks, so a bare mention drew four notes on every page.

  Artists for Kids' and the Foundation's pages are chosen in Theme settings, Gallery details.

  The full form also says, from Theme settings and as the site's own pages say it (DS-174):
  the year each was established; the Foundation's full name; each one's charity registration
  number, once it is filled in (DS-193); that Artists for Kids is run by the North Vancouver
  School District and funded by the Foundation; and each one's profiles elsewhere. Artists for
  Kids shares the gallery's profiles. An empty setting says nothing.

  @param {string} [programme] - A programme field's value: Gallery, Smith Foundation or Artists for Kids
  @param {boolean} [full] - The full form

  @example
  "publisher": {% render 'gs-data-org', programme: page.metafields.custom.programme.value %}
{% enddoc %}
{%- liquid
  assign origin = shop.url
  assign home = origin | append: routes.root_url
  capture brand
    render 'gs-programme', value: programme
  endcapture
  assign brand = brand | strip
  assign kind = 'Organization'
  assign own_page = nil
  case brand
    when 'artists-for-kids'
      assign id = home | append: '#artists-for-kids'
      assign name = 'general.site_title.artists_for_kids' | t
      assign own_page = settings.artists_for_kids_page
      assign logo = 'gs-logo-artists-for-kids.svg'
    when 'foundation'
      assign id = home | append: '#foundation'
      assign name = 'general.site_title.foundation' | t
      assign own_page = settings.foundation_page
      assign logo = 'gs-logo-foundation.svg'
    else
      # A mention is an Organization. The gallery's full data, an ArtGallery, is gs-data-place.
      assign id = home | append: '#gallery'
      assign name = 'general.site_title.gallery' | t
      assign logo = 'gs-logo-gallery.svg'
  endcase
  # The full form's facts, from Theme settings (DS-174). A year is given only when it is a year.
  assign full_name = ''
  assign founded = ''
  assign profile_keys = ''
  assign charity_number = ''
  case brand
    when 'artists-for-kids'
      assign charity_number = settings.afk_charity_number | strip
      assign founded = settings.afk_founded | strip
      assign profile_keys = 'social_instagram,social_facebook,social_x,social_youtube,social_vimeo,social_linkedin'
    when 'foundation'
      assign full_name = 'general.site_title.foundation_full' | t
      assign charity_number = settings.foundation_charity_number | strip
      assign founded = settings.foundation_founded | strip
      assign profile_keys = 'foundation_instagram,foundation_facebook'
  endcase
  assign founded_back = founded | plus: 0 | append: ''
  assign profiles = ''
  assign profile_keys = profile_keys | split: ','
  for key in profile_keys
    if settings[key] != blank
      assign profiles = profiles | append: settings[key] | append: '|'
    endif
  endfor
  assign profiles = profiles | split: '|'

  assign url = home
  if brand != 'gallery'
    assign url = ''
    if own_page != blank
      assign url = own_page.url | prepend: origin
    endif
  endif
-%}
{
  "@type": {{ kind | json }},
  "@id": {{ id | json }},
  "name": {{ name | json }}
  {%- if url != blank -%}
    ,"url": {{ url | json }}
  {%- endif -%}
  {%- if full -%}
    ,"logo": {{ logo | asset_url | prepend: 'https:' | json }}
    {%- if full_name != blank and full_name != name -%}
      ,"alternateName": {{ full_name | json }}
    {%- endif -%}
    {%- if founded.size == 4 and founded_back == founded -%}
      ,"foundingDate": {{ founded | json }}
    {%- endif -%}
    {%- if profiles.size > 0 -%}
      ,"sameAs": {{ profiles | json }}
    {%- endif -%}
    {%- if brand == 'artists-for-kids' -%}
      {%- if settings.afk_operator != blank -%}
        ,"parentOrganization": {
          "@type": "Organization",
          "name": {{ settings.afk_operator | json }}
          {%- if settings.afk_operator_url != blank -%}
            ,"url": {{ settings.afk_operator_url | json }}
          {%- endif -%}
        }
      {%- endif -%}
      ,"funder": { "@type": "Organization", "@id": {{ home | append: '#foundation' | json }}, "name": {{ 'general.site_title.foundation' | t | json }} }
    {%- endif -%}
    {%- if charity_number != blank -%}
      ,"identifier": {
        "@type": "PropertyValue",
        "propertyID": "Canada Revenue Agency charity registration number",
        "value": {{ charity_number | json }}
      }
    {%- endif -%}
  {%- endif -%}
}
