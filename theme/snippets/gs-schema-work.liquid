{% doc %}
  A work in the Permanent Collection as schema.org data (DS-154): a VisualArtwork with its
  artists (linked to their pages), year, category, medium, edition, size, accession number, credit
  line, themes, pictures and the exhibitions that showed it. Then the way back, as a
  BreadcrumbList. A year that isn't a plain year ("ND", "1932-2003") is left out.

  @param {string} base - The site's address, without a closing slash
  @param {string} here - This page's address

  @example
  {%- render 'gs-schema-work', base: shop.url, here: here -%}
{% enddoc %}
{%- liquid
  assign work = metaobject
  assign leaf_name = work.title.value
  if settings.collection_page != blank
    assign crumb_name = settings.collection_page.title
    assign crumb_url = settings.collection_page.url
  endif
  assign about = work.about | metafield_text | truncatewords: 60
  assign year = work.year.value | strip
  assign year_number = year | plus: 0 | append: ''
-%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "VisualArtwork",
    "@id": {{ here | append: '#work' | json }},
    "name": {{ work.title.value | json }},
    "url": {{ here | json }}
    {%- if work.artists.value != blank -%}
      ,"creator": [
        {%- for artist in work.artists.value -%}
          {%- unless forloop.first -%},{%- endunless -%}
          {
            "@type": "Person",
            "@id": {{ base | append: artist.system.url | append: '#artist' | json }},
            "name": {{ artist.name.value | json }},
            "url": {{ base | append: artist.system.url | json }}
          }
        {%- endfor -%}
      ]
    {%- endif -%}
    {%- if year.size == 4 and year_number == year -%},"dateCreated": {{ year | json }}{%- endif -%}
    {%- if work.category.value != blank -%},"artform": {{ work.category.value | json }}{%- endif -%}
    {%- if work.medium.value != blank -%},"artMedium": {{ work.medium.value | json }}{%- endif -%}
    {%- if work.edition.value != blank -%},"artEdition": {{ work.edition.value | json }}{%- endif -%}
    {%- if work.dimensions.value != blank -%},"size": {{ work.dimensions.value | json }}{%- endif -%}
    {%- if work.accession_number.value != blank -%},"identifier": {{ work.accession_number.value | json }}{%- endif -%}
    {%- if work.credit_line.value != blank -%},"creditText": {{ work.credit_line.value | json }}{%- endif -%}
    {%- if work.themes.value != blank -%},"keywords": {{ work.themes.value | join: ', ' | json }}{%- endif -%}
    {%- if about != blank -%},"description": {{ about | json }}{%- endif -%}
    {%- if work.images.value != blank -%}
      ,"image": [
        {%- for image in work.images.value limit: 6 -%}
          {%- unless forloop.first -%},{%- endunless -%}
          {{- image | image_url: width: 1200 | prepend: 'https:' | json -}}
        {%- endfor -%}
      ]
    {%- endif -%}
    {%- if settings.collection_page != blank -%}
      ,"isPartOf": {
        "@type": "Collection",
        "@id": {{ base | append: settings.collection_page.url | append: '#collection' | json }},
        "name": {{ settings.collection_page.title | json }},
        "url": {{ base | append: settings.collection_page.url | json }}
      }
    {%- endif -%}
    ,"provider": {%- render 'gs-schema-org', base: base -%}
    {%- if work.shown_in.value != blank -%}
      ,"subjectOf": [
        {%- for shown in work.shown_in.value -%}
          {%- unless forloop.first -%},{%- endunless -%}
          {
            "@type": "ExhibitionEvent",
            "@id": {{ base | append: shown.system.url | append: '#exhibition' | json }},
            "name": {{ shown.title.value | json }},
            "url": {{ base | append: shown.system.url | json }}
          }
        {%- endfor -%}
      ]
    {%- endif -%}
  }
</script>
{%- render 'gs-schema-crumbs', base: base, here: here, name: crumb_name, url: crumb_url, leaf: leaf_name -%}
