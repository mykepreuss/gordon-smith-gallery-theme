{% doc %}
  The gallery as schema.org data (DS-154): one JSON object, an ArtGallery with its name, address,
  phone, email and, with detail, its opening hours, social links and directions. All from Theme
  settings, Gallery details, so search engines and assistants read what the footer and Plan your
  visit show.

  The address is the setting's text: the first lines are the street, the last line is
  "City, Province Postcode". A last line in another shape is left with the street, so nothing is
  guessed. The country is the store's.

  Prints the object alone, without a script tag, so it can stand on its own or be an event's
  location.

  @param {string} base - The site's address, without a closing slash
  @param {boolean} [detail] - Add opening hours, social links and directions
  @param {string} [room] - Where in the building, put before the name: "Main Floor"

  @example
  <script type="application/ld+json">{%- render 'gs-schema-place', base: shop.url, detail: true -%}</script>
{% enddoc %}
{%- liquid
  assign name = 'general.site_title.gallery' | t
  assign place_name = name
  if room != blank
    assign place_name = room | append: ', ' | append: name
  endif

  assign lines = settings.address | newline_to_br | strip_newlines | split: '<br />'
  assign street = ''
  assign city = ''
  assign region = ''
  assign postcode = ''
  assign last_parts = lines.last | split: ', '
  if lines.size > 1 and last_parts.size == 2
    assign city = last_parts.first | strip
    assign rest = last_parts.last | strip
    assign region = rest | split: ' ' | first
    assign postcode = rest | remove_first: region | strip
    for line in lines
      unless forloop.last
        if street != blank
          assign street = street | append: ', '
        endif
        assign line_text = line | strip
        assign street = street | append: line_text
      endunless
    endfor
  else
    assign street = lines | join: ', '
  endif

  capture tel
    render 'gs-tel'
  endcapture
  assign tel = tel | strip
  # Ten digits are a Canadian or American number, so the country's 1 goes before them.
  assign country = shop.address.country_code
  if tel.size == 10
    if country == 'CA' or country == 'US'
      assign tel = tel | prepend: '+1'
    endif
  endif

  assign day_keys = 'monday,tuesday,wednesday,thursday,friday,saturday,sunday' | split: ','
  assign days = ''
  for key in day_keys
    assign setting = 'open_' | append: key
    if settings[setting]
      assign day = key | capitalize | prepend: 'https://schema.org/'
      assign days = days | append: day | append: ','
    endif
  endfor
  assign days = days | split: ','

  assign socials = ''
  assign social_keys = 'instagram,facebook,youtube,vimeo,linkedin' | split: ','
  for key in social_keys
    assign setting = 'social_' | append: key
    if settings[setting] != blank
      assign socials = socials | append: settings[setting] | append: '|'
    endif
  endfor
  assign socials = socials | split: '|'
-%}
{
  "@type": "ArtGallery",
  "@id": {{ base | append: '/#gallery' | json }},
  "name": {{ place_name | json }},
  "url": {{ base | append: '/' | json }}
  {%- if street != blank -%}
    ,"address": {
      "@type": "PostalAddress",
      "streetAddress": {{ street | json }}
      {%- if city != blank -%},"addressLocality": {{ city | json }}{%- endif -%}
      {%- if region != blank -%},"addressRegion": {{ region | json }}{%- endif -%}
      {%- if postcode != blank -%},"postalCode": {{ postcode | json }}{%- endif -%}
      {%- if shop.address.country_code != blank -%},"addressCountry": {{ shop.address.country_code | json }}{%- endif -%}
    }
  {%- endif -%}
  {%- if tel != blank -%},"telephone": {{ tel | json }}{%- endif -%}
  {%- if settings.email != blank -%},"email": {{ settings.email | json }}{%- endif -%}
  {%- if detail -%}
    {%- if days.size > 0 and settings.opens_at != blank and settings.closes_at != blank -%}
      ,"openingHoursSpecification": {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": {{ days | json }},
        "opens": {{ settings.opens_at | json }},
        "closes": {{ settings.closes_at | json }}
      }
    {%- endif -%}
    {%- if settings.visit_page != blank and settings.address != blank -%}
      {%- assign destination = settings.address | newline_to_br | replace: '<br />', ', ' | strip_newlines | url_encode -%}
      ,"hasMap": {{ 'https://www.google.com/maps/dir/?api=1&destination=' | append: destination | json }}
    {%- endif -%}
    {%- if socials.size > 0 -%},"sameAs": {{ socials | json }}{%- endif -%}
  {%- endif -%}
}
