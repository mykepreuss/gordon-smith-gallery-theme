{% doc %}
  Structured data (schema.org, as JSON-LD) for search and answer engines, so they read the facts
  a page shows without guessing (DS-154). It repeats what the page says and adds nothing
  the page doesn't show. Rendered by meta-tags, in the head.

  This snippet prints the gallery and the site, then hands each kind of page to its own snippet,
  then prints the crumb:

    Home, Plan your visit, Contact   the gallery (gs-data-place): address, hours, telephone, logo
    Home                             the site (WebSite) and its search
    An exhibition                    Event, further typed ExhibitionEvent (gs-data-exhibition)
    A work in the collection         VisualArtwork (gs-data-work)
    An artist                        ProfilePage and Person (gs-data-artist)
    A lesson                         LearningResource with its video (gs-data-lesson)
    A grouping, a portfolio          CollectionPage (gs-data-list)
    An edition                       Product or ProductGroup, and VisualArtwork (gs-data-product)
    A page, an article               WebPage, ContactPage, FAQPage, CollectionPage, BlogPosting
                                     (gs-data-page), and what a list page lists (gs-data-index)
    Entries, editions, portfolios    BreadcrumbList: Home, the list the page belongs to, the page

  One graph, not separate notes (DS-163): everything has one name for machines (@id), made from
  its own address, and is called by that name wherever it is mentioned. So the artist on a
  work's page, in an exhibition and on the Artists page is the artist of the artist's own page;
  and each page says what it is mainly about (gs-data-webpage).

    the gallery        <home>#gallery          the site            <home>#website
    Artists for Kids   <home>#artists-for-kids the Foundation      <home>#foundation
    the collection     <home>#collection       an event            <home>#event-<handle>
    an exhibition      <its page>#exhibition   a work              <its page>#work
    an artist          <its page>#artist       a lesson            <its page>#lesson
    an edition         <its page>#product      a page              <its page>#webpage
    a crumb            <its page>#breadcrumb   a page's list       <its page>#list

  - Events print their own with each row and card (gs-data-event).
  - A year is given only when it is a plain year ("1985"); "n.d." and "1950-1959" stay on the
    page. Life dates are read from "1882 to 1974" and "born 1946".
  - Addresses start with the shop's own domain (shop.url), as the canonical address does, so a
    preview or the development theme names the same pages the live site will.
  - Every value goes through the json filter, so a quotation mark in a title can't break the data.

  @param {string} [description] - The page's description, as meta-tags works it out
  @param {string} [label] - A work's or an edition's label in plain text, "Artist, Title, year"
  @param {object} [image] - The page's own picture, as meta-tags picks it

  @example
  {% render 'gs-data', description: description, label: entry_label, image: og_image %}
{% enddoc %}
{%- liquid
  assign origin = shop.url
  assign home = origin | append: routes.root_url
  assign gallery_id = home | append: '#gallery'
  assign site_name = 'general.site_title.gallery' | t
  # The search address's placeholder is built from its parts: a closing brace inside an output
  # tag ends the tag.
  assign search_terms = '{search_term_string}'
  assign type = ''
  if metaobject != blank
    assign type = metaobject.system.type
  endif

  # The gallery's own pages: home, Plan your visit and Contact.
  assign show_gallery = false
  if request.page_type == 'index'
    assign show_gallery = true
  elsif request.page_type == 'page'
    if page.id == settings.visit_page.id or page.id == settings.contact_page.id
      assign show_gallery = true
    endif
  endif

  # The crumb: the list the page belongs to, as the page's own link back names it.
  assign crumb_name = ''
  assign crumb_url = ''
  assign here = ''
  case type
    when 'exhibition'
      capture status
        render 'gs-exhibition-status', start: metaobject.start_date.value, end: metaobject.end_date.value
      endcapture
      assign status = status | strip
      case status
        when 'upcoming'
          assign back = settings.exhibitions_upcoming_page
        when 'past'
          assign back = settings.exhibitions_past_page
        else
          assign back = settings.exhibitions_on_now_page
      endcase
      assign crumb_name = 'exhibitions.crumb' | t
      assign crumb_url = back.url
      assign here = metaobject.title.value
    when 'artwork'
      assign crumb_name = settings.collection_page.title
      assign crumb_url = settings.collection_page.url
      assign here = label | default: metaobject.title.value
    when 'artist'
      assign crumb_name = settings.artists_page.title
      assign crumb_url = settings.artists_page.url
      assign here = metaobject.name.value
    when 'collection_group'
      assign crumb_name = settings.collection_page.title
      assign crumb_url = settings.collection_page.url
      assign here = metaobject.name.value
    when 'lesson'
      assign crumb_name = settings.lessons_page.title
      assign crumb_url = settings.lessons_page.url
      assign here = metaobject.title.value
  endcase
  if request.page_type == 'product' and product.type != 'Frame'
    assign crumb_name = 'shop.crumb' | t
    assign crumb_url = settings.shop_page.url
    assign here = label | default: product.title
  elsif request.page_type == 'collection'
    assign crumb_name = 'shop.crumb' | t
    assign crumb_url = settings.shop_page.url
    assign here = collection.title
  endif
-%}
{%- if show_gallery -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {% render 'gs-data-place', full: true %}
        {%- if request.page_type == 'index' -%}
          ,{
            "@type": "WebSite",
            "@id": {{ home | append: '#website' | json }},
            "name": {{ site_name | json }},
            "alternateName": [{{ 'general.site_title.gallery_full' | t | json }}, {{ shop.name | replace: '&amp;', '&' | json }}],
            "url": {{ home | json }},
            "publisher": { "@id": {{ gallery_id | json }} },
            "potentialAction": {
              "@type": "SearchAction",
              "target": {
                "@type": "EntryPoint",
                "urlTemplate": {{ origin | append: routes.search_url | append: '?q=[terms]' | replace: '[terms]', search_terms | json }}
              },
              "query-input": "required name=search_term_string"
            }
          }
        {%- endif -%}
      ]
    }
  </script>
{%- endif -%}

{%- liquid
  case type
    when 'exhibition'
      render 'gs-data-exhibition', description: description
    when 'artwork'
      render 'gs-data-work', description: description, label: label
    when 'artist'
      render 'gs-data-artist', description: description
    when 'lesson'
      render 'gs-data-lesson', description: description
    when 'collection_group'
      render 'gs-data-list', description: description
    else
      if request.page_type == 'collection'
        render 'gs-data-list', description: description
      elsif request.page_type == 'product'
        render 'gs-data-product', description: description, label: label
      elsif type == blank
        render 'gs-data-page', description: description, image: image
      endif
  endcase
-%}

{%- if here != blank and crumb_name != blank and crumb_url != blank -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "@id": {{ canonical_url | append: '#breadcrumb' | json }},
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": {{ site_name | json }}, "item": {{ home | json }} },
        { "@type": "ListItem", "position": 2, "name": {{ crumb_name | json }}, "item": {{ crumb_url | prepend: origin | json }} },
        { "@type": "ListItem", "position": 3, "name": {{ here | json }}, "item": {{ canonical_url | json }} }
      ]
    }
  </script>
{%- endif -%}
