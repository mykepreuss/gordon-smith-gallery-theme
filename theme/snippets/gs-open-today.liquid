{% doc %}
  Whether the gallery is open today (DS-54), from the opening days and times in Theme settings,
  Gallery details. The page says the week's hours ("Open Thursday to Saturday, 12 to 4 PM"), and
  gs-open.js turns that into today's: "Open now until 4 PM", "Open today, 12 to 4 PM" or "Closed
  today. Open Thursday, 12 to 4 PM". The script works in the gallery's own time (Vancouver),
  whatever the visitor's clock says. Without it, the week's line stays. With no open days set, it
  shows nothing. The days come from gs-open-hours, the one source for the gallery's hours (DS-96).
  Holidays and one-off closures aren't known here: the Plan your visit page carries those.

  @param {string} [class] - Extra classes for the line
  @param {string} [tag] - 'p' (default) or 'span', for a line inside a link: the header's utility
    row wraps it in a link to Plan your visit (DS-132)

  @example
  {%- render 'gs-open-today' -%}
{% enddoc %}
{%- liquid
  capture open
    render 'gs-open-hours', part: 'numbers'
  endcapture
  assign open = open | strip
-%}
{%- if open != blank -%}
  {%- liquid
    capture days
      render 'gs-open-hours', part: 'days'
    endcapture
    assign days = days | strip
    capture times
      render 'gs-open-times', opens: settings.opens_at, closes: settings.closes_at
    endcapture
    assign times = times | strip
    assign to_word = 'open.to' | t
  -%}
  {%- liquid
    assign tag = tag | default: 'p'
    unless tag == 'span'
      assign tag = 'p'
    endunless
  -%}
  <{{ tag }} class="gs-open{% if class != blank %} {{ class }}{% endif %}" data-gs-open data-tz="America/Vancouver"
    data-days="{{ open }}" data-opens="{{ settings.opens_at }}" data-closes="{{ settings.closes_at }}"
    data-now="{{ 'open.now' | t: time: '%time%' | escape }}"
    data-today="{{ 'open.today' | t: times: '%times%' | escape }}"
    data-closed-today="{{ 'open.closed_today' | t: day: '%day%', times: '%times%' | escape }}"
    data-closed-now="{{ 'open.closed_now' | t: day: '%day%', times: '%times%' | escape }}"
    data-tomorrow="{{ 'open.tomorrow' | t | escape }}"
    data-weekdays="{{ 'open.weekdays' | t | escape }}"
    data-to="{{ to_word | escape }}">
    {{- 'open.days_times' | t: days: days, times: times -}}
  </{{ tag }}>
{%- endif -%}
