{% doc %}
  One event in a list (content model part 5): title, when, where, a sentence, tickets. A blank
  location means the gallery, so nothing shows. The compact form (on an exhibition's page) leaves
  out the image and summary.

  The picture is the event's own, else its exhibition's key image, else its programme page's
  picture, as on the event card, so a row in the full lists has a picture without anyone adding
  one twice (DS-150), on the programme's own page too (DS-151). The compact form has
  no picture.

  On a programme page, an event titled like the page itself (a run of "Explore + Create"
  drop-ins) leads with its date and time instead of repeating the title (DS-36).

  Under the date, what the event belongs to: its exhibition (DS-71), and, anywhere but its own
  programme page, its programme page, linked, so a row on Upcoming events says who it is for
  (DS-115). The programme is left out when the event has the programme's own name, as the event
  card does.

  @param {object} event - An event entry
  @param {boolean} [compact] - Title, time, place and tickets only
  @param {string} [heading] - Element for the title: 'h3' (default), 'h4', or 'p' where a heading would skip a level
  @param {boolean} [past] - The event has ended: no tickets link (DS-147)
  @param {string} [page_title] - The page's title, so an event titled the same leads with its date

  @example
  <ul class="gs-events">{%- render 'gs-event', event: event -%}</ul>
{% enddoc %}
{%- liquid
  assign tag = heading | default: 'h3'
  assign image = event.image.value
  assign mode = 'photo'
  if image == blank and compact != true
    if event.exhibition.value != blank
      assign image = event.exhibition.value.key_image.value
      if image != blank and event.exhibition.value.key_image_is_artwork.value == true
        assign mode = 'artwork'
      endif
    endif
    if image == blank and event.programme_page.value != blank
      assign image = event.programme_page.value.metafields.custom.hero_image.value
      if image != blank and event.programme_page.value.metafields.custom.hero_is_artwork.value == true
        assign mode = 'artwork'
      endif
    endif
  endif
  assign has_media = false
  if compact != true and image != blank
    assign has_media = true
  endif
  assign date_led = false
  if page_title != blank
    assign a = event.title.value | strip | downcase
    assign b = page_title | strip | downcase
    if a == b
      assign date_led = true
    endif
  endif
-%}
<li class="gs-event{% if has_media %} gs-event--media{% endif %}">
  {%- if has_media -%}
    {%- render 'gs-media', image: image, preset: 'card', mode: mode -%}
  {%- endif -%}
  <div class="gs-event__text">
    {%- if date_led -%}
      <{{ tag }} class="gs-h4">
        <time datetime="{{ event.starts.value }}">
          {%- render 'gs-time-range', start: event.starts.value, end: event.ends.value -%}
        </time>
      </{{ tag }}>
    {%- else -%}
      <{{ tag }} class="{% if compact %}gs-h4{% else %}gs-h3{% endif %}">{{ event.title.value | escape }}</{{ tag }}>
      <p class="gs-status__dates">
        <time datetime="{{ event.starts.value }}">
          {%- render 'gs-time-range', start: event.starts.value, end: event.ends.value -%}
        </time>
      </p>
    {%- endif -%}
    {%- comment -%} The exhibition it belongs to, linked when the exhibition has a page (DS-71); not on the exhibition's own page (compact). {%- endcomment -%}
    {%- assign exhibition = event.exhibition.value -%}
    {%- if compact != true and exhibition != blank -%}
      <p class="gs-meta">
        {%- if exhibition.summary.value != blank or exhibition.body.value != blank -%}
          <a class="gs-link" href="{{ exhibition.system.url }}">{{ exhibition.title.value | escape }}</a>
        {%- else -%}
          {{- exhibition.title.value | escape -}}
        {%- endif -%}
      </p>
    {%- endif -%}
    {%- liquid
      assign programme = event.programme_page.value
      assign show_programme = false
      if compact != true and programme != blank and programme.id != page.id
        assign p_title = programme.title | strip | downcase
        assign e_title = event.title.value | strip | downcase
        if p_title != e_title
          assign show_programme = true
        endif
      endif
    -%}
    {%- if show_programme -%}
      <p class="gs-meta"><a class="gs-link" href="{{ programme.url }}">{{ programme.title | escape }}</a></p>
    {%- endif -%}
    {%- if event.location.value != blank -%}
      <p class="gs-meta">{{ event.location.value | escape }}</p>
    {%- endif -%}
    {%- comment -%} A blank line in the summary starts a new paragraph; a single line break stays a break (Part 1 / Part 2). {%- endcomment -%}
    {%- if compact != true and event.summary.value != blank -%}
      <div class="gs-event__summary">{%- render 'gs-paragraphs', text: event.summary.value, link_names: true -%}</div>
    {%- endif -%}
    {%- if event.tickets.value.url != blank and past != true -%}
      {%- liquid
        assign ticket_label = event.tickets.value.text
        if ticket_label == blank
          assign ticket_label = 'events.tickets' | t
        endif
      -%}
      {%- render 'gs-link', link: event.tickets.value, label: ticket_label, class: 'gs-cta-link' -%}
    {%- endif -%}
    {%- unless past -%}{%- render 'gs-data-event', event: event -%}{%- endunless -%}
  </div>
</li>
