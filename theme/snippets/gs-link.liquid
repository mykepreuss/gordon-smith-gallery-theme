{% doc %}
  A link from a link field (a card's link, a page's call to action, an event's tickets), a menu
  link, or a section's link setting (a feature's button). Off-site addresses get the external cue:
  the arrow and "(external site)" for screen readers (DESIGN.md §6.1, §6.2). Store addresses typed
  in full are made relative (gs-url). A link to a PDF says so, "(PDF)", so nobody opens a large
  file by surprise. A spaced hyphen or bar between two parts of a label, and "(PDF)", stay on the
  line before, so neither starts a line (with cue_wraps, "(PDF)" may move to the next line whole).

  @param {object} [link] - A link field's value (url, text) or a menu link (url, title)
  @param {string} [url] - A section's link setting, which is the address alone. Pass label with it
  @param {string} [label] - Visible text. Default: the link's own text or title
  @param {string} [class] - Classes for the <a>, e.g. 'gs-button' or 'gs-cta-link'
  @param {boolean} [cue_wraps] - "(PDF)" may go to the next line whole (card and tile titles in narrow columns)
  @param {string} [about] - What the link is about, for a label that says only what it does
    ("Register"): added for screen readers and engines, which read a link's words on their own,
    so a list of links says "Register: Curatorial Tour" (DS-185)

  @example
  {%- render 'gs-link', link: page.metafields.custom.cta.value, class: 'gs-button' -%}
  {%- render 'gs-link', url: section.settings.button_link, label: section.settings.button_label, class: 'gs-button' -%}
{% enddoc %}
{%- liquid
  capture r
    render 'gs-url', link: link, url: url
  endcapture
  assign r = r | strip | split: '|'
  assign text = label | default: link.text | default: link.title
-%}
{%- liquid
  assign classes = class | default: ''
  if r[1] == '1'
    assign classes = classes | append: ' gs-link--external' | strip
  endif
-%}
<a{% if classes != blank %} class="{{ classes }}"{% endif %} href="{{ r[0] }}">
  {{- text | escape | replace: ' - ', '&nbsp;- ' | replace: ' | ', '&nbsp;| ' -}}
  {%- if about != blank -%}<span class="gs-visually-hidden">: {{ about | escape }}</span>{%- endif -%}
  {%- if r[2] == '1' %}{% if cue_wraps %} {% else %}&nbsp;{% endif %}{{ 'general.pdf' | t }}{% endif -%}
  {%- if r[1] == '1' -%}<span class="gs-visually-hidden"> {{ 'general.external_site' | t }}</span>{%- endif -%}
</a>
