{% doc %}
  Picks and orders event entries (content model part 5). Outputs comma-separated positions in
  shop.metaobjects.event.values, soonest first. Read an event back inside the same paginate tag
  (a plain loop stops at 50 entries, and the tag doesn't reach into a rendered snippet, DS-148):

    paginate shop.metaobjects.event.values by 250
      for event in shop.metaobjects.event.values offset: n limit: 1

  An event drops off every list once it has ended (its end time, or its start time when it has
  no end). Only active entries exist on the storefront. Reads the first 250 entries, A to Z by handle,
  which is Shopify's order; the oldest ended events are removed before then (DS-148). With past, the
  events that have ended instead, newest first (the Past events page, DS-147).

  Pass one of for_page or exhibition, or neither for every upcoming event. (Not "page": inside a
  snippet that name is also the current page, so leaving it out would still filter by it.)

  @param {object} [for_page] - Only events whose programme page is this page
  @param {object} [exhibition] - Only events tied to this exhibition entry
  @param {number} [limit] - At most this many
  @param {boolean} [past] - The events that have ended, newest first

  @example
  {%- capture ids -%}{% render 'gs-event-index', for_page: page %}{%- endcapture -%}
{% enddoc %}
{%- liquid
  assign limit = limit | default: 50
  assign now = 'now' | date: '%s' | plus: 0
  assign keys = ''
  paginate shop.metaobjects.event.values by 250
  for event in shop.metaobjects.event.values
    if for_page != blank
      if event.programme_page.value.id != for_page.id
        continue
      endif
    endif
    if exhibition != blank
      if event.exhibition.value.system.handle != exhibition.system.handle
        continue
      endif
    endif
    assign finish = event.ends.value | default: event.starts.value
    assign finish_s = finish | date: '%s' | plus: 0
    if past
      if finish_s >= now
        continue
      endif
    elsif finish_s < now
      continue
    endif
    assign start_s = event.starts.value | date: '%s'
    assign pos = forloop.index0 | prepend: '000' | slice: -3, 3
    assign keys = keys | append: start_s | append: '-' | append: pos | append: ','
  endfor
  endpaginate

  assign sorted = keys | split: ',' | sort
  if past
    assign sorted = sorted | reverse
  endif
  for key in sorted limit: limit
    echo key | split: '-' | last | plus: 0
    unless forloop.last
      echo ','
    endunless
  endfor
-%}
