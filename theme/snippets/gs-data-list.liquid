{% doc %}
  A page that lists works as structured data (schema.org CollectionPage, DS-158): a grouping in
  the Permanent Collection (a category, a theme) or a portfolio in the Shop. It gives the list's
  name, what it says about itself and what it belongs to. A portfolio also names the editions on
  this page of the list, each by its label in plain letters ("Artist, Title, year", DS-156), in
  the order the page shows them.

  A grouping's works are left to their own pages: a grouping can hold hundreds, and the page
  shows them 24 at a time.

  @param {string} [description] - The page's description, as meta-tags works it out

  @example
  {%- render 'gs-data-list', description: description -%}
{% enddoc %}
{%- liquid
  assign origin = shop.url
  assign name = ''
  assign image = nil
  assign part_of = nil
  if metaobject.system.type == 'collection_group'
    assign name = metaobject.name.value
    assign part_of = settings.collection_page
  elsif request.page_type == 'collection'
    assign name = collection.title
    assign image = collection.image
    assign part_of = settings.shop_page
  endif
-%}
{%- if name != blank -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      "@id": {{ canonical_url | append: '#webpage' | json }},
      "inLanguage": {{ request.locale.iso_code | json }},
      "breadcrumb": { "@id": {{ canonical_url | append: '#breadcrumb' | json }} },
      "name": {{ name | json }},
      "url": {{ canonical_url | json }},
      "publisher": {% render 'gs-data-org' %}
      {%- if description != blank -%}
        ,"description": {{ description | json }}
      {%- endif -%}
      {%- if image != blank -%}
        ,"primaryImageOfPage": {% render 'gs-data-image', image: image %}
      {%- endif -%}
      {%- if part_of != blank -%}
        ,"isPartOf": {
          "@type": "WebPage",
          "@id": {{ part_of.url | prepend: origin | append: '#webpage' | json }},
          "name": {{ part_of.title | json }},
          "url": {{ part_of.url | prepend: origin | json }}
        }
      {%- endif -%}
      {%- if request.page_type == 'collection' and collection.products.size > 0 -%}
        ,"mainEntity": {
          "@type": "ItemList",
          "numberOfItems": {{ collection.products_count | json }},
          "itemListElement": [
            {%- for item in collection.products -%}
              {%- liquid
                assign f = item.metafields.custom
                assign item_name = item.title
                if f.artist.value != blank and f.artwork_title.value != blank
                  assign item_name = f.artist.value | append: ', ' | append: f.artwork_title.value
                  if f.year.value != blank
                    assign item_name = item_name | append: ', ' | append: f.year.value
                  endif
                endif
              -%}
              { "@type": "ListItem", "position": {{ forloop.index }}, "item": { "@type": "Product", "@id": {{ item.url | prepend: origin | append: '#product' | json }}, "name": {{ item_name | json }}, "url": {{ item.url | prepend: origin | json }} } }{% unless forloop.last %},{% endunless %}
            {%- endfor -%}
          ]
        }
      {%- endif -%}
    }
  </script>
{%- endif -%}
