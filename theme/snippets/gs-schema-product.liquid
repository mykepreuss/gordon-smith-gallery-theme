{% doc %}
  A product as schema.org data (DS-154), in place of Shopify's structured_data filter, so the data
  says what the page says:

  - A limited edition is named by its label in plain text ("Artist, Title, year"), never by a
    product title whose italics are Unicode letters (content model part 3), and it is an artwork
    as well as a product: its artist, year, medium, edition and size come from the label fields.
  - Whether it can be bought follows the page: not on sale yet (custom.coming_soon) and sold out
    are both out of stock, since neither can be ordered.
  - One offer for each option, at its own address and price, sold by the gallery.

  A frame (product type Frame) is sold only with its print and its page is kept out of search
  engines (DS-137), so it has no data.

  @param {object} product - The product
  @param {string} base - The site's address, without a closing slash

  @example
  {%- render 'gs-schema-product', product: product, base: shop.url -%}
{% enddoc %}
{%- liquid
  assign f = product.metafields.custom
  assign is_edition = false
  if f.artist.value != blank and f.artwork_title.value != blank
    assign is_edition = true
  endif
  assign name = product.title
  if is_edition
    assign name = f.artist.value | append: ', ' | append: f.artwork_title.value
    if f.year.value != blank
      assign name = name | append: ', ' | append: f.year.value
    endif
  endif
  assign about = product.description | replace: '<', ' <' | strip_html | replace: '&nbsp;', ' ' | strip_newlines | split: ' ' | join: ' ' | truncatewords: 80
  assign year = f.year.value | strip
  assign year_number = year | plus: 0 | append: ''
  assign coming_soon = false
  if f.coming_soon.value == true
    assign coming_soon = true
  endif
  assign artists = f.artist_entries.value
-%}
{%- unless product.type == 'Frame' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": {% if is_edition %}["Product", "VisualArtwork"]{% else %}"Product"{% endif %},
      "@id": {{ base | append: product.url | append: '#product' | json }},
      "name": {{ name | json }},
      "url": {{ base | append: product.url | json }}
      {%- if about != blank -%},"description": {{ about | json }}{%- endif -%}
      {%- if product.media.size > 0 -%}
        ,"image": [
          {%- assign first = true -%}
          {%- for media in product.media limit: 6 -%}
            {%- if media.media_type == 'image' -%}
              {%- unless first -%},{%- endunless -%}{%- assign first = false -%}
              {{- media | image_url: width: 1200 | prepend: 'https:' | json -}}
            {%- endif -%}
          {%- endfor -%}
        ]
      {%- endif -%}
      {%- if product.selected_or_first_available_variant.sku != blank -%},"sku": {{ product.selected_or_first_available_variant.sku | json }}{%- endif -%}
      {%- if is_edition -%}
        ,"creator": [
          {%- if artists != blank -%}
            {%- for artist in artists -%}
              {%- unless forloop.first -%},{%- endunless -%}
              {
                "@type": "Person",
                "@id": {{ base | append: artist.system.url | append: '#artist' | json }},
                "name": {{ artist.name.value | json }},
                "url": {{ base | append: artist.system.url | json }}
              }
            {%- endfor -%}
          {%- else -%}
            {"@type": "Person", "name": {{ f.artist.value | json }}}
          {%- endif -%}
        ]
        {%- if year.size == 4 and year_number == year -%},"dateCreated": {{ year | json }}{%- endif -%}
        {%- if f.medium.value != blank -%},"artMedium": {{ f.medium.value | json }},"material": {{ f.medium.value | json }}{%- endif -%}
        {%- if f.edition.value != blank -%},"artEdition": {{ f.edition.value | json }}{%- endif -%}
        {%- if f.dimensions.value != blank -%},"size": {{ f.dimensions.value | json }}{%- endif -%}
      {%- elsif product.vendor != blank -%}
        ,"brand": {"@type": "Brand", "name": {{ product.vendor | json }}}
      {%- endif -%}
      ,"offers": [
        {%- for variant in product.variants -%}
          {%- liquid
            assign offer_url = base | append: product.url
            unless product.has_only_default_variant
              assign offer_url = base | append: variant.url
            endunless
            assign availability = 'https://schema.org/InStock'
            if coming_soon or variant.available == false
              assign availability = 'https://schema.org/OutOfStock'
            endif
          -%}
          {%- unless forloop.first -%},{%- endunless -%}
          {
            "@type": "Offer",
            "url": {{ offer_url | json }},
            {%- unless product.has_only_default_variant -%}"name": {{ variant.title | json }},{%- endunless -%}
            {%- if variant.sku != blank -%}"sku": {{ variant.sku | json }},{%- endif -%}
            "price": {{ variant.price | divided_by: 100.0 | json }},
            "priceCurrency": {{ cart.currency.iso_code | json }},
            "availability": {{ availability | json }},
            "itemCondition": "https://schema.org/NewCondition",
            "seller": {%- render 'gs-schema-org', base: base -%}
          }
        {%- endfor -%}
      ]
    }
  </script>
{%- endunless -%}
