{% doc %}
  A page or an article as structured data (DS-158). A page is a schema.org WebPage, the contact
  page a ContactPage: its title, its description, its picture and the organisation it belongs
  to, from its programme field (blank is the Gallery, as gs-programme reads it). An article is a
  BlogPosting: its title, dates, picture, author and the gallery as its publisher.

  A page of questions is a FAQPage (DS-162): a page whose text has two or more
  headings that end with a question mark, all at one level (H3, else H2). Each heading is a
  question and the text up to the next heading is its answer, so the FAQ needs no fields of its
  own. The text is the page's, as gs-page-text picks it (DS-39).

  A page an artist entry names as its About page (Gordon and Marion, for Gordon Smith) says it
  is about that artist, by the artist's own name for machines.

  What a page is mainly about (DS-163): a list page, its list (gs-data-index); Artists for Kids'
  and the Foundation's own pages, the organisation, printed here in full with its logo; Plan
  your visit and Contact, the gallery. The page's own picture is given with its size and what
  it shows.

  The home page has the site and the gallery (gs-data), so it prints nothing here.

  @param {string} [description] - The page's description, as meta-tags works it out
  @param {object} [image] - The page's own picture, as meta-tags picks it

  @example
  {%- render 'gs-data-page', description: description -%}
{% enddoc %}
{%- liquid
  assign origin = shop.url
  assign home = origin | append: routes.root_url
  assign gallery_id = home | append: '#gallery'
  assign site_name = 'general.site_title.gallery' | t
-%}
{%- capture gallery -%}{%- render 'gs-data-org' -%}{%- endcapture -%}
{%- if request.page_type == 'page' -%}
  {%- liquid
    assign kind = 'WebPage'
    if page.id == settings.contact_page.id
      assign kind = 'ContactPage'
    endif
    assign image = image | default: page.metafields.custom.hero_image.value

    # The questions and answers in the page's text (DS-162).
    assign body = page.content
    if page.metafields.custom.release_body != blank
      assign body = page.metafields.custom.release_body.value
    endif
    assign level = ''
    if body contains '<h3'
      assign level = 'h3'
    elsif body contains '<h2'
      assign level = 'h2'
    endif
    assign questions = ''
    assign answers = ''
    assign total = 0
    if level != ''
      assign open = '<' | append: level
      assign close = '</' | append: level | append: '>'
      assign pieces = body | split: open
      for piece in pieces offset: 1
        assign halves = piece | split: close
        if halves.size < 2
          continue
        endif
        assign question = halves[0] | prepend: open | strip_html | strip_newlines | strip
        assign last_char = question | slice: -1
        if last_char != '?'
          continue
        endif
        assign answer = halves[1] | replace: '<', ' <' | strip_html | strip_newlines | split: ' ' | join: ' ' | replace: ' .', '.' | replace: ' ,', ','
        if answer == blank
          continue
        endif
        assign questions = questions | append: question | append: '~~row~~'
        assign answers = answers | append: answer | append: '~~row~~'
        assign total = total | plus: 1
      endfor
      assign questions = questions | split: '~~row~~'
      assign answers = answers | split: '~~row~~'
    endif
    if total > 1
      assign kind = 'FAQPage'
    endif

    # What the page is mainly about, when it is one thing (DS-163).
    assign subject = ''
    assign own_org = ''
    if page.id == settings.artists_for_kids_page.id
      assign own_org = 'Artists for Kids'
      assign subject = home | append: '#artists-for-kids'
    elsif page.id == settings.foundation_page.id
      assign own_org = 'Smith Foundation'
      assign subject = home | append: '#foundation'
    elsif page.id == settings.visit_page.id or page.id == settings.contact_page.id
      assign subject = gallery_id
    endif
    if page.id == settings.collection_page.id
      assign kind = 'CollectionPage'
      assign subject = home | append: '#collection'
    endif
    capture listed
      render 'gs-data-index'
    endcapture

    # The artist a page is about: the artist entry that names this page as its About page
    # (Gordon and Marion, for Gordon Smith). Read inside its own paginate tag (DS-152).
    assign about_id = ''
    assign about_name = ''
    paginate shop.metaobjects.artist.values by 250
      for a in shop.metaobjects.artist.values
        if a.about_page.value.id == page.id
          assign about_id = a.system.url | prepend: origin | append: '#artist'
          assign about_name = a.name.value
          assign about_url = a.system.url | prepend: origin
          break
        endif
      endfor
    endpaginate
    if listed contains 'true'
      assign kind = 'CollectionPage'
      assign subject = canonical_url | append: '#list'
    endif
  -%}
  {{ listed | remove_first: 'true' }}
  {%- if own_org != blank -%}
    {%- capture org -%}{%- render 'gs-data-org', programme: own_org, full: true -%}{%- endcapture -%}
    <script type="application/ld+json">
      {{ org | strip | replace_first: '{', '{ "@context": "https://schema.org",' }}
    </script>
  {%- endif -%}
  {%- if page.id == settings.collection_page.id -%}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Collection",
        "@id": {{ subject | json }},
        "name": {{ page.title | json }},
        "url": {{ canonical_url | json }},
        "provider": {{ gallery }}
        {%- if description != blank -%}
          ,"description": {{ description | json }}
        {%- endif -%}
      }
    </script>
  {%- endif -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": {{ kind | json }},
      "@id": {{ canonical_url | append: '#webpage' | json }},
      "name": {{ page.title | json }},
      "url": {{ canonical_url | json }},
      "inLanguage": {{ request.locale.iso_code | json }},
      "isPartOf": { "@type": "WebSite", "@id": {{ home | append: '#website' | json }}, "name": {{ site_name | json }}, "url": {{ home | json }} },
      "publisher": {% render 'gs-data-org', programme: page.metafields.custom.programme.value %}
      {%- if description != blank -%}
        ,"description": {{ description | json }}
      {%- endif -%}
      {%- if image != blank -%}
        ,"primaryImageOfPage": {% render 'gs-data-image', image: image %}
      {%- endif -%}
      {%- if about_id != blank -%}
        ,"about": { "@type": "Person", "@id": {{ about_id | json }}, "name": {{ about_name | json }}, "url": {{ about_url | json }} }
      {%- endif -%}
      {%- if subject != blank and total < 2 -%}
        ,"mainEntity": { "@id": {{ subject | json }} }
      {%- endif -%}
      {%- if total > 1 -%}
        ,"mainEntity": [
          {%- for question in questions -%}
            {
              "@type": "Question",
              "name": {{ question | json }},
              "acceptedAnswer": { "@type": "Answer", "text": {{ answers[forloop.index0] | json }} }
            }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ]
      {%- endif -%}
    }
  </script>
{%- elsif request.page_type == 'article' -%}
  {%- liquid
    assign words = description
    if words == blank
      assign words = article.excerpt_or_content | replace: '<', ' <' | strip_html | replace: '&nbsp;', ' ' | strip_newlines | split: ' ' | join: ' ' | truncatewords: 30
    endif
  -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      "headline": {{ article.title | truncate: 110 | json }},
      "url": {{ canonical_url | json }},
      "mainEntityOfPage": {{ canonical_url | json }},
      "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%:z' | json }},
      "dateModified": {{ article.updated_at | default: article.published_at | date: '%Y-%m-%dT%H:%M:%S%:z' | json }},
      "publisher": {{ gallery }}
      {%- if words != blank -%}
        ,"description": {{ words | json }}
      {%- endif -%}
      {%- if article.image != blank -%}
        ,"image": {{ article.image | image_url: width: 1200 | prepend: 'https:' | json }}
      {%- endif -%}
      {%- if article.author != blank -%}
        ,"author": { "@type": "Person", "name": {{ article.author | json }} }
      {%- endif -%}
    }
  </script>
{%- endif -%}
