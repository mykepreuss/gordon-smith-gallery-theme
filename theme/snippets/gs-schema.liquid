{% doc %}
  The page as schema.org data (JSON-LD, DS-154), for search engines and for the assistants that
  answer from them. Each page says what it is about, from the same fields the page shows, so the
  data never says more than the page does:

  - Home: the site and the gallery (address, phone, opening hours, social links). Plan your visit
    and the contact page carry the gallery too.
  - An exhibition: an ExhibitionEvent with its dates, place, picture, summary, artists, works
    from the collection, its opening reception and its coming events.
  - A page that lists events (Upcoming events, Current events, a programme's page): each event
    that hasn't ended. Events have no page of their own, so this is where they are described.
  - A work in the collection: a VisualArtwork. An artist: a ProfilePage about a Person. A
    grouping and a portfolio: a CollectionPage. A lesson: a LearningResource with its video.
  - A limited edition: a Product with its price and whether it can be bought (gs-schema-product).
  - An article: a BlogPosting. Any other page: a WebPage, or a ContactPage.
  - The way back the page shows (its crumb) as a BreadcrumbList.

  Addresses start with the store's own domain (shop.url), so a preview says the same as the live
  site. A field that is empty is left out. A year or a life date that isn't a plain year ("ND",
  "c. 1975") is left out of the dates and stays in the text.

  @example
  {%- render 'gs-schema' -%}
{% enddoc %}
{%- liquid
  assign base = shop.url
  assign here = base | append: request.path
  if request.path == '/'
    assign here = base | append: '/'
  endif
  assign site_name = 'general.site_title.gallery' | t
  assign crumb_name = ''
  assign crumb_url = ''
  assign leaf_name = ''
  assign kind = request.page_type
  if metaobject != blank
    assign kind = metaobject.system.type
  endif
-%}

{%- comment -%} The site and the gallery. {%- endcomment -%}
{%- if kind == 'index' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "@id": {{ base | append: '/#website' | json }},
      "name": {{ site_name | json }},
      "alternateName": {{ shop.name | replace: '&amp;', '&' | json }},
      "url": {{ base | append: '/' | json }},
      "inLanguage": {{ request.locale.iso_code | json }},
      "publisher": {"@id": {{ base | append: '/#gallery' | json }}}
    }
  </script>
{%- endif -%}
{%- liquid
  assign show_gallery = false
  if kind == 'index'
    assign show_gallery = true
  elsif kind == 'page'
    if page.id == settings.visit_page.id or page.id == settings.contact_page.id
      assign show_gallery = true
    endif
  endif
-%}
{%- if show_gallery -%}
  {%- capture gallery -%}{%- render 'gs-schema-place', base: base, detail: true -%}{%- endcapture -%}
  <script type="application/ld+json">
    {{ gallery | strip | replace_first: '{', '{"@context": "https://schema.org",' }}
  </script>
{%- endif -%}

{%- case kind -%}
  {%- when 'exhibition' -%}
    {%- render 'gs-schema-exhibition', base: base, here: here -%}

  {%- when 'artwork' -%}
    {%- render 'gs-schema-work', base: base, here: here -%}

  {%- when 'artist' -%}
    {%- render 'gs-schema-artist', base: base, here: here -%}

  {%- when 'collection_group' -%}
    {%- liquid
      assign leaf_name = metaobject.name.value
      if settings.collection_page != blank
        assign crumb_name = settings.collection_page.title
        assign crumb_url = settings.collection_page.url
      endif
      assign intro = metaobject.introduction.value | newline_to_br | strip_newlines | replace: '<br />', ' ' | split: ' ' | join: ' '
    -%}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "CollectionPage",
        "@id": {{ here | json }},
        "url": {{ here | json }},
        "name": {{ metaobject.name.value | json }}
        {%- if intro != blank -%},"description": {{ intro | json }}{%- endif -%}
        {%- if settings.collection_page != blank -%}
          ,"isPartOf": {
            "@type": "Collection",
            "@id": {{ base | append: settings.collection_page.url | append: '#collection' | json }},
            "name": {{ settings.collection_page.title | json }},
            "url": {{ base | append: settings.collection_page.url | json }}
          }
        {%- endif -%}
        ,"publisher": {%- render 'gs-schema-org', base: base -%}
      }
    </script>

  {%- when 'lesson' -%}
    {%- render 'gs-schema-lesson', base: base, here: here -%}

  {%- when 'product' -%}
    {%- liquid
      if settings.shop_page != blank
        assign crumb_name = 'shop.crumb' | t
        assign crumb_url = settings.shop_page.url
      endif
      assign leaf_name = product.metafields.custom.artwork_title.value | default: product.title
      render 'gs-schema-product', product: product, base: base
    -%}

  {%- when 'collection' -%}
    {%- liquid
      assign leaf_name = collection.title
      if settings.shop_page != blank
        assign crumb_name = 'shop.crumb' | t
        assign crumb_url = settings.shop_page.url
      endif
      assign intro = collection.description | replace: '<', ' <' | strip_html | replace: '&nbsp;', ' ' | strip_newlines | split: ' ' | join: ' ' | truncatewords: 60
    -%}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "CollectionPage",
        "@id": {{ base | append: collection.url | json }},
        "url": {{ base | append: collection.url | json }},
        "name": {{ collection.title | json }}
        {%- if intro != blank -%},"description": {{ intro | json }}{%- endif -%}
        {%- if collection.image != blank -%},"image": {{ collection.image | image_url: width: 1200 | prepend: 'https:' | json }}{%- endif -%}
        ,"publisher": {%- render 'gs-schema-org', base: base -%}
        {%- if collection.products.size > 0 -%}
          ,"mainEntity": {
            "@type": "ItemList",
            "numberOfItems": {{ collection.products_count }},
            "itemListElement": [
              {%- for item in collection.products limit: 50 -%}
                {%- liquid
                  assign item_name = item.title
                  assign f = item.metafields.custom
                  if f.artist.value != blank and f.artwork_title.value != blank
                    assign item_name = f.artist.value | append: ', ' | append: f.artwork_title.value
                  endif
                -%}
                {%- unless forloop.first -%},{%- endunless -%}
                {"@type": "ListItem", "position": {{ forloop.index }}, "name": {{ item_name | json }}, "url": {{ base | append: item.url | json }}}
              {%- endfor -%}
            ]
          }
        {%- endif -%}
      }
    </script>

  {%- when 'article' -%}
    {%- liquid
      assign leaf_name = article.title
      assign crumb_name = blog.title
      assign crumb_url = blog.url
      assign text = article.excerpt_or_content | replace: '<', ' <' | strip_html | replace: '&nbsp;', ' ' | strip_newlines | split: ' ' | join: ' ' | truncatewords: 60
    -%}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        "@id": {{ base | append: article.url | append: '#article' | json }},
        "headline": {{ article.title | truncate: 110 | json }},
        "url": {{ base | append: article.url | json }},
        "mainEntityOfPage": {{ base | append: article.url | json }},
        "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%:z' | json }},
        "dateModified": {{ article.updated_at | default: article.published_at | date: '%Y-%m-%dT%H:%M:%S%:z' | json }}
        {%- if text != blank -%},"description": {{ text | json }}{%- endif -%}
        {%- if article.image != blank -%},"image": {{ article.image | image_url: width: 1200 | prepend: 'https:' | json }}{%- endif -%}
        {%- if article.author != blank -%},"author": {"@type": "Person", "name": {{ article.author | json }}}{%- endif -%}
        ,"publisher": {%- render 'gs-schema-org', base: base -%}
      }
    </script>

  {%- when 'page' -%}
    {%- render 'gs-schema-page', base: base -%}

{%- endcase -%}

{%- render 'gs-schema-crumbs', base: base, here: here, name: crumb_name, url: crumb_url, leaf: leaf_name -%}
