{% doc %}
  An artist as schema.org data (DS-154): a ProfilePage about a Person, with the names the artist
  is known by, the years of birth and death, the start of the biography, the portrait and the
  artist's own website as the same person elsewhere. Then the way back, as a BreadcrumbList.

  Life dates read "1919 to 2000" or "born 1946"; only a plain year becomes a date.

  @param {string} base - The site's address, without a closing slash
  @param {string} here - This page's address

  @example
  {%- render 'gs-schema-artist', base: shop.url, here: here -%}
{% enddoc %}
{%- liquid
  assign artist = metaobject
  assign leaf_name = artist.name.value
  if settings.artists_page != blank
    assign crumb_name = settings.artists_page.title
    assign crumb_url = settings.artists_page.url
  endif
  assign bio = artist.biography | metafield_text | truncatewords: 60
  # Life dates read "1919 to 2000" or "born 1946"; only a plain year becomes a date.
  assign life = artist.life_dates.value | strip | downcase
  assign born = ''
  assign died = ''
  if life contains ' to '
    assign born = life | split: ' to ' | first | strip
    assign died = life | split: ' to ' | last | strip
  elsif life contains 'born '
    assign born = life | remove_first: 'born ' | strip
  endif
  assign born_number = born | plus: 0 | append: ''
  assign died_number = died | plus: 0 | append: ''
  if born.size != 4 or born_number != born
    assign born = ''
  endif
  if died.size != 4 or died_number != died
    assign died = ''
  endif
  assign also = ''
  if artist.other_names.value != blank
    assign also = also | append: artist.other_names.value | append: '|'
  endif
  if artist.full_name.value != blank
    assign also = also | append: artist.full_name.value | append: '|'
  endif
  assign also = also | split: '|'
-%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "ProfilePage",
    "@id": {{ here | json }},
    "url": {{ here | json }},
    "name": {{ artist.name.value | json }},
    "isPartOf": {"@id": {{ base | append: '/#website' | json }}},
    "mainEntity": {
      "@type": "Person",
      "@id": {{ here | append: '#artist' | json }},
      "name": {{ artist.name.value | json }},
      "url": {{ here | json }},
      "jobTitle": "Artist"
      {%- if also.size > 0 -%},"alternateName": {{ also | json }}{%- endif -%}
      {%- if born != blank -%},"birthDate": {{ born | json }}{%- endif -%}
      {%- if died != blank -%},"deathDate": {{ died | json }}{%- endif -%}
      {%- if bio != blank -%},"description": {{ bio | json }}{%- endif -%}
      {%- if artist.portrait.value != blank -%},"image": {{ artist.portrait.value | image_url: width: 1200 | prepend: 'https:' | json }}{%- endif -%}
      {%- if artist.website.value.url != blank -%},"sameAs": [{{ artist.website.value.url | json }}]{%- endif -%}
    }
  }
</script>
{%- render 'gs-schema-crumbs', base: base, here: here, name: crumb_name, url: crumb_url, leaf: leaf_name -%}
