{% doc %}
  The gallery as structured data (schema.org ArtGallery), one JSON object without its script tag,
  so gs-data prints it whole and an exhibition or an event names it as its location (DS-154). Everything comes from Theme settings, Gallery details, as the footer and Plan your
  visit do, so the hours and address are typed once.

  - The address is two lines: the street, then "City, Province Postal code". A second line in
    another form is given as typed, in one piece.
  - The short form is the name, address and web address: what a location needs.
  - The full form adds the other names the gallery goes by, telephone, email, opening hours, the
    social profiles, the logo, where it is on the map and a link for directions (DS-163). The
    map position is in Theme settings, Gallery details: it is the store's own address record.
  - The full form also says that anyone can come in without paying, when Theme settings says
    so, and what makes the building easy to get into (DS-171). Both repeat Plan your visit.
  - The full form gives the days the gallery is closed when it would otherwise be open, from the
    same Closures setting as the "open today" line (gs-closures, DS-191): each as special opening
    hours that open and close at 00:00, which is how a closed day is written.
  - The full form says when the gallery opened, who it belongs to and who funds it, from Theme
    settings, as the gallery gave them on 2026-10-01 (DS-193): the school district as its parent
    organisation, and the district and the Foundation as its funders. An empty setting says
    nothing.
  - With a room, the place is that room as part of the gallery ("Main Floor"): a Place with the
    gallery's address, inside the gallery.

  @param {boolean} [full] - The full form
  @param {string} [room] - Where in the building ("Main Floor"), for an exhibition's or an event's place

  @example
  <script type="application/ld+json">{% render 'gs-data-place', full: true %}</script>
{% enddoc %}
{%- liquid
  assign home = shop.url | append: routes.root_url
  assign gallery_id = home | append: '#gallery'
  assign name = 'general.site_title.gallery' | t

  assign lines = settings.address | newline_to_br | strip_newlines | split: '<br />'
  assign street = lines[0] | strip
  assign city = ''
  assign region = ''
  assign postal = ''
  assign second = lines[1] | strip
  if lines.size == 2 and second contains ', '
    assign parts = second | split: ', '
    assign tail = parts.last | strip | split: ' '
    if parts.size == 2 and tail.size > 1
      assign city = parts.first | strip
      assign region = tail.first
      assign postal = tail | join: ' ' | remove_first: region | strip
    endif
  endif

  assign keys = 'monday,tuesday,wednesday,thursday,friday,saturday,sunday' | split: ','
  assign open_days = ''
  for key in keys
    assign setting = 'open_' | append: key
    if settings[setting]
      assign open_days = open_days | append: key | append: ','
    endif
  endfor
  assign open_days = open_days | split: ','

  assign profiles = ''
  assign socials = 'social_instagram,social_facebook,social_x,social_youtube,social_vimeo,social_linkedin' | split: ','
  for key in socials
    if settings[key] != blank
      assign profiles = profiles | append: settings[key] | append: '|'
    endif
  endfor
  assign profiles = profiles | split: '|'

  # What makes the building easy to get into, one to a line in Theme settings (DS-171).
  assign access = ''
  assign access_lines = settings.access_features | newline_to_br | strip_newlines | split: '<br />'
  for line in access_lines
    assign feature = line | strip
    if feature != blank
      assign access = access | append: feature | append: '|'
    endif
  endfor
  assign access = access | split: '|'

  # The days it is closed, as "first/last" pairs (DS-191).
  capture closed
    render 'gs-closures', part: 'data'
  endcapture
  assign closed = closed | strip | split: ','

  # The year it opened is given only when it is a year (DS-193).
  assign founded = settings.gallery_founded | strip
  assign founded_back = founded | plus: 0 | append: ''
-%}
{
  {%- if room != blank -%}
    "@type": "Place",
    "name": {{ room | append: ', ' | append: name | json }},
    "containedInPlace": { "@type": "ArtGallery", "@id": {{ gallery_id | json }}, "name": {{ name | json }}, "url": {{ home | json }} }
  {%- else -%}
    "@type": "ArtGallery",
    "@id": {{ gallery_id | json }},
    "name": {{ name | json }},
    "url": {{ home | json }}
  {%- endif -%}
  {%- if street != blank -%}
    ,"address":
    {%- if city != blank -%}
      {
        "@type": "PostalAddress",
        "streetAddress": {{ street | json }},
        "addressLocality": {{ city | json }},
        "addressRegion": {{ region | json }},
        "postalCode": {{ postal | json }}
        {%- if shop.address.country_code != blank -%}
          ,"addressCountry": {{ shop.address.country_code | json }}
        {%- endif -%}
      }
    {%- else -%}
      {{ lines | join: ', ' | json }}
    {%- endif -%}
  {%- endif -%}
  {%- if full -%}
    ,"alternateName": [{{ 'general.site_title.gallery_full' | t | json }}, {{ shop.name | replace: '&amp;', '&' | json }}]
    {%- if settings.phone != blank -%}
      ,"telephone": {{ settings.phone | json }}
    {%- endif -%}
    {%- if settings.email != blank -%}
      ,"email": {{ settings.email | json }}
    {%- endif -%}
    {%- if page_image -%}
      ,"image": {{ page_image | image_url: width: 1200 | prepend: 'https:' | json }}
    {%- endif -%}
    {%- if open_days.size > 0 and settings.opens_at != blank and settings.closes_at != blank -%}
      ,"openingHoursSpecification": {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": [
          {%- for day in open_days -%}
            {{ day | capitalize | prepend: 'https://schema.org/' | json }}{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ],
        "opens": {{ settings.opens_at | json }},
        "closes": {{ settings.closes_at | json }}
      }
    {%- endif -%}
    {%- if closed.size > 0 and open_days.size > 0 -%}
      ,"specialOpeningHoursSpecification": [
        {%- for closure in closed -%}
          {%- assign ends = closure | split: '/' -%}
          { "@type": "OpeningHoursSpecification", "validFrom": {{ ends.first | json }}, "validThrough": {{ ends.last | json }}, "opens": "00:00", "closes": "00:00" }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    {%- endif -%}
    {%- if profiles.size > 0 -%}
      ,"sameAs": {{ profiles | json }}
    {%- endif -%}
    {%- if founded.size == 4 and founded_back == founded -%}
      ,"foundingDate": {{ founded | json }}
    {%- endif -%}
    {%- if settings.gallery_owner != blank -%}
      {%- capture owner -%}
        { "@type": "Organization", "name": {{ settings.gallery_owner | json }}{% if settings.gallery_owner_url != blank %}, "url": {{ settings.gallery_owner_url | json }}{% endif %} }
      {%- endcapture -%}
      ,"parentOrganization": {{ owner | strip }}
      ,"funder": [
        {{ owner | strip }},
        { "@type": "Organization", "@id": {{ home | append: '#foundation' | json }}, "name": {{ 'general.site_title.foundation' | t | json }} }
      ]
    {%- endif -%}
    ,"logo": {{ 'gs-logo-gallery.svg' | asset_url | prepend: 'https:' | json }}
    {%- if settings.latitude != blank and settings.longitude != blank -%}
      ,"geo": { "@type": "GeoCoordinates", "latitude": {{ settings.latitude | json }}, "longitude": {{ settings.longitude | json }} }
    {%- endif -%}
    {%- if settings.address != blank -%}
      ,"hasMap": {{ settings.address | newline_to_br | replace: '<br />', ', ' | strip_newlines | url_encode | prepend: 'https://www.google.com/maps/dir/?api=1&destination=' | json }}
    {%- endif -%}
    {%- if settings.home_description != blank -%}
      ,"description": {{ settings.home_description | strip_newlines | json }}
    {%- endif -%}
    {%- if settings.admission_free -%}
      ,"isAccessibleForFree": true
      ,"publicAccess": true
    {%- endif -%}
    {%- if access.size > 0 -%}
      ,"amenityFeature": [
        {%- for feature in access -%}
          { "@type": "LocationFeatureSpecification", "name": {{ feature | json }}, "value": true }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    {%- endif -%}
  {%- endif -%}
}
