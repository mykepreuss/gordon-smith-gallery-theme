{% doc %}
  A lesson as schema.org data (DS-154): a LearningResource from Artists for Kids with its grade
  levels and date, and its video as a VideoObject, which needs a picture and a date: the cover,
  else YouTube's own picture of the video. Then the way back, as a BreadcrumbList.

  The video's address is read as gs-video reads it.

  @param {string} base - The site's address, without a closing slash
  @param {string} here - This page's address

  @example
  {%- render 'gs-schema-lesson', base: shop.url, here: here -%}
{% enddoc %}
{%- liquid
  assign lesson = metaobject
  assign leaf_name = lesson.title.value
  if settings.lessons_page != blank
    assign crumb_name = settings.lessons_page.title
    assign crumb_url = settings.lessons_page.url
  endif
  assign making = lesson.making.value | newline_to_br | strip_newlines | replace: '<br />', ' ' | split: ' ' | join: ' '
  assign posted = lesson.posted.value | date: '%Y-%m-%d'

  # The video's address for playing and its picture, as gs-video reads the field.
  assign address = lesson.video.value | strip
  assign embed = ''
  assign thumb = ''
  if address contains 'vimeo.com/'
    assign vimeo = address | split: 'vimeo.com/' | last | remove: 'video/' | split: '?' | first | split: '#' | first | split: '/' | first
    assign vimeo_number = vimeo | plus: 0 | append: ''
    if vimeo_number == vimeo
      assign embed = 'https://player.vimeo.com/video/' | append: vimeo
    endif
  else
    assign id = ''
    if address contains 'youtu.be/'
      assign id = address | split: 'youtu.be/' | last
    elsif address contains 'youtube.com/watch' and address contains 'v='
      assign id = address | split: 'v=' | last
    elsif address contains '/embed/'
      assign id = address | split: '/embed/' | last
    elsif address contains '/shorts/'
      assign id = address | split: '/shorts/' | last
    endif
    assign id = id | split: '?' | first | split: '&' | first | split: '#' | first | split: '/' | first
    if id != blank
      assign embed = 'https://www.youtube-nocookie.com/embed/' | append: id
      assign thumb = 'https://i.ytimg.com/vi/' | append: id | append: '/hqdefault.jpg'
    endif
  endif
  if lesson.cover.value != blank
    assign thumb = lesson.cover.value | image_url: width: 1200 | prepend: 'https:'
  endif
  assign video_text = making | default: lesson.title.value
-%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "LearningResource",
    "@id": {{ here | append: '#lesson' | json }},
    "name": {{ lesson.title.value | json }},
    "url": {{ here | json }},
    "learningResourceType": "Video lesson",
    "about": "Visual arts",
    "inLanguage": {{ request.locale.iso_code | json }}
    {%- if making != blank -%},"description": {{ making | json }}{%- endif -%}
    {%- if lesson.grades.value != blank -%},"educationalLevel": {{ lesson.grades.value | json }}{%- endif -%}
    {%- if posted != blank -%},"datePublished": {{ posted | json }}{%- endif -%}
    {%- if thumb != blank -%},"image": {{ thumb | json }}{%- endif -%}
    ,"provider": {%- render 'gs-schema-org', base: base, programme: 'Artists for Kids' -%}
    {%- if embed != blank and thumb != blank and posted != blank -%}
      ,"video": {
        "@type": "VideoObject",
        "name": {{ lesson.title.value | json }},
        "description": {{ video_text | json }},
        "thumbnailUrl": {{ thumb | json }},
        "uploadDate": {{ posted | json }},
        "embedUrl": {{ embed | json }}
      }
    {%- endif -%}
  }
</script>
{%- render 'gs-schema-crumbs', base: base, here: here, name: crumb_name, url: crumb_url, leaf: leaf_name -%}
