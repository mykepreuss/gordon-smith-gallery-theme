{%- comment -%}
  Portfolio navigation (DESIGN.md §7.5, SHOP-01, SHOP-02): one compact card per portfolio, in the
  order of Theme settings, Shop, with its first work whole on the mat (artwork mode, DS-05). The Shop landing's one
  listing: nothing else on the page repeats it. Also on Shopify's /collections page, which the
  menu no longer links to (P-06). On a page, it shows only on the Shop landing page chosen in
  Theme settings, so another page given the Shop template reads as a plain page (DS-49).
{%- endcomment -%}
{%- liquid
  assign portfolios = settings.portfolio_collections
  if page != blank and settings.shop_page != blank and page.id != settings.shop_page.id
    assign portfolios = blank
  endif
-%}
{%- if portfolios != blank -%}
  <section class="gs-section gs-surface-paper" aria-labelledby="{{ section.id }}-heading">
    <div class="gs-container">
      <div class="gs-section-head">
        <h2 class="gs-h2" id="{{ section.id }}-heading">{{ section.settings.heading | escape }}</h2>
        {%- if settings.all_editions_collection != blank -%}
          <a class="gs-cta-link gs-cta-link--more" href="{{ settings.all_editions_collection.url }}">{{ 'shop.all_editions_link' | t }}</a>
        {%- endif -%}
      </div>
      <ul class="gs-grid gs-grid--artworks" role="list">
        {%- for portfolio in portfolios -%}
          {%- assign count_text = 'shop.editions_count' | t: count: portfolio.products_count -%}
          <li>{%- render 'gs-set-card', image: portfolio.products.first.featured_media, title: portfolio.title, url: portfolio.url, count_text: count_text, ratio: 'var(--gs-ratio-artwork)', preset: 'tile' -%}</li>
        {%- endfor -%}
      </ul>
    </div>
  </section>
{%- elsif request.design_mode -%}
  <p class="gs-editor-warning gs-container">Choose the portfolios in Theme settings, Shop.</p>
{%- endif -%}

{% schema %}
{
  "name": "Portfolio navigation",
  "tag": "div",
  "enabled_on": {
    "templates": ["page", "list-collections"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows the portfolios chosen in Theme settings, Shop, newest first."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Portfolios"
    }
  ],
  "presets": [
    {
      "name": "Portfolio navigation"
    }
  ]
}
{% endschema %}
