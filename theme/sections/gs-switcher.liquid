{%- comment -%}
  Sibling navigation (DESIGN.md §6.7, DS-13): moves sideways between pages of the same kind
  without the main menu. Real links with aria-current, not tabs, because each item is its own page.

  On exhibition list pages: On now, Upcoming, Past, with counts from the exhibition entries
  (hidden when zero). The pages are the ones chosen in Theme settings, Exhibitions and events.
  On portfolio pages: All editions, then each portfolio in Theme settings, Shop, newest first
  (DS-67). The row is labelled Portfolios, so each link names its season and year, "Fall 2026",
  taken from the collection's title ("2026 Fall Portfolio"); a title in another form shows as
  it is. Short labels keep the row on one line: five "Portfolio"s made it wrap and strand the
  last link.
  On the Upcoming events page and the programmes' pages: All events, then each programme
  (gs-programme-index), with its count of upcoming events (DS-143). A programme's page is its
  filtered view: its own words, then its events only. Past events, the page chosen in Theme
  settings, ends the row, at its far end on wide screens (DS-147).
{%- endcomment -%}
{%- if collection != blank -%}
  {%- assign nav_label = 'shop.portfolios' | t -%}
  <nav class="gs-container gs-switcher gs-lead-in" aria-label="{{ nav_label }}">
    <ul class="gs-switcher__list">
      {%- assign all = settings.all_editions_collection -%}
      {%- if all != blank -%}
        <li><a href="{{ all.url }}"{% if all.handle == collection.handle %} aria-current="page"{% endif %}>{{ 'shop.all_editions' | t }}</a></li>
      {%- endif -%}
      {%- for item in settings.portfolio_collections -%}
        {%- liquid
          assign label = item.title | remove: ' Portfolio' | remove: ' portfolio' | strip
          assign words = label | split: ' '
          if words.size == 2
            assign year = words[0] | plus: 0
            if year > 1900
              assign label = words[1] | append: ' ' | append: words[0]
            endif
          endif
        -%}
        <li><a href="{{ item.url }}"{% if item.handle == collection.handle %} aria-current="page"{% endif %}>{{ label | escape }}</a></li>
      {%- endfor -%}
    </ul>
  </nav>
{%- else -%}
  {%- liquid
    # On a page, only the three exhibition lists, the Upcoming events page and the programmes show this switcher.
    assign exhibitions_page = false
    assign programmes_row = ''
    if page != blank
      if page.id == settings.exhibitions_on_now_page.id or page.id == settings.exhibitions_upcoming_page.id or page.id == settings.exhibitions_past_page.id
        assign exhibitions_page = true
      elsif settings.events_page != blank
        capture programmes_row
          render 'gs-programme-index'
        endcapture
        assign programmes_row = programmes_row | strip | split: ','
        assign here = false
        if page.id == settings.events_page.id or page.id == settings.events_past_page.id
          assign here = true
        endif
        for item in programmes_row
          assign handle = item | split: '|' | first
          if handle == page.handle
            assign here = true
          endif
        endfor
        if here and programmes_row.size == 0
          # No programmes yet: the row still has All upcoming, and Past events.
          assign programmes_row = ',' | split: '|'
        endif
        unless here
          assign programmes_row = ''
        endunless
      endif
    endif
  -%}
{%- endif -%}
{%- if collection == blank and exhibitions_page -%}
  {%- liquid
    assign on_now = 0
    assign upcoming = 0
    assign past = 0
    for entry in shop.metaobjects.exhibition.values
      capture state
        render 'gs-exhibition-status', start: entry.start_date.value, end: entry.end_date.value
      endcapture
      assign state = state | strip
      case state
        when 'on-now'
          assign on_now = on_now | plus: 1
        when 'upcoming'
          assign upcoming = upcoming | plus: 1
        else
          assign past = past | plus: 1
      endcase
    endfor
    assign items = 'on_now,upcoming,past' | split: ','
  -%}
  <nav class="gs-container gs-switcher gs-lead-in" aria-label="{{ 'exhibitions.switcher_label' | t }}">
    <ul class="gs-switcher__list">
      {%- for item in items -%}
        {%- liquid
          case item
            when 'on_now'
              assign target = settings.exhibitions_on_now_page
              assign count = on_now
            when 'upcoming'
              assign target = settings.exhibitions_upcoming_page
              assign count = upcoming
            else
              assign target = settings.exhibitions_past_page
              assign count = past
          endcase
          assign label_key = 'exhibitions.switcher_' | append: item
        -%}
        {%- if target != blank -%}
          <li>
            <a href="{{ target.url }}"{% if page.id == target.id %} aria-current="page"{% endif %}>
              {{- label_key | t -}}
              {%- if count > 0 %} <span class="gs-switcher__count"><span aria-hidden="true">{{ count }}</span><span class="gs-visually-hidden">, {{ 'exhibitions.count' | t: count: count }}</span></span>{% endif -%}
            </a>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </nav>
{%- endif -%}
{%- if collection == blank and programmes_row.size > 0 -%}
  {%- liquid
    capture total
      render 'gs-event-index'
    endcapture
    assign total = total | strip | split: ',' | size
    capture ended
      render 'gs-event-index', past: true
    endcapture
    assign ended = ended | strip | split: ',' | size
  -%}
  <nav class="gs-container gs-switcher gs-lead-in" aria-label="{{ 'events.switcher_label' | t }}">
    <ul class="gs-switcher__list">
      <li>
        <a href="{{ settings.events_page.url }}"{% if page.id == settings.events_page.id %} aria-current="page"{% endif %}>
          {{- 'events.switcher_all' | t -}}
          {%- if total > 0 %} <span class="gs-switcher__count"><span aria-hidden="true">{{ total }}</span><span class="gs-visually-hidden">, {{ 'events.count' | t: count: total }}</span></span>{% endif -%}
        </a>
      </li>
      {%- for item in programmes_row -%}
        {%- liquid
          assign pair = item | split: '|'
          assign target = pages[pair[0]]
          assign count = pair[1] | plus: 0
        -%}
        {%- if target != blank -%}
          <li>
            <a href="{{ target.url }}"{% if page.id == target.id %} aria-current="page"{% endif %}>
              {{- target.title | escape -}}
              {%- if count > 0 %} <span class="gs-switcher__count"><span aria-hidden="true">{{ count }}</span><span class="gs-visually-hidden">, {{ 'events.count' | t: count: count }}</span></span>{% endif -%}
            </a>
          </li>
        {%- endif -%}
      {%- endfor -%}
      {%- if settings.events_past_page != blank -%}
        <li class="gs-switcher__end">
          <a href="{{ settings.events_past_page.url }}"{% if page.id == settings.events_past_page.id %} aria-current="page"{% endif %}>
            {{- 'events.switcher_past' | t -}}
            {%- if ended > 0 %} <span class="gs-switcher__count"><span aria-hidden="true">{{ ended }}</span><span class="gs-visually-hidden">, {{ 'events.count' | t: count: ended }}</span></span>{% endif -%}
          </a>
        </li>
      {%- endif -%}
    </ul>
  </nav>
{%- endif -%}

{% schema %}
{
  "name": "Switcher",
  "tag": "div",
  "enabled_on": {
    "templates": ["page", "collection"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "On exhibition pages: On now, Upcoming and Past, from Theme settings, Exhibitions and events. On the Upcoming events page and the programmes' pages: the programmes in the Programs filter menu there, and any other page with an upcoming event. On portfolio pages: the portfolios in Theme settings, Shop."
    }
  ],
  "presets": [
    {
      "name": "Switcher"
    }
  ]
}
{% endschema %}
