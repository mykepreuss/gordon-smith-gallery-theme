{%- comment -%}
  Feature panel: one box with text beside an image, for pointing to one thing (a programme, Our
  Story). Used on the home page and the Shop landing, which are the only pages on their
  templates, so the content lives in the section. The box takes the surface: tint by default,
  accent (the brand's box colour) at most once on a page, or ink (DESIGN.md §3.2).
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign mode = 'photo'
  if s.image_is_artwork
    assign mode = 'artwork'
  endif
  assign surface = s.surface | default: 'tint'
-%}
{%- if s.heading == blank and s.text == blank and s.image == blank -%}
  {%- if request.design_mode -%}
    <p class="gs-editor-warning gs-container">Add a heading, text or image to this feature. Visitors see nothing here until you do.</p>
  {%- endif -%}
{%- else -%}
<section class="gs-section gs-surface-paper"{% if s.heading != blank %} aria-labelledby="{{ section.id }}-heading"{% endif %}>
  <div class="gs-container">
    <div class="gs-feature gs-surface-{{ surface }}{% if s.image == blank %} gs-feature--no-media{% endif %}">
      {%- if s.image != blank -%}
        {%- render 'gs-media', image: s.image, preset: 'card', sizes: '(min-width: 990px) 55vw, 100vw', mode: mode, shape: 'md' -%}
      {%- endif -%}
      <div class="gs-feature__text">
        {%- if s.eyebrow != blank -%}
          <p class="gs-eyebrow">{{ s.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if s.heading != blank -%}
          <h2 class="gs-h2" id="{{ section.id }}-heading">{{ s.heading | escape }}</h2>
        {%- endif -%}
        {%- if s.text != blank -%}
          <div class="gs-prose">{{ s.text }}</div>
        {%- endif -%}
        {%- if s.button_label != blank and s.button_link != blank -%}
          <a class="gs-button" href="{{ s.button_link }}">{{ s.button_label | escape }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Feature",
  "tag": "div",
  "enabled_on": {
    "templates": ["index", "page"]
  },
  "settings": [
    {
      "type": "select",
      "id": "surface",
      "label": "Surface",
      "options": [
        { "value": "tint", "label": "Tint" },
        { "value": "accent", "label": "Brand colour (once per page)" },
        { "value": "ink", "label": "Ink" }
      ],
      "default": "tint"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "checkbox",
      "id": "image_is_artwork",
      "label": "The image is an artwork",
      "default": false
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Label above the heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Feature"
    }
  ]
}
{% endschema %}
