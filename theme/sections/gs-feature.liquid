{%- comment -%}
  Feature panel: one box with text beside an image, for pointing to one thing (a programme,
  framing). Used on the home page and the Shop landing, which are the only pages on their
  templates, so the content lives in the section. The box takes the surface: tint by default,
  accent (the brand's box colour) at most once on a page, or ink (DESIGN.md §3.2). On a page it
  shows only on the Shop landing page chosen in Theme settings (DS-49): the content is that page's.

  A programme setting gives the panel that programme's colours (DS-54): Artists for Kids' orange
  or the Foundation's green for its box, button and rules, as on the programme's own pages. Staff
  pick the programme, never a colour (§9.4). A second, plain link can sit beside the button.
{%- endcomment -%}
{%- liquid
  assign other_page = false
  if page != blank and settings.shop_page != blank and page.id != settings.shop_page.id
    assign other_page = true
  endif
  assign s = section.settings
  assign mode = 'photo'
  if s.image_is_artwork
    assign mode = 'artwork'
  endif
  assign surface = s.surface | default: 'tint'
  capture brand
    render 'gs-programme', value: s.programme
  endcapture
  assign brand = brand | strip
-%}
{%- if other_page -%}
  {%- comment -%} Not the Shop landing page: nothing to show. {%- endcomment -%}
{%- elsif s.heading == blank and s.text == blank and s.image == blank -%}
  {%- if request.design_mode -%}
    <p class="gs-editor-warning gs-container">Add a heading, text or image to this feature. Visitors see nothing here until you do.</p>
  {%- endif -%}
{%- else -%}
<section class="gs-section gs-surface-paper"{% if s.programme != blank %} data-gs-brand="{{ brand }}"{% endif %}{% if s.heading != blank %} aria-labelledby="{{ section.id }}-heading"{% endif %}>
  <div class="gs-container">
    <div class="gs-feature gs-surface-{{ surface }}{% if s.image == blank %} gs-feature--no-media{% endif %}">
      {%- if s.image != blank -%}
        {%- render 'gs-media', image: s.image, preset: 'card', sizes: '(min-width: 990px) 55vw, 100vw', mode: mode, shape: 'md' -%}
      {%- endif -%}
      <div class="gs-feature__text">
        {%- if s.eyebrow != blank -%}
          <p class="gs-eyebrow">{{ s.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if s.heading != blank -%}
          <h2 class="gs-h2" id="{{ section.id }}-heading">{{ s.heading | escape }}</h2>
        {%- endif -%}
        {%- if s.text != blank -%}
          <div class="gs-prose">{{ s.text }}</div>
        {%- endif -%}
        {%- liquid
          assign has_button = false
          if s.button_label != blank and s.button_link != blank
            assign has_button = true
          endif
          assign has_link = false
          if s.link_label != blank and s.link_url != blank
            assign has_link = true
          endif
        -%}
        {%- if has_button or has_link -%}
          <div class="gs-actions">
            {%- if has_button -%}
              {%- render 'gs-link', url: s.button_link, label: s.button_label, class: 'gs-button' -%}
            {%- endif -%}
            {%- if has_link -%}
              {%- render 'gs-link', url: s.link_url, label: s.link_label, class: 'gs-cta-link' -%}
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Feature",
  "tag": "div",
  "enabled_on": {
    "templates": ["index", "page"]
  },
  "settings": [
    {
      "type": "select",
      "id": "programme",
      "label": "Programme",
      "options": [
        { "value": "Gallery", "label": "The gallery" },
        { "value": "Artists for Kids", "label": "Artists for Kids" },
        { "value": "Smith Foundation", "label": "Smith Foundation" }
      ],
      "default": "Gallery",
      "info": "Gives the panel that programme's colours, as on its own pages."
    },
    {
      "type": "select",
      "id": "surface",
      "label": "Surface",
      "options": [
        { "value": "tint", "label": "Tint" },
        { "value": "accent", "label": "Brand colour (once per page)" },
        { "value": "ink", "label": "Ink" }
      ],
      "default": "tint"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "checkbox",
      "id": "image_is_artwork",
      "label": "The image is an artwork",
      "default": false
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Label above the heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Second link label",
      "info": "Optional. A plain link beside the button."
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Second link"
    }
  ],
  "presets": [
    {
      "name": "Feature"
    }
  ]
}
{% endschema %}
