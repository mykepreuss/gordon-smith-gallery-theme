{%- comment -%}
  An exhibition's hero (DESIGN.md §6.3, §7.5): the key image, then the title box with the status
  chip and dates (or the dates note), the title and the subtitle. Status and dates come from the
  entry's dates, never typed (DS-15, DS-18). A key image that is an artwork shows whole beside
  the box; a photo is overlapped by the box by a fixed amount. The key image caption (an artwork
  caption, a photo credit or both) sits under it.
{%- endcomment -%}
{%- liquid
  assign entry = metaobject
  assign mode = 'photo'
  if entry.key_image_is_artwork.value == true
    assign mode = 'artwork'
  endif
-%}
<div class="gs-section gs-section--lead">
  <div class="gs-hero{% if mode == 'artwork' %} gs-hero--artwork{% endif %}">
    {%- render 'gs-media', image: entry.key_image.value, preset: 'hero', mode: mode, shape: 'lg', class: 'gs-hero__media', alt: entry.title.value -%}
    <div class="gs-hero__box gs-surface-accent">
      {%- render 'gs-exhibition-when', entry: entry, show_status: true -%}
      <h1 class="gs-h1"{% render 'gs-fit', text: entry.title.value %}>{{ entry.title.value | escape }}</h1>
      {%- if entry.subtitle.value != blank -%}
        <p class="gs-deck">{{ entry.subtitle.value | escape }}</p>
      {%- endif -%}
    </div>
    {%- if entry.key_image_caption.value != blank -%}
      <div class="gs-hero__caption gs-caption">{{ entry.key_image_caption | metafield_tag }}</div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Exhibition hero",
  "tag": "section",
  "enabled_on": {
    "templates": ["metaobject"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "From the exhibition entry: key image, title, subtitle, dates and key image caption."
    }
  ],
  "presets": [
    {
      "name": "Exhibition hero"
    }
  ]
}
{% endschema %}
