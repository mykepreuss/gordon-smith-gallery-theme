{%- comment -%}
  Contact details and form (DESIGN.md §7.5, ACCESS-02) beside Shopify's contact form, which emails
  the store's sender address. The details are the Contact page's own text when it has some, so the
  gallery's words (both email addresses, office hours) show once, beside the form (DS-42). A page
  without text gets the address, hours, email and phone from Theme settings, Gallery details.
  Works without JavaScript; gs-forms.js adds the inline email check and the "Sending" state.
{%- endcomment -%}
{%- assign form_id = 'gs-contact-' | append: section.id -%}
{%- capture page_text -%}{% render 'gs-page-text' %}{%- endcapture -%}
<div class="gs-section gs-surface-paper">
  <div class="gs-container gs-contact">
    {%- if page_text != blank -%}
    <div class="gs-panel gs-surface-tint">
      <div class="gs-prose">{{ page_text }}</div>
    </div>
    {%- else -%}
    <div class="gs-panel gs-surface-tint">
      <h2 class="gs-h4">{{ 'contact.details_heading' | t }}</h2>
      {%- if settings.address != blank -%}
        <address>{{ settings.address | escape | newline_to_br }}</address>
      {%- endif -%}
      {%- if settings.hours != blank -%}
        <p>{{ settings.hours | escape | newline_to_br }}</p>
      {%- endif -%}
      {%- if settings.email != blank -%}
        <p><a class="gs-link" href="mailto:{{ settings.email | strip }}">{{ settings.email | strip | escape }}</a></p>
      {%- endif -%}
      {%- if settings.phone != blank -%}
        <p><a class="gs-link" href="tel:{{ settings.phone | remove: ' ' | remove: '-' | remove: '(' | remove: ')' | remove: '.' }}">{{ settings.phone | escape }}</a></p>
      {%- endif -%}
    </div>
    {%- endif -%}

    {%- form 'contact', id: form_id, class: 'gs-form', data-gs-form: '' -%}
      <h2 class="gs-h3">{{ section.settings.heading | escape }}</h2>
      {%- if form.posted_successfully? -%}
        <p class="gs-form-status" role="status">{{ 'contact.done' | t }}</p>
      {%- endif -%}
      {%- liquid
        assign email_error = false
        if form.errors contains 'email'
          assign email_error = true
        endif
        assign body_error = false
        if form.errors contains 'body'
          assign body_error = true
        endif
      -%}
      <div class="gs-field">
        <label class="gs-field__label" for="{{ form_id }}-name">{{ 'contact.name' | t }}</label>
        <input class="gs-input" id="{{ form_id }}-name" type="text" name="contact[name]" autocomplete="name" value="{{ form.name | escape }}">
      </div>
      <div class="gs-field">
        <label class="gs-field__label" for="{{ form_id }}-email">{{ 'contact.email' | t }}</label>
        <input
          class="gs-input"
          id="{{ form_id }}-email"
          type="email"
          name="contact[email]"
          autocomplete="email"
          autocapitalize="off"
          spellcheck="false"
          required
          value="{{ form.email | escape }}"
          aria-describedby="{{ form_id }}-email-error"
          {% if email_error %}
            aria-invalid="true" autofocus
          {% endif %}
        >
        <p class="gs-field__error" id="{{ form_id }}-email-error"{% unless email_error %} hidden{% endunless %}>{{ 'newsletter.error_email' | t }}</p>
      </div>
      <div class="gs-field">
        <label class="gs-field__label" for="{{ form_id }}-phone">{{ 'contact.phone' | t }}</label>
        <input class="gs-input" id="{{ form_id }}-phone" type="tel" name="contact[phone]" autocomplete="tel" value="{{ form.phone | escape }}">
      </div>
      <div class="gs-field">
        <label class="gs-field__label" for="{{ form_id }}-body">{{ 'contact.message' | t }}</label>
        <textarea
          class="gs-input"
          id="{{ form_id }}-body"
          name="contact[body]"
          required
          aria-describedby="{{ form_id }}-body-error"
          {% if body_error %}
            aria-invalid="true"
          {% endif %}
        >{{ form.body | escape }}</textarea>
        <p class="gs-field__error" id="{{ form_id }}-body-error"{% unless body_error %} hidden{% endunless %}>{{ 'contact.error_message' | t }}</p>
      </div>
      <button class="gs-button" type="submit" data-gs-busy-label="{{ 'contact.busy' | t }}">{{ 'contact.submit' | t }}</button>
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Contact details and form",
  "tag": "section",
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Address, hours, email and phone come from Theme settings, Gallery details. Messages go to the store's sender email address."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Form heading",
      "default": "Contact Us"
    }
  ],
  "presets": [
    {
      "name": "Contact details and form"
    }
  ]
}
{% endschema %}
