{%- comment -%}
  A blog's articles, newest first. The store's News blog is empty; this keeps its address
  working in the site's style if it's ever used.
{%- endcomment -%}
<div class="gs-container gs-lead-in">
  <header class="gs-page-head">
    {%- render 'gs-title-block', title: blog.title -%}
  </header>
</div>
<div class="gs-section gs-surface-paper">
  <div class="gs-container">
    {%- paginate blog.articles by 12 -%}
      {%- if blog.articles.size > 0 -%}
        <ul class="gs-grid gs-grid--cards" role="list">
          {%- for article in blog.articles -%}
            <li>
              <article class="gs-card">
                {%- render 'gs-media', image: article.image, preset: 'card', mode: 'photo', title: article.title -%}
                <h2 class="gs-card__title"><a href="{{ article.url }}">{{ article.title | escape }}</a></h2>
                <p class="gs-status__dates"><time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: '%B %-d, %Y' }}</time></p>
                {%- if article.excerpt != blank -%}
                  <p class="gs-card__text">{{ article.excerpt | strip_html | truncatewords: 30, '…' }}</p>
                {%- endif -%}
              </article>
            </li>
          {%- endfor -%}
        </ul>
        {%- render 'gs-pagination', paginate: paginate -%}
      {%- else -%}
        {%- assign empty_text = 'blog.empty' | t -%}
        {%- assign empty_label = 'blog.empty_link' | t -%}
        {%- render 'gs-empty', text: empty_text, link_url: settings.events_page.url, link_label: empty_label -%}
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</div>

{% schema %}
{
  "name": "Blog",
  "tag": "section",
  "enabled_on": {
    "templates": ["blog"]
  },
  "settings": []
}
{% endschema %}
