{%- comment -%}
  The works on an artist's page or a grouping's page (DESIGN.md §7.5, DS-62): artwork tiles, 24 to a
  page, in the order of the entry's Works list. On an artist's page they sit under "Works in the
  collection"; on a grouping's page the grouping's name is the page title, so the heading only
  counts them. An artist with no works yet (an edition only) shows nothing here.
{%- endcomment -%}
{%- liquid
  assign is_artist = false
  if metaobject.system.type == 'artist'
    assign is_artist = true
  endif
-%}
{%- comment -%}
  Paginate before anything else reads the list: once the list has been read (even to test that
  it isn't blank), the paginate tag no longer slices it and every page shows the first 50.
{%- endcomment -%}
{%- paginate metaobject.works.value by 24 -%}
  {%- if paginate.items > 0 -%}
    <section class="gs-section gs-surface-paper" aria-labelledby="{{ section.id }}-heading">
      <div class="gs-container">
        <div class="gs-section-head">
          <div class="gs-section-head__text">
            {%- if is_artist -%}
              <h2 class="gs-h2" id="{{ section.id }}-heading">{{ 'collection.works_heading' | t }}</h2>
              <p class="gs-meta">{{ 'collection.works_count' | t: count: paginate.items }}</p>
            {%- else -%}
              <h2 class="gs-h3" id="{{ section.id }}-heading">{{ 'collection.works_count' | t: count: paginate.items }}</h2>
            {%- endif -%}
          </div>
        </div>
        <ul class="gs-grid gs-grid--artworks">
          {%- for work in metaobject.works.value -%}
            <li>{%- render 'gs-work-tile', work: work, heading: 'h3', hide_artist: is_artist -%}</li>
          {%- endfor -%}
        </ul>
        {%- render 'gs-pagination', paginate: paginate -%}
      </div>
    </section>
  {%- endif -%}
{%- endpaginate -%}

{% schema %}
{
  "name": "Works",
  "tag": "div",
  "enabled_on": {
    "templates": ["metaobject"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "The entry's Works list, as artwork tiles, 24 to a page."
    }
  ],
  "presets": [
    {
      "name": "Works"
    }
  ]
}
{% endschema %}
