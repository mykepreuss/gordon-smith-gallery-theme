{%- comment -%}
  Artists A to Z (DESIGN.md §6.13, §7.5, DS-62, DS-64): every artist entry, sorted by its sort name
  (surname first), under a large letter, each name followed by its number of works in the
  collection ("Dana Claxton 2"), as the categories on the Permanent Collection page.
  Each name opens the artist's page on this site, never another site. The letter bar stays at the
  top of the screen and jumps down the list.

  The list is built from the entries, so adding an artist entry adds the name; nobody edits it here.
  With the script, a field above the list filters it as you type (gs-collection.js); without it,
  the whole list is on the page.

  Sorting: Liquid can't sort entries by a field, so each row is written once with its sort key in
  front, the rows are sorted as text, and the key is taken off again.
{%- endcomment -%}
{%- assign id = 'gs-index-' | append: section.id -%}
{%- paginate metaobjects.artist.values by 250 -%}
  {%- liquid
    assign rows = ''
    for a in metaobjects.artist.values
      assign key = a.sort_name.value | default: a.name.value | downcase | strip
      assign search = a.name.value | append: ' ' | append: a.full_name.value | append: ' ' | append: a.other_names.value | downcase | strip
      assign count = a.works.value.size
      assign search_attr = search | escape
      assign name_html = a.name.value | escape
      capture row
        echo '<li class="gs-index__item" data-gs-names="' | append: search_attr | append: '">'
        echo '<a class="gs-link" href="' | append: a.system.url | append: '">' | append: name_html | append: '</a>'
        if count > 0
          # "Dana Claxton 2": the number shows, and a screen reader hears "2 works".
          assign works = 'collection.works_count' | t: count: count
          echo ' <span class="gs-meta"><span aria-hidden="true">' | append: count | append: '</span><span class="gs-visually-hidden">' | append: works | append: '</span></span>'
        endif
        echo '</li>'
      endcapture
      assign rows = rows | append: key | append: '~~key~~' | append: row | append: '~~row~~'
    endfor
    assign rows = rows | split: '~~row~~' | sort

    # The letters that have names, for the jump links.
    assign letters = ''
    for row in rows
      assign letter = row | slice: 0 | upcase
      unless 'ABCDEFGHIJKLMNOPQRSTUVWXYZ' contains letter
        assign letter = '#'
      endunless
      unless letters contains letter
        assign letters = letters | append: letter
      endunless
    endfor
    assign letters = letters | split: ''
  -%}
  <section class="gs-section gs-surface-paper" aria-labelledby="{{ id }}-heading">
    <div class="gs-container">
      <div class="gs-index" data-gs-index>
        <div class="gs-section-head">
          <div class="gs-section-head__text">
            <h2 class="gs-h2" id="{{ id }}-heading">{{ 'collection.index_heading' | t }}</h2>
            <p class="gs-meta">{{ 'collection.artists_count' | t: count: paginate.items }}</p>
          </div>
        </div>

        <div class="gs-index__tools" data-gs-index-tools hidden>
          <div class="gs-field">
            <label class="gs-field__label" for="{{ id }}-filter">{{ 'collection.find_artist' | t }}</label>
            <input class="gs-input" id="{{ id }}-filter" type="search" autocomplete="off" spellcheck="false" aria-describedby="{{ id }}-status">
          </div>
          <p class="gs-meta" id="{{ id }}-status" role="status"
            data-gs-one="{{ 'collection.artists_found_one' | t: terms: '[terms]' | escape }}"
            data-gs-other="{{ 'collection.artists_found_other' | t: number: '[count]', terms: '[terms]' | escape }}"
            data-gs-none="{{ 'collection.artists_none' | t: terms: '[terms]' | escape }}"></p>
        </div>

        <nav class="gs-letters" aria-label="{{ 'collection.letters' | t }}" data-gs-letters>
          <ul>
            {%- for letter in letters -%}
              {%- assign anchor = id | append: '-' | append: letter | replace: '#', 'other' | downcase -%}
              <li><a href="#{{ anchor }}">{{ letter }}</a></li>
            {%- endfor -%}
          </ul>
        </nav>

        <div class="gs-index__groups">
          {%- liquid
            # Each letter's names go in their own group; the group is opened at its first name and
            # closed before the next letter (written with echo, so the markup checker can follow it).
            assign current = ''
            for row in rows
              assign item = row | split: '~~key~~' | last
              if item == blank
                continue
              endif
              assign letter = row | slice: 0 | upcase
              unless 'ABCDEFGHIJKLMNOPQRSTUVWXYZ' contains letter
                assign letter = '#'
              endunless
              if letter != current
                if current != ''
                  echo '</ul></section>'
                endif
                assign current = letter
                assign anchor = id | append: '-' | append: letter | replace: '#', 'other' | downcase
                echo '<section class="gs-index__group" id="' | append: anchor | append: '" aria-labelledby="' | append: anchor | append: '-h">'
                echo '<h3 class="gs-index__letter" id="' | append: anchor | append: '-h">' | append: letter | append: '</h3>'
                echo '<ul class="gs-index__list">'
              endif
              echo item
            endfor
            if current != ''
              echo '</ul></section>'
            endif
          -%}
        </div>
      </div>
    </div>
  </section>
{%- endpaginate -%}
<script src="{{ 'gs-collection.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Artists A to Z",
  "tag": "div",
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Every Artist entry, A to Z by sort name. Add or change artists in Content, Metaobjects, Artist."
    }
  ],
  "presets": [
    {
      "name": "Artists A to Z"
    }
  ]
}
{% endschema %}
