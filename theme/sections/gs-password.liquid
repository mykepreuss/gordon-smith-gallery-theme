{%- comment -%}
  The password page, shown only while the store is password protected. The Gallery logo, the
  store's message, and the password form.
{%- endcomment -%}
{%- assign form_id = 'gs-password-' | append: section.id -%}
<div class="gs-section gs-section--lead">
  <div class="gs-container gs-form">
    <span class="gs-page-head__logo">{%- render 'gs-logo', name: 'gallery-full-stacked-colour-box' -%}</span>
    <h1 class="gs-h2">{{ 'password.title' | t }}</h1>
    {%- if shop.password_message != blank -%}
      <p class="gs-deck">{{ shop.password_message | escape }}</p>
    {%- endif -%}
    {%- form 'storefront_password', id: form_id, class: 'gs-form' -%}
      {%- assign password_error = false -%}
      {%- if form.errors -%}{%- assign password_error = true -%}{%- endif -%}
      <div class="gs-field">
        <label class="gs-field__label" for="{{ form_id }}-input">{{ 'password.password' | t }}</label>
        <input
          class="gs-input"
          id="{{ form_id }}-input"
          type="password"
          name="password"
          autocomplete="current-password"
          {% if password_error %}
            aria-invalid="true" aria-describedby="{{ form_id }}-input-error" autofocus
          {% endif %}
        >
        <p class="gs-field__error" id="{{ form_id }}-input-error"{% unless password_error %} hidden{% endunless %}>{{ 'password.error' | t }}</p>
      </div>
      <button class="gs-button" type="submit">{{ 'password.enter' | t }}</button>
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Password",
  "tag": "section",
  "enabled_on": {
    "templates": ["password"]
  },
  "settings": []
}
{% endschema %}
