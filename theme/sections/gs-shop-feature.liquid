{%- comment -%}
  Shop feature on the home page: the newest portfolio, automatically. It reads the first
  portfolio in Theme settings, Shop, so the home page can't keep featuring an older portfolio
  after a new one is out (proposals/content-migration.md, Home). The portfolio's image, or its first work
  whole on the mat, beside the heading, the portfolio's name and a button to the Shop landing.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign portfolio = settings.portfolio_collections | first
  assign image = portfolio.image
  assign mode = 'photo'
  if image == blank
    assign image = portfolio.products.first.featured_media
    assign mode = 'artwork'
  endif
  assign destination = settings.shop_page.url | default: portfolio.url
-%}
{%- if portfolio != blank -%}
  <section class="gs-section gs-surface-paper" aria-labelledby="{{ section.id }}-heading">
    <div class="gs-container">
      <div class="gs-feature gs-surface-{{ s.surface | default: 'tint' }}{% if image == blank %} gs-feature--no-media{% endif %}">
        {%- if image != blank -%}
          {%- render 'gs-media', image: image, preset: 'card', sizes: '(min-width: 990px) 55vw, 100vw', mode: mode, shape: 'md', alt: portfolio.title -%}
        {%- endif -%}
        <div class="gs-feature__text">
          <p class="gs-eyebrow">{{ portfolio.title | escape }}</p>
          <h2 class="gs-h2" id="{{ section.id }}-heading">{{ s.heading | escape }}</h2>
          {%- if s.text != blank -%}
            <div class="gs-prose">{{ s.text }}</div>
          {%- endif -%}
          <div class="gs-actions">
            <a class="gs-button" href="{{ destination }}">{{ s.button_label | escape }}</a>
            <a class="gs-cta-link" href="{{ portfolio.url }}">{{ 'shop.see_portfolio' | t: title: portfolio.title }}</a>
          </div>
        </div>
      </div>
    </div>
  </section>
{%- elsif request.design_mode -%}
  <p class="gs-editor-warning gs-container">Choose the portfolios in Theme settings, Shop. The first one is featured here.</p>
{%- endif -%}

{% schema %}
{
  "name": "Shop feature",
  "tag": "div",
  "enabled_on": {
    "templates": ["index"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Features the first portfolio in Theme settings, Shop, and links to the Shop landing page."
    },
    {
      "type": "select",
      "id": "surface",
      "label": "Surface",
      "options": [
        { "value": "tint", "label": "Tint" },
        { "value": "accent", "label": "Brand colour (once per page)" },
        { "value": "ink", "label": "Ink" }
      ],
      "default": "tint"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop Limited Editions"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "View Shop"
    }
  ],
  "presets": [
    {
      "name": "Shop feature"
    }
  ]
}
{% endschema %}
