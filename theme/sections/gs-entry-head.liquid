{%- comment -%}
  The header of an artist's page or a grouping's page (DESIGN.md §6.6, §7.5, DS-62), from the entry.

  Artist: a link back to the Artists page, the name, the other names the artist is known by (a
  Haida or traditional name, the full name), then nationality or Nation and life dates, and the
  biography when there is one, with the portrait beside them. No link out to the artist's website
  (DS-63): the page is about their work here. A page on this site about the artist's life (the
  entry's About page field: Gordon and Marion for Gordon Smith) gets a link, "About Gordon Smith"
  (P-57). Their documents follow the works (gs-artist-documents).

  Grouping: a link back to the Permanent Collection page, the name and the introduction.
{%- endcomment -%}
{%- liquid
  assign is_artist = false
  if metaobject.system.type == 'artist'
    assign is_artist = true
    assign title = metaobject.name.value
    assign back = settings.artists_page
  else
    assign title = metaobject.name.value
    assign back = settings.collection_page
  endif
-%}
<div class="gs-container gs-lead-in">
  <header class="gs-page-head">
    {%- if back != blank -%}
      <p class="gs-crumb"><a href="{{ back.url }}">{{ back.title | escape }}</a></p>
    {%- endif -%}
    {%- if is_artist -%}
      {%- liquid
        # Other names, then the full name, each on its own line.
        assign other_names = metaobject.other_names.value
        assign full_name = metaobject.full_name.value
        assign facts = metaobject.nationality.value
        if metaobject.life_dates.value != blank
          if facts != blank
            assign facts = facts | append: ', '
          endif
          assign facts = facts | append: metaobject.life_dates.value
        endif
        # The line starts with a capital ("Born 1946"). Not capitalize, which lower-cases the rest.
        if facts != blank
          assign first_char = facts | slice: 0 | upcase
          assign rest = facts | slice: 1, facts.size
          assign facts = first_char | append: rest
        endif
        assign has_aside = false
        if metaobject.portrait.value != blank
          assign has_aside = true
        endif
      -%}
      <div class="gs-entry-head">
        <div class="gs-entry-head__main">
          <h1 class="gs-h1"{% render 'gs-fit', text: title %}>{{ title | escape }}</h1>
          {%- if other_names != blank or full_name != blank -%}
            <p class="gs-deck">
              {{- other_names | escape -}}
              {%- if other_names != blank and full_name != blank -%}<br>{%- endif -%}
              {{- full_name | escape -}}
            </p>
          {%- endif -%}
          {%- if facts != blank -%}
            <p class="gs-deck">{{ facts | escape }}</p>
          {%- endif -%}
          {%- if metaobject.biography.value != blank -%}
            <div class="gs-prose">{%- capture html -%}{{ metaobject.biography | metafield_tag }}{%- endcapture -%}{%- render 'gs-rich-text', html: html, link_names: true -%}</div>
          {%- endif -%}
          {%- assign about = metaobject.about_page.value -%}
          {%- if about.url != blank -%}
            {%- assign about_name = title | escape -%}
            <p><a class="gs-cta-link" href="{{ about.url }}">{{ 'collection.about_artist' | t: name: about_name }}</a></p>
          {%- endif -%}
        </div>
        {%- if has_aside -%}
          <div class="gs-entry-head__aside">
            {%- if metaobject.portrait.value != blank -%}
              {%- render 'gs-media', image: metaobject.portrait.value, sizes: '(min-width: 990px) 320px, 80vw', mode: 'photo', ratio: 'var(--gs-ratio-portrait)' -%}
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    {%- else -%}
      <h1 class="gs-h1"{% render 'gs-fit', text: title %}>{{ title | escape }}</h1>
      {%- if metaobject.introduction.value != blank -%}
        <div class="gs-prose">{%- render 'gs-paragraphs', text: metaobject.introduction.value, link_names: true -%}</div>
      {%- endif -%}
    {%- endif -%}
  </header>
</div>

{% schema %}
{
  "name": "Artist or grouping header",
  "tag": "section",
  "enabled_on": {
    "templates": ["metaobject"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Everything here comes from the entry, in Content, Metaobjects."
    }
  ],
  "presets": [
    {
      "name": "Artist or grouping header"
    }
  ]
}
{% endschema %}
