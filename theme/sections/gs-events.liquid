{%- comment -%}
  Events (content model part 5, P-16, DS-143, DS-147). On the pages chosen in Theme settings as
  the Current, Upcoming and Past events pages it lists every programme's events of that kind:
  this week's, under way or starting in the next seven days (DS-153); those that start after
  that, soonest first; those that have
  ended, newest first, without their tickets links. The list's heading is for screen readers
  only: the row of links above it says which list this is. An empty list says so.

  On a programme in the switcher (gs-programme-index) it lists that page's own events in groups,
  Current, Upcoming and Past, each under its heading with its count. A group with nothing in it
  is left out, except that a programme with nothing on or coming says so. Past shows the latest
  six, without pictures or summaries, and links to the Past events page. Any other page shows
  nothing here. An event moves from list to list by its dates.

  Events are read back inside a paginate tag: a plain loop stops at 50 entries (DS-148). The
  lists read the first 250 entries; from 200 the theme editor says so on the three lists, so the
  oldest ended events are removed in time.
{%- endcomment -%}
{%- liquid
  assign when = ''
  if page.id == settings.events_page.id
    assign when = 'upcoming'
  elsif page.id == settings.events_current_page.id
    assign when = 'current'
  elsif page.id == settings.events_past_page.id
    assign when = 'past'
  endif
  assign groups = when
  if when == blank
    capture filtered
      render 'gs-programme-index', check: page
    endcapture
    if filtered contains 'true'
      assign groups = 'current,upcoming,past'
    endif
  endif
  assign groups = groups | split: ','
  assign live = 0
-%}
{%- for group in groups -%}
  {%- liquid
    if when != blank
      capture ids
        render 'gs-event-index', when: group
      endcapture
    elsif group == 'past'
      capture ids
        render 'gs-event-index', for_page: page, when: group, limit: 7
      endcapture
    else
      capture ids
        render 'gs-event-index', for_page: page, when: group
      endcapture
    endif
    assign ids = ids | strip | split: ','
    assign more = false
    assign cap = 250
    if when == blank and group == 'past'
      assign cap = 6
    endif
    if when == blank and group == 'past' and ids.size > 6
      assign more = true
    endif
    unless group == 'past'
      assign live = live | plus: ids.size
    endunless
    # A programme's empty groups are left out; Upcoming stays to say nothing is on or coming.
    assign show = true
    if when == blank and ids.size == 0
      assign show = false
      if group == 'upcoming' and live == 0
        assign show = true
      endif
    endif
    assign heading_key = 'events.' | append: group
    assign past = false
    if group == 'past'
      assign past = true
    endif
  -%}
  {%- if show -%}
    <section class="gs-section gs-surface-paper" aria-labelledby="{{ section.id }}-{{ group }}">
      <div class="gs-container{% if when == blank %} gs-events-group{% endif %}">
        {%- if when != blank -%}
          <h2 class="gs-visually-hidden" id="{{ section.id }}-{{ group }}">{{ heading_key | t }}</h2>
        {%- else -%}
          <div class="gs-section-head">
            <h2 class="gs-h3" id="{{ section.id }}-{{ group }}">
              {{- heading_key | t -}}
              {%- if ids.size > 0 and more == false %} <span class="gs-switcher__count"><span aria-hidden="true">{{ ids.size }}</span><span class="gs-visually-hidden">, {{ 'events.count' | t: count: ids.size }}</span></span>{% endif -%}
            </h2>
            {%- if more and settings.events_past_page != blank -%}
              <a class="gs-cta-link gs-cta-link--more" href="{{ settings.events_past_page.url }}">{{ 'events.all_past' | t }}</a>
            {%- endif -%}
          </div>
        {%- endif -%}
        {%- if ids.size > 0 -%}
          <ul class="gs-events{% if when != blank %} gs-events--led{% endif %}{% if when == blank and past %} gs-events--quiet{% endif %}" role="list">
            {%- paginate shop.metaobjects.event.values by 250 -%}
              {%- for id in ids limit: cap -%}
                {%- assign n = id | plus: 0 -%}
                {%- for event in shop.metaobjects.event.values offset: n limit: 1 -%}
                  {%- if when == blank and past -%}
                    {%- render 'gs-event', event: event, page_title: page.title, past: true, compact: true -%}
                  {%- else -%}
                    {%- render 'gs-event', event: event, page_title: page.title, past: past -%}
                  {%- endif -%}
                {%- endfor -%}
              {%- endfor -%}
              {%- assign entries = paginate.items -%}
            {%- endpaginate -%}
          </ul>
          {%- if request.design_mode and when != blank and entries >= 200 -%}
            <p class="gs-editor-warning">There are {{ entries }} event entries, and the lists read the first 250. Delete the oldest ended events in Content, Metaobjects, Events, or set them to Draft.</p>
          {%- endif -%}
        {%- else -%}
          {%- liquid
            assign empty_key = 'events.empty_' | append: group
            assign empty_label = 'events.empty_link' | t
            assign empty_url = settings.events_page.url
            if when == blank
              assign empty_key = 'events.empty_programme'
              assign empty_label = 'events.empty_programme_link' | t
            elsif group == 'upcoming'
              assign empty_url = settings.exhibitions_on_now_page.url
              assign empty_label = 'events.empty_upcoming_link' | t
            endif
            assign empty_text = empty_key | t
          -%}
          {%- render 'gs-empty', text: empty_text, link_url: empty_url, link_label: empty_label -%}
        {%- endif -%}
      </div>
    </section>
  {%- endif -%}
{%- endfor -%}

{% schema %}
{
  "name": "Events",
  "tag": "div",
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Events come from their entries in Content, Metaobjects, Events. The Current, Upcoming and Past pages in Theme settings list every event; a programme's page lists its own. Link an event to its programme page to list it there."
    }
  ],
  "presets": [
    {
      "name": "Events"
    }
  ]
}
{% endschema %}
