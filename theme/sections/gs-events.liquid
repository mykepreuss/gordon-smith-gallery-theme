{%- comment -%}
  Upcoming events (content model part 5, P-16). On the page chosen as the Upcoming events page in
  theme settings it lists every upcoming event; on any other page, the events whose programme
  page is that page. An event drops off once it has ended. The Upcoming events page says when
  there are none, and so does a programme in the switcher (gs-programme-index, DS-143), with a
  link to every event; any other page without events shows nothing here. On the Upcoming events
  page the list's heading is for screen readers only: the page title already says it. The
  switcher above the list has the link to every event. On the page chosen as the Past events page
  it lists the events that have ended, newest first, without their tickets links (DS-147).
  The lists read the first 250 event entries (DS-148). From 200 the theme editor says so on the
  Upcoming events and Past events pages, so the oldest ended events are removed in time.
{%- endcomment -%}
{%- liquid
  assign all = false
  if settings.events_page != blank and page.id == settings.events_page.id
    assign all = true
  endif
  assign past = false
  if settings.events_past_page != blank and page.id == settings.events_past_page.id
    assign past = true
    assign all = true
  endif
  if past
    capture ids
      render 'gs-event-index', past: true
    endcapture
  elsif all
    capture ids
      render 'gs-event-index'
    endcapture
  else
    capture ids
      render 'gs-event-index', for_page: page
    endcapture
  endif
  assign ids = ids | strip | split: ','
  assign filtered = false
  unless all
    capture filtered
      render 'gs-programme-index', check: page
    endcapture
    if filtered contains 'true'
      assign filtered = true
    else
      assign filtered = false
    endif
  endunless
-%}
{%- if ids.size > 0 or all or filtered -%}
  <section class="gs-section gs-surface-paper" aria-labelledby="{{ section.id }}-heading">
    <div class="gs-container">
      {%- if all -%}
        <h2 class="gs-visually-hidden" id="{{ section.id }}-heading">{% if past %}{{ 'events.past_heading' | t }}{% else %}{{ section.settings.heading | escape }}{% endif %}</h2>
      {%- else -%}
        <div class="gs-section-head">
          <h2 class="gs-h2" id="{{ section.id }}-heading">{{ section.settings.heading | escape }}</h2>
        </div>
      {%- endif -%}
      {%- if ids.size > 0 -%}
        <ul class="gs-events" role="list">
          {%- paginate shop.metaobjects.event.values by 250 -%}
            {%- for id in ids -%}
              {%- assign n = id | plus: 0 -%}
              {%- for event in shop.metaobjects.event.values offset: n limit: 1 -%}
                {%- render 'gs-event', event: event, page_title: page.title, past: past -%}
              {%- endfor -%}
            {%- endfor -%}
            {%- assign entries = paginate.items -%}
          {%- endpaginate -%}
        </ul>
        {%- if request.design_mode and all and entries >= 200 -%}
          <p class="gs-editor-warning">There are {{ entries }} event entries, and the lists read the first 250. Delete the oldest ended events in Content, Metaobjects, Events, or set them to Draft.</p>
        {%- endif -%}
      {%- elsif past -%}
        {%- assign empty_text = 'events.empty_past' | t -%}
        {%- assign empty_label = 'events.empty_programme_link' | t -%}
        {%- render 'gs-empty', text: empty_text, link_url: settings.events_page.url, link_label: empty_label -%}
      {%- elsif filtered -%}
        {%- assign empty_text = 'events.empty_programme' | t -%}
        {%- assign empty_label = 'events.empty_programme_link' | t -%}
        {%- render 'gs-empty', text: empty_text, link_url: settings.events_page.url, link_label: empty_label -%}
      {%- else -%}
        {%- assign empty_text = 'events.empty' | t -%}
        {%- assign empty_label = 'events.empty_link' | t -%}
        {%- render 'gs-empty', text: empty_text, link_url: settings.exhibitions_on_now_page.url, link_label: empty_label -%}
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Upcoming events",
  "tag": "div",
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Events come from their entries in Content, Metaobjects, Events. Link an event to its programme page to list it there."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Upcoming events"
    }
  ],
  "presets": [
    {
      "name": "Upcoming events"
    }
  ]
}
{% endschema %}
