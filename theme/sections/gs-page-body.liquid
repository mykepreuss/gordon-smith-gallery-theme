{%- comment -%}
  The page's body text from the normal page editor, styled by .gs-prose (DESIGN.md §6.11). Fonts,
  sizes and colours pasted from Word or email are neutralised there (TYPE-03). The text comes from
  gs-page-text: staged text until release (DS-39), without a heading that repeats the title (DS-41).

  The Part setting is the same for every page on a template (DS-51): the programme template shows
  the opening before its programmes and the headed sections after them. Text with a figure sets
  each picture beside its paragraphs (gs-text-media).
{%- endcomment -%}
{%- capture text -%}{% render 'gs-page-text', part: section.settings.part %}{%- endcapture -%}
{%- if text != blank -%}
  <div class="gs-section gs-surface-paper">
    <div class="gs-container">
      {%- if text contains '<figure' -%}
        {%- render 'gs-text-media', text: text -%}
      {%- else -%}
        <div class="gs-prose">{{ text }}</div>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Page text",
  "tag": "section",
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows the page's own text, from Online Store, Pages."
    },
    {
      "type": "select",
      "id": "part",
      "label": "Part of the text",
      "options": [
        { "value": "all", "label": "All of it" },
        { "value": "opening", "label": "The opening, up to the first heading" },
        { "value": "sections", "label": "The headed sections, from the first heading on" }
      ],
      "default": "all",
      "info": "The same for every page on this template. The programme template shows the opening before the programmes and the headed sections after them."
    }
  ],
  "presets": [
    {
      "name": "Page text"
    }
  ]
}
{% endschema %}
