{%- comment -%}
  The page's body text from the normal page editor, styled by .gs-prose (DESIGN.md §6.11). Fonts,
  sizes and colours pasted from Word or email are neutralised there (TYPE-03). The text comes from
  gs-page-text: staged text until release (DS-39), without a heading that repeats the title (DS-41).

  The Part setting is the same for every page on a template (DS-51). On a programme page the
  opening comes before the programmes and the headed sections after them, whose H2s are section
  headings, level with the programmes' heading. On any other page the opening part is all of the
  text and the sections part shows nothing, so the default template can carry both parts and still
  lay programme pages out right before their templates are reassigned (gs-is-programme-page, L-08).
  Text with a figure sets each picture beside its paragraphs (gs-text-media). On the page chosen as
  Plan your visit page in Theme settings, the visit details come first (gs-visit-info, DS-61).
  A programme page with nothing between its parts (no card groups or lessons) shows its text as one
  part. A long page (text with H2s) whose button leaves the site, with no card groups, shows its
  button again after its text, so the way to act is at the end too (DS-83, Proposed). On
  the page chosen as ArtReach videos page, the lessons follow the opening and the cards
  (gs-lesson-list, DS-70): the second part lists them before its text, whatever template the page
  has, so the list shows before release too, when the page still has its old template name.
{%- endcomment -%}
{%- liquid
  assign lessons_here = false
  if settings.lessons_page != blank and page.id == settings.lessons_page.id
    assign lessons_here = true
  endif
  assign part = section.settings.part
  if part == 'opening' or part == 'sections'
    capture programme_page
      render 'gs-is-programme-page'
    endcapture
    # A programme page splits its text only when something sits between the parts (card groups,
    # the lessons); otherwise its text reads as one part, its H2s at the page-text size (DS-40).
    assign split = false
    if programme_page contains 'true'
      if page.metafields.custom.card_groups.value != blank or lessons_here
        assign split = true
      endif
    endif
    unless split
      if part == 'opening'
        assign part = 'all'
      else
        assign part = 'none'
      endif
    endunless
  endif
-%}
{%- if part != 'none' -%}
  {%- capture text -%}{% render 'gs-page-text', part: part %}{%- endcapture -%}
{%- endif -%}
{%- comment -%} The Plan your visit page starts with its visit details (DS-61). {%- endcomment -%}
{%- if part == 'all' or part == 'opening' -%}
  {%- if settings.visit_page != blank and page.id == settings.visit_page.id -%}
    {%- render 'gs-visit-info' -%}
  {%- endif -%}
{%- endif -%}
{%- comment -%} The ArtReach videos page lists its lessons after its opening and cards (DS-70). {%- endcomment -%}
{%- if lessons_here and section.settings.part == 'sections' -%}
  {%- render 'gs-lesson-list', id: section.id -%}
{%- endif -%}
{%- if text != blank -%}
  <div class="gs-section gs-surface-paper">
    <div class="gs-container">
      {%- if part == 'sections' -%}
        {%- render 'gs-text-media', text: text, heads: true -%}
      {%- elsif text contains '<figure' -%}
        {%- render 'gs-text-media', text: text -%}
      {%- else -%}
        <div class="gs-prose">{{ text }}</div>
      {%- endif -%}
      {%- liquid
        assign repeat_cta = false
        assign cta = page.metafields.custom.cta.value
        if part == 'all' and cta.url != blank and text contains '<h2' and page.metafields.custom.card_groups.value == blank
          capture cr
            render 'gs-url', link: cta
          endcapture
          assign cr = cr | strip | split: '|'
          if cr[1] == '1' and cr[2] != '1'
            assign repeat_cta = true
          endif
        endif
      -%}
      {%- if repeat_cta -%}
        <div class="gs-actions gs-page-body__actions">{%- render 'gs-link', link: cta, class: 'gs-button' -%}</div>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{%- if lessons_here and section.settings.part == 'all' -%}
  {%- render 'gs-lesson-list', id: section.id -%}
{%- endif -%}

{% schema %}
{
  "name": "Page text",
  "tag": "section",
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows the page's own text, from Online Store, Pages."
    },
    {
      "type": "select",
      "id": "part",
      "label": "Part of the text",
      "options": [
        { "value": "all", "label": "All of it" },
        { "value": "opening", "label": "Before the cards" },
        { "value": "sections", "label": "After the cards" }
      ],
      "default": "all",
      "info": "The same for every page on this template. On a programme page, Before the cards is the text up to its first heading and After the cards the headed sections. On other pages, Before the cards is all of it and After the cards is empty."
    }
  ],
  "presets": [
    {
      "name": "Page text"
    }
  ]
}
{% endschema %}
