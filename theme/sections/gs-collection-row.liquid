{%- comment -%}
  From the collection (Home, DS-188): the first three featured works of the Permanent Collection
  as artwork tiles, so the home page shows works from the collection and leads into it, as the
  New limited editions row does for the Shop (DS-54). The works are the first three of the
  Collection grouping whose handle is "featured", the ones the Permanent Collection page shows
  (gs-collection-featured), in its order, so staff choose them once.

  The heading says how large the collection is, counted from the entries, then links to the
  Permanent Collection page and to Artists A to Z (Theme settings, Collection). Three works, whole
  on the mat (DS-05, DS-46). On phones the row scrolls sideways (.gs-rail), so the third work never
  sits alone on a row. Nothing shows when no work is featured.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign group = metaobjects['collection_group']['featured']
  assign shown = 0
  capture tiles
    for work in group.works.value limit: 3
      assign shown = shown | plus: 1
      echo '<li>'
      render 'gs-work-tile', work: work, heading: 'h3', sizes: '(min-width: 1296px) 384px, (min-width: 750px) 31vw, 75vw'
      echo '</li>'
    endfor
  endcapture

  # How many works and artists the collection holds: a list paged by one gives its size without
  # reading it (gs-collection-search).
  paginate metaobjects.artwork.values by 1
    assign works_total = paginate.items
  endpaginate
  paginate metaobjects.artist.values by 1
    assign artists_total = paginate.items
  endpaginate
  capture works_number
    render 'gs-number', value: works_total
  endcapture
  capture artists_number
    render 'gs-number', value: artists_total
  endcapture
  assign works_number = works_number | strip
  assign artists_number = artists_number | strip
-%}
{%- if shown > 0 -%}
  <section class="gs-section gs-surface-paper" aria-labelledby="{{ section.id }}-heading">
    <div class="gs-container">
      <div class="gs-section-head">
        <div class="gs-section-head__text">
          <h2 class="gs-h2" id="{{ section.id }}-heading">{{ s.heading | escape }}</h2>
          {%- if works_total > 0 and artists_total > 0 -%}
            <p class="gs-meta">{{ 'collection.totals' | t: works: works_number, artists: artists_number }}</p>
          {%- endif -%}
        </div>
        {%- if settings.collection_page != blank or settings.artists_page != blank -%}
          <p class="gs-section-head__links">
            {%- if settings.collection_page != blank -%}
              <a class="gs-cta-link gs-cta-link--more" href="{{ settings.collection_page.url }}">{{ 'home.see_collection' | t }}</a>
            {%- endif -%}
            {%- if settings.artists_page != blank -%}
              <a class="gs-cta-link gs-cta-link--more" href="{{ settings.artists_page.url }}">{{ 'collection.artists_link' | t }}</a>
            {%- endif -%}
          </p>
        {%- endif -%}
      </div>
      <ul class="gs-grid gs-grid--artworks gs-rail" role="list">{{ tiles }}</ul>
    </div>
  </section>
{%- elsif request.design_mode -%}
  <p class="gs-editor-warning gs-container">Choose the featured works in Content, Metaobjects, Collection grouping, Featured works. The first three show here.</p>
{%- endif -%}

{% schema %}
{
  "name": "From the collection",
  "tag": "div",
  "enabled_on": {
    "templates": ["index"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows the first three featured works of the Permanent Collection. Change them in Content, Metaobjects, Collection grouping, Featured works."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "From the collection"
    }
  ],
  "presets": [
    {
      "name": "From the collection"
    }
  ]
}
{% endschema %}
