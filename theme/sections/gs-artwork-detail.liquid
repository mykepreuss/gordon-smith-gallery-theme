{%- comment -%}
  A limited edition (DESIGN.md §7.5, DS-05, DS-16): every image of the work whole on the mat;
  beside it the museum label from the product's artwork fields, medium, edition and size, the
  price, and one action. One template for every product: whether it's on sale yet comes from
  custom.coming_soon and custom.availability_note, and the framing offer from the linked frame
  (custom.featured_frame), so no product needs its own template (content model parts 3 and 6).

  The archive note and framing text are the same on every product, so they're settings here.

  Beside the work sits only what it takes to decide and buy: label, price, the action, the archive
  note and the framing offer. The description follows below at reading width, "About the work"
  (DESIGN.md §7.5), with any disclosures after it (DS-38).
{%- endcomment -%}
{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign f = product.metafields.custom
  assign coming_soon = false
  if f.coming_soon.value == true
    assign coming_soon = true
  endif
  assign frame = f.featured_frame.value
  assign form_id = 'gs-product-' | append: section.id
  # A limited edition has its label fields; a frame (or a product not yet migrated) doesn't, so it
  # gets no archive note and its text is headed Details.
  assign is_edition = false
  if f.artist.value != blank and f.artwork_title.value != blank
    assign is_edition = true
  endif
  # The images' alt when they have none of their own: the label in plain text ("Artist, Title,
  # year"), never the product title, whose italics are Unicode letters a screen reader spells out.
  # Each view is numbered when there is more than one.
  assign art_alt = product.title
  if is_edition
    assign art_alt = f.artist.value | append: ', ' | append: f.artwork_title.value
    if f.year.value != blank
      assign art_alt = art_alt | append: ', ' | append: f.year.value
    endif
  endif
  assign image_total = 0
  for media in product.media
    if media.media_type == 'image'
      assign image_total = image_total | plus: 1
    endif
  endfor
-%}
{%- comment -%}
  The first view, then the label, price and action, then the other views: below 990 px the action
  follows the work, however many views it has (DS-110). Each mat takes its view's shape (DS-111).
{%- endcomment -%}
{%- liquid
  assign image_number = 0
  assign lead_view = ''
  assign more_views = ''
-%}
{%- for media in product.media -%}
  {%- if media.media_type == 'image' -%}
    {%- liquid
      assign image_number = image_number | plus: 1
      assign this_alt = art_alt
      if image_total > 1
        assign view = 'products.view_of' | t: number: image_number, total: image_total
        assign this_alt = art_alt | append: '. ' | append: view
      endif
      assign art_ratio = media.preview_image.aspect_ratio
    -%}
    {%- if image_number == 1 -%}
      {%- capture lead_view -%}
        <div class="gs-artwork__lead"{% if art_ratio %} style="--gs-art-ratio: {{ art_ratio }}"{% endif %}>
          {%- render 'gs-media', image: media, preset: 'detail', priority: true, mode: 'artwork', shape: 'lg', alt: this_alt, title: product.title -%}
        </div>
      {%- endcapture -%}
    {%- else -%}
      {%- capture more_views -%}
        {{- more_views -}}
        <li{% if art_ratio %} style="--gs-art-ratio: {{ art_ratio }}"{% endif %}>
          {%- render 'gs-media', image: media, preset: 'detail', mode: 'artwork', shape: 'lg', alt: this_alt, title: product.title -%}
        </li>
      {%- endcapture -%}
    {%- endif -%}
  {%- endif -%}
{%- endfor -%}
<div class="gs-container--wide gs-container">
  <div class="gs-artwork{% if image_total == 0 %} gs-artwork--text{% endif %}">
    {{- lead_view -}}

    <div class="gs-artwork__info">
      <div class="gs-artwork__head">
        {%- comment -%} A way back to the Shop, as the work page has to the collection, labelled as the menu names it (DS-102). {%- endcomment -%}
        {%- if settings.shop_page != blank -%}
          <p class="gs-crumb"><a href="{{ settings.shop_page.url }}">{{ 'shop.crumb' | t }}</a></p>
        {%- endif -%}
        {%- render 'gs-artwork-label', product: product, tag: 'h1', link: true -%}
        {%- if f.medium.value != blank or f.edition.value != blank or f.dimensions.value != blank -%}
          <div class="gs-artwork__facts">
            {%- if f.medium.value != blank -%}<p class="gs-meta">{{ f.medium.value | escape }}</p>{%- endif -%}
            {%- if f.edition.value != blank -%}<p class="gs-meta">{{ f.edition.value | escape }}</p>{%- endif -%}
            {%- if f.dimensions.value != blank -%}<p class="gs-meta">{{ f.dimensions.value | escape }}</p>{%- endif -%}
          </div>
        {%- endif -%}
      </div>

      <p class="gs-price">
        {%- if coming_soon or product.available == false -%}
          {{- variant.price | money -}}
        {%- else -%}
          {%- render 'gs-price', product: product -%}
        {%- endif -%}
      </p>

      {%- form 'product', product, id: form_id, class: 'gs-form', data-gs-form: '' -%}
        {%- unless product.has_only_default_variant -%}
          {%- liquid
            # The select is named after the product's option, as the store calls it ("Colour"). A
            # product with more than one option gets the general word.
            assign option_label = 'products.option' | t
            if product.options.size == 1
              assign option_label = product.options.first
            endif
          -%}
          <div class="gs-field">
            <label class="gs-field__label" for="{{ form_id }}-variant">{{ option_label | escape }}</label>
            <span class="gs-select-wrap">
              <select class="gs-input gs-select" id="{{ form_id }}-variant" name="id">
                {%- for v in product.variants -%}
                  <option value="{{ v.id }}"{% if v.id == variant.id %} selected{% endif %}{% unless v.available %} disabled{% endunless %}>
                    {{- v.title | escape -}}{%- if product.price_varies -%}, {{ v.price | money }}{%- endif -%}
                    {%- unless v.available %} ({{ 'products.sold_out' | t }}){% endunless -%}
                  </option>
                {%- endfor -%}
              </select>
            </span>
          </div>
        {%- else -%}
          <input type="hidden" name="id" value="{{ variant.id }}">
        {%- endunless -%}

        {%- comment -%} Not on sale yet, or sold out: the reason sits beside the disabled button and describes it. {%- endcomment -%}
        {%- if coming_soon or product.available == false -%}
          <div class="gs-actions">
            <button class="gs-button" type="button" disabled aria-describedby="{{ form_id }}-why">{{ 'products.add_to_cart' | t }}</button>
            <p class="gs-note" id="{{ form_id }}-why">{%- render 'gs-price', product: product -%}</p>
          </div>
        {%- else -%}
          <button class="gs-button" type="submit" name="add" data-gs-busy-label="{{ 'products.adding' | t }}">{{ 'products.add_to_cart' | t }}</button>
        {%- endif -%}
      {%- endform -%}

      {%- if is_edition and section.settings.archive_note != blank -%}
        <div class="gs-prose gs-caption">{{ section.settings.archive_note }}</div>
      {%- endif -%}

      {%- if frame != blank -%}
        {%- assign frame_variant = frame.selected_or_first_available_variant -%}
        <section class="gs-panel gs-surface-tint" aria-labelledby="{{ form_id }}-frame">
          <h2 class="gs-h4" id="{{ form_id }}-frame">{{ 'products.frame_heading' | t }}</h2>
          {%- if section.settings.framing_text != blank -%}
            <div class="gs-prose">{{ section.settings.framing_text }}</div>
          {%- endif -%}
          <p><a class="gs-link" href="{{ frame.url }}">{{ frame.title | escape }}</a>, {{ frame.price | money }}</p>
          {%- if frame.available -%}
            {%- form 'product', frame, class: 'gs-form', data-gs-form: '' -%}
              <input type="hidden" name="id" value="{{ frame_variant.id }}">
              <button class="gs-button gs-button--secondary" type="submit" data-gs-busy-label="{{ 'products.adding_frame' | t }}">{{ 'products.add_frame' | t }}</button>
            {%- endform -%}
          {%- else -%}
            <p class="gs-note">{{ 'products.frame_sold_out' | t }}</p>
          {%- endif -%}
        </section>
      {%- endif -%}

    </div>

    {%- if more_views != blank -%}
      <ul class="gs-artwork__media">{{- more_views -}}</ul>
    {%- endif -%}

    {%- liquid
      assign disclosures = product.metafields.shopify.disclosure.value
      assign has_disclosures = false
      for disclosure in disclosures
        if disclosure.display_preferences.value.surfaces contains 'product_page'
          assign has_disclosures = true
        endif
      endfor
    -%}
    {%- if product.description != blank or has_disclosures -%}
    <section class="gs-artwork__about" aria-labelledby="{{ form_id }}-about">
      <h2 class="gs-label" id="{{ form_id }}-about">{% if is_edition %}{{ 'products.about_work' | t }}{% else %}{{ 'products.details' | t }}{% endif %}</h2>
      {%- if product.description != blank -%}
        <div class="gs-prose">{%- capture html -%}{{ product.description }}{%- endcapture -%}{%- render 'gs-rich-text', html: html -%}</div>
      {%- endif -%}
      {%- for disclosure in disclosures -%}
        {%- assign surfaces = disclosure.display_preferences.value.surfaces -%}
        {%- if surfaces contains 'product_page' -%}
          {%- liquid
            assign disclosure_title = disclosure.title.value
            if disclosure_title == blank
              assign disclosure_title = 'products.disclosure' | t
            endif
          -%}
          <details class="gs-disclosure">
            <summary>{{ disclosure_title | escape }}</summary>
            <div class="gs-disclosure__body gs-prose">{%- capture html -%}{{ disclosure.content | metafield_tag }}{%- endcapture -%}{%- render 'gs-rich-text', html: html -%}</div>
          </details>
        {%- endif -%}
      {%- endfor -%}
    </section>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Artwork",
  "tag": "section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "The label comes from each product's artwork fields (artist, title, year, medium, edition, dimensions). Not yet on sale: turn on Coming soon and fill Availability note on the product."
    },
    {
      "type": "richtext",
      "id": "archive_note",
      "label": "Note on every artwork",
      "default": "<p><em>The first edition is archived in the Artists For Kids and the Gordon Smith Gallery Permanent Collection</em></p>"
    },
    {
      "type": "richtext",
      "id": "framing_text",
      "label": "Framing text",
      "info": "Shown when the product has a linked frame.",
      "default": "<p>Museum-quality framing and service includes UV-protective glass and acid-free matting, keeping your fine art print vibrant and pristine for decades.<br/>Framing by Artrageous Pictures and Framing North Shore</p>"
    }
  ]
}
{% endschema %}
