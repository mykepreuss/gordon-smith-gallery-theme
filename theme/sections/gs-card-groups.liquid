{%- comment -%}
  The page's card groups (content model part 4, P-16): its own grids of cards, such as the three
  organisations on About or the ways to give on Donate. Staff add card groups to the page's Card
  groups field; this section shows them in order after the page text. A page without card groups
  shows nothing here.

  A group whose cards all have portrait images (a board, a staff list) shows as a grid of people:
  portrait frames, two to four across, smaller titles (DS-37). Staff don't choose it; the images do.
  A group of four or eight cards goes two, then four, across, so no card sits alone (DS-44).
  Any other count that would leave a short last row gives the spare room to its first cards
  (DS-52): five cards go two wider ones, then three, on wide screens; an odd count starts with one
  wide card, image beside text, where cards go two across.
  A group whose cards all have a logo (the three organisations on About Us) shows as rows, each
  logo beside its text (DS-50).
  A group without a heading has its card titles at H2, so no heading level is skipped after the
  page's H1. Each group can be linked to by its handle, e.g. /pages/donate#donate-ways-to-give, so a
  page's call to action can jump to it (DS-53).
{%- endcomment -%}
{%- assign groups = page.metafields.custom.card_groups.value -%}
{%- if groups != blank -%}
  <div class="gs-section gs-surface-paper">
    <div class="gs-container">
      {%- for group in groups -%}
        {%- liquid
          assign heading = group.heading.value
          assign card_heading = 'h2'
          if heading != blank
            assign card_heading = 'h3'
          endif
          assign portrait = true
          assign logos = true
          for card in group.cards.value
            assign ratio = card.image.value.aspect_ratio | default: 1
            if ratio >= 1
              assign portrait = false
            endif
            if card.logo.value == blank
              assign logos = false
            endif
          endfor
        -%}
        <section class="gs-card-group" id="{{ group.system.handle }}"{% if heading != blank %} aria-labelledby="{{ section.id }}-{{ forloop.index }}"{% endif %}>
          {%- if heading != blank -%}
            <div class="gs-section-head">
              <h2 class="gs-h2" id="{{ section.id }}-{{ forloop.index }}">{{ heading | escape }}</h2>
            </div>
          {%- endif -%}
          {%- liquid
            assign fours = false
            assign count = group.cards.value.size
            assign by_three = count | modulo: 3
            assign by_four = count | modulo: 4
            if by_four == 0 and by_three != 0
              assign fours = true
            endif
            assign lead = false
            if fours == false and by_three == 2
              assign lead = true
            endif
            assign by_two = count | modulo: 2
            assign odd = false
            if count > 1 and by_two == 1
              assign odd = true
            endif
          -%}
          <ul class="gs-grid {% if logos %}gs-grid--logos{% elsif portrait %}gs-grid--people{% else %}gs-grid--cards{% if fours %} gs-grid--fours{% endif %}{% if lead %} gs-grid--lead{% endif %}{% if odd %} gs-grid--odd{% endif %}{% endif %}">
            {%- for card in group.cards.value -%}
              <li>{%- render 'gs-card', card: card, heading: card_heading, portrait: portrait -%}</li>
            {%- endfor -%}
          </ul>
        </section>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Card groups",
  "tag": "section",
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows the page's Card groups field. Cards with an image show as image cards, cards without one as text cards. Cards with a logo show the logo as their heading; a group of them shows as rows."
    }
  ],
  "presets": [
    {
      "name": "Card groups"
    }
  ]
}
{% endschema %}
