{%- comment -%}
  An artist's documents (DESIGN.md §6.13, §7.5, DS-63): press, exhibition catalogues, books and
  photographs from the catalogue's archive, after the works, as tiles like the works: each cover
  whole on the mat, its title under it, as the catalogue showed them. The whole tile opens the
  document's file, and a PDF says so. A document whose file isn't uploaded yet (a PDF over 20 MB)
  shows its cover without a link. A document without a cover gets a plain mat with "PDF". The tile
  is snippets/gs-doc-tile, which a card group of documents uses too (DS-108).

  From the artist's Documents field: a list of Document entries (title, cover, file).
{%- endcomment -%}
{%- if metaobject.documents.value != blank -%}
  <section class="gs-section gs-surface-paper" aria-labelledby="{{ section.id }}-heading">
    <div class="gs-container">
      <div class="gs-section-head">
        <h2 class="gs-h2" id="{{ section.id }}-heading">{{ 'collection.documents' | t }}</h2>
      </div>
      <ul class="gs-grid gs-grid--artworks" role="list">
        {%- for doc in metaobject.documents.value -%}
          {%- liquid
            assign file = doc.file.value
            assign doc_url = ''
            if file != blank
              if file.media_type == 'image'
                assign doc_url = file | image_url
              else
                assign doc_url = file.url
              endif
            endif
          -%}
          <li>{%- render 'gs-doc-tile', title: doc.title.value, cover: doc.cover.value, url: doc_url -%}</li>
        {%- endfor -%}
      </ul>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Artist's documents",
  "tag": "div",
  "enabled_on": {
    "templates": ["metaobject"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "The Document entries in the artist's Documents field, as tiles with their covers."
    }
  ],
  "presets": [
    {
      "name": "Artist's documents"
    }
  ]
}
{% endschema %}
