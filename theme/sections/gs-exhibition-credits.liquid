{%- comment -%}
  An exhibition's credits (content model part 2): presenters, partners, sponsors and funders, with
  their links, then the funder logos a funder requires (such as the Canada Council for the Arts).
  Logos show as supplied, with no box or corner.
{%- endcomment -%}
{%- assign entry = metaobject -%}
{%- if entry.credits.value != blank or entry.funder_logos.value != blank -%}
  <section class="gs-section gs-surface-paper" aria-labelledby="{{ section.id }}-heading">
    <div class="gs-container">
      <div class="gs-section-head">
        <h2 class="gs-h4" id="{{ section.id }}-heading">{{ 'exhibitions.credits' | t }}</h2>
      </div>
      {%- if entry.credits.value != blank -%}
        <div class="gs-prose">{{ entry.credits | metafield_tag }}</div>
      {%- endif -%}
      {%- if entry.funder_logos.value != blank -%}
        <ul class="gs-logos">
          {%- for logo in entry.funder_logos.value -%}
            <li>{{ logo | image_url: height: 112 | image_tag: loading: 'lazy', alt: logo.alt }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Exhibition credits",
  "tag": "div",
  "enabled_on": {
    "templates": ["metaobject"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "From the exhibition entry: credits and funder logos. Give each logo alt text naming the funder."
    }
  ],
  "presets": [
    {
      "name": "Exhibition credits"
    }
  ]
}
{% endschema %}
