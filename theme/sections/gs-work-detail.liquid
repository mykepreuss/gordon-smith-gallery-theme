{%- comment -%}
  A work in the Permanent Collection (DESIGN.md §7.5, DS-62): the product page's layout (DS-38)
  without price or cart. Every image whole on the mat; beside it the museum label (artists linking
  to their pages, title in a <cite>, year) and the label's facts, one to a row under rules. The
  edition in the Shop, when this is the collection's copy of one, sits in a panel like the framing
  offer. "About the work" follows at reading width under both columns. Below 990 px the first view
  leads, then the label, then the other views (DS-110); from 990 px on a tall screen the label stays
  in view beside a long run of views (DS-112).

  The facts link out to where the work belongs: the exhibitions that showed it, the lessons it
  inspired (DS-181), and its category and themes when they have a page (a Collection grouping with
  the same handle).
{%- endcomment -%}
{%- liquid
  assign work = metaobject
  assign has_image = false
  for image in work.images.value limit: 1
    assign has_image = true
  endfor
  assign id = 'gs-work-' | append: section.id
-%}
<div class="gs-container--wide gs-container">
  <div class="gs-artwork{% unless has_image %} gs-artwork--text{% endunless %}"{% if has_image %} data-gs-lightbox{% endif %}>
    {%- if has_image -%}
      {%- comment -%} The larger view's caption: the label without its links (DS-140). {%- endcomment -%}
      <template data-gs-lightbox-caption>
        <p class="gs-lightbox__label">
          {%- if work.artists.value != blank -%}
            {%- capture names -%}{%- render 'gs-names', entries: work.artists.value -%}{%- endcapture -%}
            <span class="gs-artwork-label__artist">{{ names | strip | escape }}</span><span class="gs-visually-hidden">,</span>{{ ' ' }}
          {%- endif -%}
          <cite>{{ work.title.value | escape }}</cite>
          {%- if work.year.value != blank -%}, {{ work.year.value | escape }}{%- endif -%}
        </p>
      </template>
    {%- endif -%}
    {%- comment -%}
      The first view, then the label, then the other views: below 990 px the label follows the
      work, however many views it has (DS-110). Each mat takes its view's shape (DS-111).
    {%- endcomment -%}
    {%- for image in work.images.value limit: 1 -%}
      <div class="gs-artwork__lead"{% if image.aspect_ratio %} style="--gs-art-ratio: {{ image.aspect_ratio }}"{% endif %}>
        {%- render 'gs-media', image: image, preset: 'detail', priority: true, mode: 'artwork', shape: 'lg', enlarge: true -%}
      </div>
    {%- endfor -%}

    <div class="gs-artwork__info{% if has_image %} gs-artwork__info--follow{% endif %}">
      <div class="gs-artwork__head">
        {%- if settings.collection_page != blank -%}
          <p class="gs-crumb"><a href="{{ settings.collection_page.url }}">{{ settings.collection_page.title | escape }}</a></p>
        {%- endif -%}
        <h1 class="gs-artwork-label">
          {%- if work.artists.value != blank -%}
            <span class="gs-artwork-label__artist">
              {%- render 'gs-names', entries: work.artists.value, link: true -%}
            </span><span class="gs-visually-hidden">,</span>{{ ' ' }}
          {%- endif -%}
          <cite>{{ work.title.value | escape }}</cite>
          {%- if work.year.value != blank -%}, {{ work.year.value | escape }}{%- endif -%}
        </h1>
      </div>

      {%- liquid
        capture browse
          assign category_handle = work.category.value | handleize
          case work.category.value
            when 'Painting'
              assign category_handle = 'paintings'
            when 'Print'
              assign category_handle = 'prints'
            when 'Drawing'
              assign category_handle = 'drawings'
            when 'Photograph'
              assign category_handle = 'photography'
            when 'Sculpture'
              assign category_handle = 'sculptures'
            when 'Ceramic'
              assign category_handle = 'ceramics'
            when 'Textile'
              assign category_handle = 'textiles'
            when 'Book'
              assign category_handle = 'books'
          endcase
          assign links = ''
          if work.category.value != blank
            assign g = metaobjects['collection_group'][category_handle]
            if g != blank
              assign g_name = g.name.value | escape
              assign links = links | append: '<a class="gs-link" href="' | append: g.system.url | append: '">' | append: g_name | append: '</a>'
            else
              assign links = links | append: work.category.value
            endif
          endif
          for theme in work.themes.value
            assign theme_handle = theme | handleize
            assign g = metaobjects['collection_group'][theme_handle]
            if links != blank
              assign links = links | append: ', '
            endif
            if g != blank
              assign g_name = g.name.value | escape
              assign links = links | append: '<a class="gs-link" href="' | append: g.system.url | append: '">' | append: g_name | append: '</a>'
            else
              assign links = links | append: theme
            endif
          endfor
          echo links
        endcapture

        # The lessons this work inspired (DS-181): the lessons whose Works list names it, so a
        # lesson and its works link each other. Read inside a paginate tag (DS-152).
        assign lessons = ''
        paginate shop.metaobjects.lesson.values by 250
          for lesson in shop.metaobjects.lesson.values
            for w in lesson.works.value
              if w.system.id == work.system.id
                if lessons != blank
                  assign lessons = lessons | append: ', '
                endif
                assign lesson_title = lesson.title.value | escape
                assign lessons = lessons | append: '<a class="gs-link" href="' | append: lesson.system.url | append: '">' | append: lesson_title | append: '</a>'
                break
              endif
            endfor
          endfor
        endpaginate
      -%}
      <dl class="gs-details gs-details--stack">
        {%- if work.medium.value != blank -%}
          <div class="gs-details__item"><dt>{{ 'collection.medium' | t }}</dt><dd>{{ work.medium.value | escape }}</dd></div>
        {%- endif -%}
        {%- comment -%} Medium, edition, dimensions: the order of the product page and the tiles (DS-16, DS-93). {%- endcomment -%}
        {%- if work.edition.value != blank -%}
          <div class="gs-details__item"><dt>{{ 'collection.edition' | t }}</dt><dd>{{ work.edition.value | escape }}</dd></div>
        {%- endif -%}
        {%- if work.dimensions.value != blank -%}
          <div class="gs-details__item"><dt>{{ 'collection.dimensions' | t }}</dt><dd>{{ work.dimensions.value | escape }}</dd></div>
        {%- endif -%}
        {%- if work.credit_line.value != blank -%}
          <div class="gs-details__item"><dt>{{ 'collection.credit' | t }}</dt><dd>{{ work.credit_line.value | escape }}</dd></div>
        {%- endif -%}
        <div class="gs-details__item"><dt>{{ 'collection.accession' | t }}</dt><dd>{{ work.accession_number.value | escape }}</dd></div>
        {%- if work.shown_in.value != blank -%}
          <div class="gs-details__item">
            <dt>{{ 'collection.shown_in' | t }}</dt>
            <dd>
              {%- for entry in work.shown_in.value -%}
                {%- unless forloop.first %}, {% endunless -%}
                <a class="gs-link" href="{{ entry.system.url }}">{{ entry.title.value | escape }}</a>
              {%- endfor -%}
            </dd>
          </div>
        {%- endif -%}
        {%- if lessons != blank -%}
          <div class="gs-details__item"><dt>{{ 'collection.lessons' | t }}</dt><dd>{{ lessons }}</dd></div>
        {%- endif -%}
        {%- if browse != blank -%}
          <div class="gs-details__item"><dt>{{ 'collection.browse' | t }}</dt><dd>{{ browse }}</dd></div>
        {%- endif -%}
      </dl>

      {%- assign edition = work.in_the_shop.value -%}
      {%- if edition != blank -%}
        <section class="gs-panel gs-surface-tint" aria-labelledby="{{ id }}-shop">
          <h2 class="gs-h4" id="{{ id }}-shop">{{ 'collection.in_the_shop' | t }}</h2>
          <p>{{ 'collection.edition_for_sale' | t }}</p>
          <p><cite>{{ edition.metafields.custom.artwork_title.value | default: edition.title | escape }}</cite>, {% render 'gs-price', product: edition %}</p>
          {%- comment -%} The link names the edition for a screen reader's list of links and for engines, which read a link's words on their own (DS-185). {%- endcomment -%}
          <a class="gs-cta-link" href="{{ edition.url }}">{{ 'collection.see_edition' | t }}<span class="gs-visually-hidden">: {{ edition.metafields.custom.artwork_title.value | default: edition.title | escape }}</span></a>
        </section>
      {%- endif -%}
    </div>

    {%- if work.images.value.size > 1 -%}
      <ul class="gs-artwork__media">
        {%- for image in work.images.value offset: 1 -%}
          <li{% if image.aspect_ratio %} style="--gs-art-ratio: {{ image.aspect_ratio }}"{% endif %}>
            {%- render 'gs-media', image: image, preset: 'detail', mode: 'artwork', shape: 'lg', enlarge: true -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if work.about.value != blank -%}
      <section class="gs-artwork__about" aria-labelledby="{{ id }}-about">
        <h2 class="gs-label" id="{{ id }}-about">{{ 'products.about_work' | t }}</h2>
        <div class="gs-prose">{%- capture html -%}{{ work.about | metafield_tag }}{%- endcapture -%}{%- render 'gs-rich-text', html: html, link_names: true, names_only: true -%}</div>
      </section>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Work in the collection",
  "tag": "section",
  "enabled_on": {
    "templates": ["metaobject"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Everything here comes from the Artwork entry, in Content, Metaobjects."
    }
  ],
  "presets": [
    {
      "name": "Work in the collection"
    }
  ]
}
{% endschema %}
