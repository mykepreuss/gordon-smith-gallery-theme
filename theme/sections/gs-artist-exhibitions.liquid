{%- comment -%}
  The exhibitions at the gallery that included an artist (DESIGN.md §7.5, DS-62): compact
  exhibition cards from the artist's Exhibitions list, newest first.
{%- endcomment -%}
{%- if metaobject.exhibitions.value != blank -%}
  {%- liquid
    # How many cards, first: the count classes (DS-44, DS-52) set each card's picture size.
    assign count = 0
    for entry in metaobject.exhibitions.value
      assign count = count | plus: 1
    endfor
    capture mods
      render 'gs-grid-modifiers', count: count
    endcapture
    assign mods = mods | strip_newlines
    # Newest first: each entry's place in the list is keyed by its start date, then the keys are sorted.
    assign rows = ''
    for entry in metaobject.exhibitions.value
      assign rows = rows | append: entry.start_date.value | append: '~~at~~' | append: forloop.index0 | append: '~~row~~'
    endfor
    assign rows = rows | split: '~~row~~' | sort | reverse
  -%}
  <section class="gs-section gs-surface-paper" aria-labelledby="{{ section.id }}-heading">
    <div class="gs-container">
      <div class="gs-section-head">
        <h2 class="gs-h2" id="{{ section.id }}-heading">{{ 'collection.exhibitions_heading' | t }}</h2>
      </div>
      <ul class="gs-grid gs-grid--cards{{ mods }}" role="list">
        {%- for row in rows -%}
          {%- liquid
            assign at = row | split: '~~at~~' | last | plus: 0
            capture card_sizes
              render 'gs-grid-sizes', mods: mods, index: forloop.index
            endcapture
            assign card_sizes = card_sizes | strip
          -%}
          {%- for entry in metaobject.exhibitions.value -%}
            {%- if forloop.index0 == at -%}
              <li>{%- render 'gs-exhibition-card', entry: entry, compact: true, heading: 'h3', sizes: card_sizes -%}</li>
            {%- endif -%}
          {%- endfor -%}
        {%- endfor -%}
      </ul>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Artist's exhibitions",
  "tag": "div",
  "enabled_on": {
    "templates": ["metaobject"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "The exhibitions in the artist's Exhibitions list, newest first."
    }
  ],
  "presets": [
    {
      "name": "Artist's exhibitions"
    }
  ]
}
{% endschema %}
