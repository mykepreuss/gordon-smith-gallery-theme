{%- comment -%}
  Visit (DS-32): where the gallery is and when it's open, on the home page, with a link to the
  Plan your visit page. The address and hours are the same theme settings the footer and the
  contact page use (Gallery details), so they're typed once. Nothing shows without an address.

  With an image (the building), the photo sits beside the details, as the reference galleries
  show their locations, and the line under the heading says whether it's open today (DS-54).
{%- endcomment -%}
{%- assign visit = settings.visit_page -%}
{%- assign image = section.settings.image -%}
{%- if settings.address != blank -%}
  <section class="gs-section gs-surface-paper" aria-labelledby="{{ section.id }}-heading">
    <div class="gs-container gs-visit{% if image != blank %} gs-visit--media{% endif %}">
      {%- if image != blank -%}
        {%- render 'gs-media', image: image, preset: 'card', sizes: '(min-width: 990px) 50vw, 100vw', mode: 'photo', ratio: '4 / 3', shape: 'md', class: 'gs-visit__media' -%}
      {%- endif -%}
      {%- if image != blank -%}<div class="gs-visit__body">{%- endif -%}
      <div class="gs-visit__head">
        <h2 class="gs-h2" id="{{ section.id }}-heading">{{ section.settings.heading | escape }}</h2>
        {%- if image != blank -%}
          {%- render 'gs-open-today' -%}
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="gs-prose">{{ section.settings.text }}</div>
        {%- endif -%}
        {%- if visit != blank -%}
          <a class="gs-cta-link" href="{{ visit.url }}">{{ 'visit.plan_link' | t: title: visit.title }}</a>
        {%- endif -%}
      </div>
      <dl class="gs-details gs-visit__facts">
        <div class="gs-details__item">
          <dt>{{ 'visit.address' | t }}</dt>
          <dd><address>{{ settings.address | escape | newline_to_br }}</address></dd>
        </div>
        {%- if settings.hours != blank -%}
          <div class="gs-details__item">
            <dt>{{ 'visit.hours' | t }}</dt>
            <dd>{{ settings.hours | escape | newline_to_br }}</dd>
          </div>
        {%- elsif request.design_mode -%}
          <p class="gs-editor-warning">Add the opening hours in Theme settings, Gallery details.</p>
        {%- endif -%}
      </dl>
      {%- if image != blank -%}</div>{%- endif -%}
    </div>
  </section>
{%- elsif request.design_mode -%}
  <p class="gs-editor-warning gs-container">Add the address in Theme settings, Gallery details.</p>
{%- endif -%}

{% schema %}
{
  "name": "Visit",
  "tag": "div",
  "enabled_on": {
    "templates": ["index"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Address and opening hours come from Theme settings, Gallery details. The link goes to the Plan your visit page chosen there."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Optional. The building, beside the details. Set its focal point in Files."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Visit"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "info": "Optional. For example, admission or accessibility in one sentence."
    }
  ],
  "presets": [
    {
      "name": "Visit"
    }
  ]
}
{% endschema %}
