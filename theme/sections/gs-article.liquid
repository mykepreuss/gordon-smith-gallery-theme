{%- comment -%}
  One blog article: the page header with its date, the image, then the text in .gs-prose.
  Comments are not shown (the News blog is empty and has none).
{%- endcomment -%}
<div class="gs-container gs-lead-in">
  <header class="gs-page-head">
    <h1 class="gs-h1"{% render 'gs-fit', text: article.title %}>{{ article.title | escape }}</h1>
    <p class="gs-status__dates">{{ article.published_at | date: '%B %-d, %Y' }}</p>
  </header>
</div>
<div class="gs-section gs-surface-paper">
  <div class="gs-container">
    {%- if article.image != blank -%}
      {%- render 'gs-media', image: article.image, preset: 'full', mode: 'photo', shape: 'lg', ratio: '3 / 2', alt: article.title -%}
    {%- endif -%}
    <div class="gs-prose gs-article__body">{{ article.content }}</div>
  </div>
</div>

{% schema %}
{
  "name": "Article",
  "tag": "section",
  "enabled_on": {
    "templates": ["article"]
  },
  "settings": []
}
{% endschema %}
