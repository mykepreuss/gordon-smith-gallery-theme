{%- comment -%}
  Exhibition list (DESIGN.md §7.5, DS-15, DS-24, DS-25): cards built from exhibition entries,
  with status from their dates, so a list never needs editing when a show opens or closes.

  Which exhibitions depends on the page, never on a setting per page: on the On now, Upcoming and
  Past pages chosen in Theme settings, Exhibitions and events, what's on now; upcoming ones,
  soonest first; every past exhibition, newest first (DS-24, DS-25). These pages use the standard
  page template, which carries this section; on any other page it shows nothing (DS-48). So the
  lists don't depend on each page's template assignment. Home has What's on instead (DS-54).
  On now and Upcoming show each exhibition as a wide card, image beside its dates, title, curator
  and summary (DS-34): there are rarely more than two, and each deserves room. Past uses the grid
  of cards.
  An empty list says so and points somewhere useful (§6.12).
  The lists read the first 250 exhibition entries (DS-152). From 200 the theme editor says so on
  the Past page.
{%- endcomment -%}
{%- liquid
  assign order = 'asc'
  assign status = ''
  if page != blank
    if settings.exhibitions_past_page != blank and page.id == settings.exhibitions_past_page.id
      assign status = 'past'
      assign order = 'desc'
    elsif settings.exhibitions_upcoming_page != blank and page.id == settings.exhibitions_upcoming_page.id
      assign status = 'upcoming'
    elsif settings.exhibitions_on_now_page != blank and page.id == settings.exhibitions_on_now_page.id
      assign status = 'on-now'
    endif
  endif

  assign ids = ''
  if status != blank
    capture ids
      render 'gs-exhibition-index', status: status, order: order
    endcapture
  endif
  assign ids = ids | strip | split: ','
  assign wide = false
  if status != 'past'
    assign wide = true
  endif
  # Past uses the grid of cards, with the count classes (DS-44, DS-52).
  assign mods = ''
  if wide == false
    capture mods
      render 'gs-grid-modifiers', count: ids.size
    endcapture
    assign mods = mods | strip_newlines
  endif
-%}
{%- if status == blank -%}
  {%- comment -%} Not an exhibition list page: nothing to show. {%- endcomment -%}
{%- else -%}
  <section class="gs-section gs-surface-paper" aria-label="{{ 'exhibitions.list_label' | t }}">
    <div class="gs-container">
      {%- if ids.size > 0 -%}
        <ul class="gs-grid {% if wide %}gs-grid--features{% else %}gs-grid--cards{{ mods }}{% endif %}" role="list">
          {%- paginate shop.metaobjects.exhibition.values by 250 -%}
            {%- for id in ids -%}
              {%- liquid
                assign n = id | plus: 0
                capture card_sizes
                  render 'gs-grid-sizes', mods: mods, index: forloop.index
                endcapture
                assign card_sizes = card_sizes | strip
              -%}
              {%- for entry in shop.metaobjects.exhibition.values offset: n limit: 1 -%}
                <li>{%- render 'gs-exhibition-card', entry: entry, wide: wide, heading: 'h2', sizes: card_sizes -%}</li>
              {%- endfor -%}
            {%- endfor -%}
            {%- assign entries = paginate.items -%}
          {%- endpaginate -%}
        </ul>
        {%- if request.design_mode and status == 'past' and entries >= 200 -%}
          <p class="gs-editor-warning">There are {{ entries }} exhibition entries, and the lists read the first 250. Tell the site's developer before there are 250.</p>
        {%- endif -%}
      {%- else -%}
        {%- case status -%}
          {%- when 'on-now' -%}
            {%- assign empty_text = 'exhibitions.empty_on_now' | t -%}
            {%- assign empty_label = 'exhibitions.empty_on_now_link' | t -%}
            {%- render 'gs-empty', text: empty_text, link_url: settings.exhibitions_upcoming_page.url, link_label: empty_label -%}
          {%- when 'upcoming' -%}
            {%- assign empty_text = 'exhibitions.empty_upcoming' | t -%}
            {%- assign empty_label = 'exhibitions.empty_upcoming_link' | t -%}
            {%- render 'gs-empty', text: empty_text, link_url: settings.exhibitions_on_now_page.url, link_label: empty_label -%}
          {%- else -%}
            {%- assign empty_text = 'exhibitions.empty_past' | t -%}
            {%- assign empty_label = 'exhibitions.empty_past_link' | t -%}
            {%- render 'gs-empty', text: empty_text, link_url: settings.exhibitions_on_now_page.url, link_label: empty_label -%}
        {%- endcase -%}
      {%- endif -%}

    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Exhibition list",
  "tag": "div",
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Lists exhibition entries by their dates: on now, upcoming or past, depending on the page chosen in Theme settings, Exhibitions and events. On other pages it shows nothing."
    }
  ],
  "presets": [
    {
      "name": "Exhibition list"
    }
  ]
}
{% endschema %}
