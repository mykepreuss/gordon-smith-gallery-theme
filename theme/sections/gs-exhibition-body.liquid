{%- comment -%}
  About the exhibition (DESIGN.md §7.5, content model parts 2 and 5): the text, and the credits
  with funder logos, beside the facts (reception, events, curator, artists; gs-exhibition-facts).
  The summary is in the hero's box, so it's on the first screen (DS-66). On a phone the facts come
  first, so the reception time and the artists come before the long text. On wide screens they
  sit in a column beside it.

  The text is a rich text field, so page-builder markup and Word formatting from the old pages
  don't come across (TYPE-03). Funder logos show as supplied, with no box or corner.
{%- endcomment -%}
{%- liquid
  assign entry = metaobject
  capture facts
    render 'gs-exhibition-facts', entry: entry
  endcapture
  assign facts = facts | strip
  assign has_credits = false
  if entry.credits.value != blank or entry.funder_logos.value != blank
    assign has_credits = true
  endif
-%}
{%- if entry.body.value != blank or facts != blank or has_credits -%}
  <div class="gs-section gs-surface-paper">
    <div class="gs-container gs-about{% if facts == blank %} gs-about--no-facts{% endif %}">
      {%- if facts != blank -%}
        <aside class="gs-about__facts" aria-label="{{ 'exhibitions.details_label' | t }}">{{ facts }}</aside>
      {%- endif -%}

      {%- if entry.body.value != blank -%}
        <div class="gs-prose gs-about__body">{%- capture html -%}{{ entry.body | metafield_tag }}{%- endcapture -%}{%- render 'gs-rich-text', html: html -%}</div>
      {%- endif -%}

      {%- if has_credits -%}
        <section class="gs-about__credits" aria-labelledby="{{ section.id }}-credits">
          <h2 class="gs-label" id="{{ section.id }}-credits">{{ 'exhibitions.credits' | t }}</h2>
          {%- if entry.credits.value != blank -%}
            <div class="gs-prose">{%- capture html -%}{{ entry.credits | metafield_tag }}{%- endcapture -%}{%- render 'gs-rich-text', html: html -%}</div>
          {%- endif -%}
          {%- if entry.funder_logos.value != blank -%}
            <ul class="gs-logos">
              {%- for logo in entry.funder_logos.value -%}
                {%- comment -%} A logo without alt text is marked decorative: the credits beside it name the funder. {%- endcomment -%}
                {%- if logo.alt != blank -%}
                  <li>{{ logo | image_url: height: 112 | image_tag: loading: 'lazy', alt: logo.alt }}</li>
                {%- else -%}
                  <li>{{ logo | image_url: height: 112 | image_tag: loading: 'lazy' | replace_first: '<img ', '<img alt="" ' }}</li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </section>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "About the exhibition",
  "tag": "section",
  "enabled_on": {
    "templates": ["metaobject"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "From the exhibition entry: summary, text, credits and funder logos, beside the opening reception, events linked to the exhibition, curator, where in the building, and artists."
    }
  ],
  "presets": [
    {
      "name": "About the exhibition"
    }
  ]
}
{% endschema %}
