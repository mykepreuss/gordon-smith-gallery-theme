<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% render 'meta-tags' %}
    {% render 'gs-fonts' %}
    {{ 'gs-tokens.css' | asset_url | stylesheet_tag }}
    {{ 'gs-components.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'gs-nav.js' | asset_url }}" defer></script>
    <script src="{{ 'gs-forms.js' | asset_url }}" defer></script>
    <script src="{{ 'gs-open.js' | asset_url }}" defer></script>
    <script src="{{ 'gs-lightbox.js' | asset_url }}" defer></script>

    {{ content_for_header }}
  </head>

  {%- liquid
    # Programme colours (DESIGN.md §3.3): from the page's or the exhibition's programme field.
    capture brand
      render 'gs-brand'
    endcapture
    assign brand = brand | strip

    # A store policy has no template, so its page is laid out here, as a page (DS-177).
    assign policy = nil
    if request.page_type == 'policy'
      for p in shop.policies
        if p.url == request.path
          assign policy = p
        endif
      endfor
    endif
  -%}
  <body class="gs-type" data-gs-brand="{{ brand }}">
    <a class="gs-skip-link" href="#main">{{ 'general.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="main" class="gs-main" tabindex="-1">
      {%- if policy != blank -%}
        {%- render 'gs-policy', policy: policy -%}
      {%- else -%}
        {{ content_for_layout }}
      {%- endif -%}
    </main>

    {% sections 'footer-group' %}
    {%- render 'gs-lightbox' -%}
  </body>
</html>
