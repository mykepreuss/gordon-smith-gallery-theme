<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% render 'meta-tags' %}
    {% render 'gs-favicon' %}
    {% render 'gs-fonts' %}
    {{ 'gs-tokens.css' | asset_url | stylesheet_tag }}
    {{ 'gs-components.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'gs-forms.js' | asset_url }}" defer></script>

    {{ content_for_header }}
  </head>

  <body class="gs-type" data-gs-brand="gallery">
    <main id="main" class="gs-main">
      {{ content_for_layout }}
    </main>
  </body>
</html>
