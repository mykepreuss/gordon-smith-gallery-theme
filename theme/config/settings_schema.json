  {
    "name": "Exhibitions and events",
    "settings": [
      {
        "type": "paragraph",
        "content": "Exhibitions and events come from their entries in Content, Metaobjects. Their status follows their dates. These pages hold the lists."
      },
      {
        "type": "page",
        "id": "exhibitions_on_now_page",
        "label": "On now page",
        "info": "Shows the exhibitions on now, below its title, whatever template the page has."
      },
      {
        "type": "page",
        "id": "exhibitions_upcoming_page",
        "label": "Upcoming exhibitions page",
        "info": "Shows the upcoming exhibitions, soonest first, whatever template the page has."
      },
      {
        "type": "page",
        "id": "exhibitions_past_page",
        "label": "Past exhibitions page",
        "info": "Shows every past exhibition, newest first, whatever template the page has."
      },
      {
        "type": "page",
        "id": "events_page",
        "label": "Upcoming events page",
        "info": "This page lists every upcoming event. Other pages list only their own."
      },
      {
        "type": "text",
        "id": "collection_artists_label",
        "label": "Label for artists from the permanent collection",
        "default": "From the collection"
      }
    ]
  },
  {
    "name": "Artists for Kids",
    "settings": [
      {
        "type": "paragraph",
        "content": "The ArtReach videos are lesson entries (Content, Metaobjects, Lesson), each with its own page."
      },
      {
        "type": "page",
        "id": "lessons_page",
        "label": "ArtReach videos page",
        "info": "Lists every lesson, newest first. Lesson pages link back to it."
      },
      {
        "type": "textarea",
        "id": "lessons_note",
        "label": "Note under the videos",
        "info": "Shows under every lesson's video and at the end of the list of lessons."
      }
    ]
  },
  {
    "name": "Permanent Collection",
    "settings": [
      {
        "type": "paragraph",
        "content": "The collection's artists, works and groupings are entries (Content, Metaobjects: Artist, Artwork, Collection grouping). These pages link to them."
      },
      {
        "type": "page",
        "id": "collection_page",
        "label": "Permanent Collection page",
        "info": "Its search, ways in and featured works. Artist and work pages link back to it."
      },
      {
        "type": "page",
        "id": "artists_page",
        "label": "Artists page",
        "info": "Lists every artist entry, A to Z. Artist pages link back to it."
      }
    ]
  },
