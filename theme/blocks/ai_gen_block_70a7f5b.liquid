{% doc %}
  @prompt
    Create a new cart-page section called “Suggested frame” that recommends the corresponding frame product for products currently in the cart. Each artwork product stores its linked frame in the product reference metafield custom.featured_frame, labeled “Featured Frame.” For every cart line, read that metafield and collect the linked frame products, showing each unique suggested frame once. Do not show a recommendation if the frame is already in the cart. Display the frame’s image, title, price, and an Add to cart button. If more than one artwork is in the cart, show all unique corresponding frame recommendations. If no cart item has a linked frame, render nothing. Use the theme’s existing product-card and button styling where possible, make it responsive, and add settings for the section heading and introductory text. The section must work on the cart page and update its recommendations when the cart contents change.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% assign suggested_frames = '' | split: ',' %}
{% assign cart_product_ids = cart.items | map: 'product_id' %}
{% for line_item in cart.items %}
  {% assign frame = line_item.product.metafields.custom.featured_frame.value %}
  {% if frame != blank %}
    {% assign frame_id = frame.id | append: '' %}
    {% unless cart_product_ids contains frame.id or suggested_frames contains frame_id %}
      {% assign suggested_frames = suggested_frames | push: frame_id %}
      {% assign suggested_frame_objects = suggested_frame_objects | default: empty | push: frame %}
    {% endunless %}
  {% endif %}
{% endfor %}

{% if suggested_frame_objects != blank %}
  {% style %}
    .ai-suggested-frame-{{ ai_gen_id }} {
      display: block;
      width: 100%;
      max-width: 100%;
      padding: 32px 0;
      color: rgb(var(--color-foreground));
    }

    .ai-suggested-frame-{{ ai_gen_id }}__inner {
      width: {{ block.settings.desktop_width_percent }}%;
      max-width: 100%;
      margin: 0 auto;
    }

    .ai-suggested-frame-{{ ai_gen_id }}__heading {
      margin: 0 0 8px;
      font-size: 2rem;
      line-height: 1.2;
    }

    .ai-suggested-frame-{{ ai_gen_id }}__intro {
      margin: 0 0 24px;
      color: rgba(var(--color-foreground), .75);
      line-height: 1.5;
    }

    .ai-suggested-frame-{{ ai_gen_id }}__grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
      gap: 24px;
    }

    .ai-suggested-frame-{{ ai_gen_id }}__card {
      display: flex;
      flex-direction: column;
      min-width: 0;
    }

    .ai-suggested-frame-{{ ai_gen_id }}__image {
      display: block;
      width: 100%;
      aspect-ratio: 1 / 1;
      object-fit: cover;
      background: rgba(var(--color-foreground), .06);
    }

    .ai-suggested-frame-{{ ai_gen_id }}__content {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
      padding-top: 14px;
    }

    .ai-suggested-frame-{{ ai_gen_id }}__title {
      margin: 0;
      font-size: 1.05rem;
      line-height: 1.3;
    }

    .ai-suggested-frame-{{ ai_gen_id }}__price {
      margin: 0;
      font-size: .95rem;
    }

    .ai-suggested-frame-{{ ai_gen_id }}__button {
      width: 100%;
      min-height: 44px;
      margin-top: 4px;
      padding: 12px 18px;
      border: var(--buttons-border-width, 1px) solid rgb(var(--color-button));
      border-radius: var(--buttons-radius, 0px);
      background: rgb(var(--color-button));
      color: rgb(var(--color-button-text));
      cursor: pointer;
      font: inherit;
    }

    .ai-suggested-frame-{{ ai_gen_id }}__button:disabled {
      opacity: .6;
      cursor: wait;
    }

    @media screen and (max-width: 749px) {
      .ai-suggested-frame-{{ ai_gen_id }} {
        padding: 24px 0;
      }

      .ai-suggested-frame-{{ ai_gen_id }}__inner {
        width: 100%;
      }

      .ai-suggested-frame-{{ ai_gen_id }}__grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 16px;
      }
    }
  {% endstyle %}

  <cart-suggested-frame-{{ ai_gen_id }}
    class="ai-suggested-frame-{{ ai_gen_id }}"
    data-section-id="{{ section.id }}"
    {{ block.shopify_attributes }}
  >
    <div class="ai-suggested-frame-{{ ai_gen_id }}__inner">
      {% if block.settings.heading != blank %}<h2 class="ai-suggested-frame-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>{% endif %}
      {% if block.settings.intro != blank %}<p class="ai-suggested-frame-{{ ai_gen_id }}__intro">{{ block.settings.intro | escape }}</p>{% endif %}
      <div class="ai-suggested-frame-{{ ai_gen_id }}__grid">
        {% for frame in suggested_frame_objects %}
          <article class="ai-suggested-frame-{{ ai_gen_id }}__card">
            {% if frame.featured_image %}
              {{ frame.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', class: 'ai-suggested-frame-' | append: ai_gen_id | append: '__image', alt: frame.featured_image.alt | default: frame.title | escape }}
            {% else %}
              <div class="ai-suggested-frame-{{ ai_gen_id }}__image">{{ 'product-apparel-1' | placeholder_svg_tag }}</div>
            {% endif %}
            <div class="ai-suggested-frame-{{ ai_gen_id }}__content">
              <h3 class="ai-suggested-frame-{{ ai_gen_id }}__title">{{ frame.title | escape }}</h3>
              <p class="ai-suggested-frame-{{ ai_gen_id }}__price">{{ frame.price | money }}</p>
              <button type="button" class="ai-suggested-frame-{{ ai_gen_id }}__button" data-variant-id="{{ frame.selected_or_first_available_variant.id }}" {% unless frame.available %}disabled{% endunless %}>{% if frame.available %}Add to cart{% else %}Sold out{% endif %}</button>
            </div>
          </article>
        {% endfor %}
      </div>
    </div>
  </cart-suggested-frame-{{ ai_gen_id }}>

  <script>
    (function() {
      class CartSuggestedFrame{{ ai_gen_id }} extends HTMLElement {
        connectedCallback() {
          this.bindButtons();
          this.refresh = this.refresh.bind(this);
          document.addEventListener('cart:updated', this.refresh);
          document.addEventListener('cart-update', this.refresh);
        }
        disconnectedCallback() {
          document.removeEventListener('cart:updated', this.refresh);
          document.removeEventListener('cart-update', this.refresh);
        }
        bindButtons() {
          this.querySelectorAll('[data-variant-id]').forEach((button) => {
            button.addEventListener('click', async () => {
              button.disabled = true;
              try {
                const response = await fetch(window.Shopify.routes.root + 'cart/add.js', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ items: [{ id: Number(button.dataset.variantId), quantity: 1 }] }) });
                if (!response.ok) throw new Error();
                document.dispatchEvent(new CustomEvent('cart:updated'));
                this.refresh();
              } catch (error) {
                button.disabled = false;
              }
            });
          });
        }
        async refresh() {
          const response = await fetch(window.location.pathname + '?section_id=' + encodeURIComponent(this.dataset.sectionId));
          if (!response.ok) return;
          const html = await response.text();
          const replacement = new DOMParser().parseFromString(html, 'text/html').querySelector('cart-suggested-frame-{{ ai_gen_id }}');
          if (replacement) this.replaceWith(replacement);
        }
      }
      customElements.define('cart-suggested-frame-{{ ai_gen_id }}', CartSuggestedFrame{{ ai_gen_id }});
    })();
  </script>
{% endif %}

{% schema %}
{
  "name": "Suggested frame",
  "settings": [
    {"type":"text","id":"heading","label":"Heading","default":"Complete your artwork"},
    {"type":"textarea","id":"intro","label":"Introductory text","default":"Add a frame selected to complement your artwork."},
    {"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100}
  ],
  "presets": [{"name":"Suggested frame"}],
  "tag": null,
  "class": "suggested-frame-section"
}
{% endschema %}