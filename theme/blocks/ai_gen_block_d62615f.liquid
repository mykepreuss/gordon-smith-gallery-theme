{% doc %}
  @prompt
    Create a cart page section that appears below the cart items. For each item in the cart, check if its product has a metafield called "featured_product" (namespace: custom, key: featured_product) that references another product. If it does, display a suggestion card for that featured product showing its image, title, price, and an "Add to cart" button (using AJAX so the page doesn't reload). Each suggestion should be visually linked to the cart item it corresponds to (e.g., "Pair with [cart item title]"). Skip duplicates if multiple cart items reference the same featured product. Style it to match a minimal, gallery-quality aesthetic.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% assign featured_ids = '' %}

{% style %}
  .ai-cart-featured-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 48px auto 0;
    color: {{ block.settings.text_color }};
  }

  .ai-cart-featured-{{ ai_gen_id }}__heading {
    margin: 0 0 24px;
    font-size: 24px;
    line-height: 1.2;
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  .ai-cart-featured-{{ ai_gen_id }}__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }

  .ai-cart-featured-{{ ai_gen_id }}__card {
    border: 1px solid {{ block.settings.border_color }};
    background: {{ block.settings.card_background }};
    padding: 12px;
  }

  .ai-cart-featured-{{ ai_gen_id }}__image-link {
    display: block;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: #f2f2f0;
  }

  .ai-cart-featured-{{ ai_gen_id }}__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-cart-featured-{{ ai_gen_id }}__content {
    padding: 16px 4px 4px;
  }

  .ai-cart-featured-{{ ai_gen_id }}__pairing {
    margin: 0 0 8px;
    color: {{ block.settings.muted_color }};
    font-size: 12px;
    line-height: 1.4;
  }

  .ai-cart-featured-{{ ai_gen_id }}__title {
    display: block;
    margin: 0 0 8px;
    color: {{ block.settings.text_color }};
    font-size: 16px;
    line-height: 1.3;
    text-decoration: none;
  }

  .ai-cart-featured-{{ ai_gen_id }}__title:hover,
  .ai-cart-featured-{{ ai_gen_id }}__title:focus-visible {
    text-decoration: underline;
  }

  .ai-cart-featured-{{ ai_gen_id }}__price {
    margin: 0 0 16px;
    font-size: 14px;
  }

  .ai-cart-featured-{{ ai_gen_id }}__button {
    width: 100%;
    min-height: 44px;
    padding: 11px 16px;
    border: 1px solid {{ block.settings.button_color }};
    border-radius: 0;
    background: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    font: inherit;
    font-size: 13px;
    cursor: pointer;
  }

  .ai-cart-featured-{{ ai_gen_id }}__button:hover,
  .ai-cart-featured-{{ ai_gen_id }}__button:focus-visible {
    opacity: 0.86;
  }

  .ai-cart-featured-{{ ai_gen_id }}__button[disabled] {
    cursor: wait;
    opacity: 0.6;
  }

  @media screen and (max-width: 749px) {
    .ai-cart-featured-{{ ai_gen_id }} {
      margin-top: 32px;
    }

    .ai-cart-featured-{{ ai_gen_id }}__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
    }
  }

  @media screen and (max-width: 480px) {
    .ai-cart-featured-{{ ai_gen_id }}__grid {
      grid-template-columns: 1fr;
    }
  }
{% endstyle %}

<cart-featured-products-{{ ai_gen_id }}
  class="ai-cart-featured-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  {% assign has_suggestions = false %}
  {% for item in cart.items %}
    {% assign featured_product = item.product.metafields.custom.featured_product.value %}
    {% if featured_product != blank %}
      {% assign featured_key = featured_product.id | append: '' %}
      {% unless featured_ids contains featured_key %}
        {% assign has_suggestions = true %}
        {% assign featured_ids = featured_ids | append: featured_key | append: ',' %}
      {% endunless %}
    {% endif %}
  {% endfor %}

  {% if has_suggestions %}
    <h2 class="ai-cart-featured-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>
    <div class="ai-cart-featured-{{ ai_gen_id }}__grid">
      {% assign rendered_ids = '' %}
      {% for item in cart.items %}
        {% assign featured_product = item.product.metafields.custom.featured_product.value %}
        {% if featured_product != blank %}
          {% assign featured_key = featured_product.id | append: '' %}
          {% unless rendered_ids contains featured_key %}
            {% assign rendered_ids = rendered_ids | append: featured_key | append: ',' %}
            {% assign featured_variant = featured_product.selected_or_first_available_variant %}
            <article class="ai-cart-featured-{{ ai_gen_id }}__card">
              <a class="ai-cart-featured-{{ ai_gen_id }}__image-link" href="{{ featured_product.url }}" aria-label="View {{ featured_product.title | escape }}">
                {% if featured_product.featured_image %}
                  <img class="ai-cart-featured-{{ ai_gen_id }}__image" src="{{ featured_product.featured_image | image_url: width: 700 }}" alt="{{ featured_product.featured_image.alt | default: featured_product.title | escape }}" width="700" height="700" loading="lazy">
                {% else %}
                  <div class="ai-cart-featured-{{ ai_gen_id }}__image">{{ 'product-apparel-1' | placeholder_svg_tag }}</div>
                {% endif %}
              </a>
              <div class="ai-cart-featured-{{ ai_gen_id }}__content">
                <p class="ai-cart-featured-{{ ai_gen_id }}__pairing">Pair with {{ item.product.title | escape }}</p>
                <a class="ai-cart-featured-{{ ai_gen_id }}__title" href="{{ featured_product.url }}">{{ featured_product.title | escape }}</a>
                <p class="ai-cart-featured-{{ ai_gen_id }}__price">{{ featured_product.price | money }}</p>
                <button class="ai-cart-featured-{{ ai_gen_id }}__button" type="button" data-variant-id="{{ featured_variant.id }}" {% unless featured_product.available %}disabled{% endunless %}>
                  {% if featured_product.available %}{{ block.settings.button_label | escape }}{% else %}Sold out{% endif %}
                </button>
              </div>
            </article>
          {% endunless %}
        {% endif %}
      {% endfor %}
    </div>
  {% endif %}
</cart-featured-products-{{ ai_gen_id }}>

<script>
  (function() {
    class CartFeaturedProducts{{ ai_gen_id }} extends HTMLElement {
      connectedCallback() {
        this.querySelectorAll('[data-variant-id]').forEach((button) => {
          button.addEventListener('click', () => this.addProduct(button));
        });
      }

      addProduct(button) {
        button.disabled = true;
        fetch(window.Shopify.routes.root + 'cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({ items: [{ id: Number(button.dataset.variantId), quantity: 1 }] })
        })
        .then((response) => {
          if (!response.ok) throw new Error('Unable to add product');
          return response.json();
        })
        .then(() => {
          document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));
          button.textContent = 'Added';
        })
        .catch(() => {
          button.disabled = false;
          button.textContent = 'Try again';
        });
      }
    }

    customElements.define('cart-featured-products-{{ ai_gen_id }}', CartFeaturedProducts{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Cart featured products",
  "tag": null,
  "class": "cart-featured-products-block",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Complete your collection"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Add to cart"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#465A5E"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Secondary text",
      "default": "#5B757A"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border",
      "default": "#CDD7DB"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button",
      "default": "#5B757A"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "Cart featured products"
    }
  ]
}
{% endschema %}