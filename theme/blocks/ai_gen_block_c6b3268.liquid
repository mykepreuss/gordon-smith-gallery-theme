{% doc %}
  @prompt
    Create a cart page section that appears below the cart items. For each item in the cart, check if its product has a metafield called "featured_product" (namespace: custom, key: featured_product) that references another product. If it does, display a suggestion card for that featured product showing its image, title, price, and an "Add to cart" button (using AJAX so the page doesn't reload). Each suggestion should be visually linked to the cart item it corresponds to (e.g., "Pair with [cart item title]"). Skip duplicates if multiple cart items reference the same featured product. Style it to match a minimal, gallery-quality aesthetic.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% assign featured_ids = '' %}
{% assign has_suggestions = false %}

{% style %}
  .ai-cart-featured-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 40px auto 0;
    color: #465a5e;
  }

  .ai-cart-featured__heading-{{ ai_gen_id }} {
    margin: 0 0 20px;
    color: #465a5e;
    font-family: {{ settings.type_header_font.family }}, sans-serif;
    font-size: 28px;
    font-weight: 400;
    line-height: 1.2;
  }

  .ai-cart-featured__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .ai-cart-featured__card-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 120px minmax(0, 1fr);
    gap: 18px;
    align-items: center;
    padding: 14px;
    background: #ebede3;
    border: 1px solid rgba(70, 90, 94, 0.18);
  }

  .ai-cart-featured__image-{{ ai_gen_id }} {
    display: block;
    width: 120px;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    background: #ffffff;
  }

  .ai-cart-featured__details-{{ ai_gen_id }} {
    min-width: 0;
  }

  .ai-cart-featured__context-{{ ai_gen_id }} {
    margin: 0 0 7px;
    color: #5b757a;
    font-size: 12px;
    letter-spacing: 0.04em;
    line-height: 1.4;
  }

  .ai-cart-featured__title-{{ ai_gen_id }} {
    display: block;
    margin: 0 0 8px;
    color: #465a5e;
    font-family: {{ settings.type_header_font.family }}, sans-serif;
    font-size: 18px;
    font-weight: 400;
    line-height: 1.25;
    text-decoration: none;
  }

  .ai-cart-featured__price-{{ ai_gen_id }} {
    margin-bottom: 14px;
    color: #465a5e;
    font-size: 15px;
  }

  .ai-cart-featured__button-{{ ai_gen_id }} {
    min-height: 42px;
    padding: 10px 16px;
    border: 1px solid #465a5e;
    border-radius: {{ settings.buttons_radius }}px;
    background: #465a5e;
    color: #ffffff;
    cursor: pointer;
    font: inherit;
    font-size: 13px;
    line-height: 1.2;
  }

  .ai-cart-featured__button-{{ ai_gen_id }}:hover,
  .ai-cart-featured__button-{{ ai_gen_id }}:focus-visible {
    background: #5b757a;
  }

  .ai-cart-featured__button-{{ ai_gen_id }}:focus-visible,
  .ai-cart-featured__title-{{ ai_gen_id }}:focus-visible {
    outline: 2px solid #ef7e46;
    outline-offset: 3px;
  }

  @media screen and (max-width: 749px) {
    .ai-cart-featured__grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }

    .ai-cart-featured__card-{{ ai_gen_id }} {
      grid-template-columns: 96px minmax(0, 1fr);
    }

    .ai-cart-featured__image-{{ ai_gen_id }} {
      width: 96px;
    }
  }
{% endstyle %}

<cart-featured-products-{{ ai_gen_id }}
  class="ai-cart-featured-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  {% for item in cart.items %}
    {% assign featured_product = item.product.metafields.custom.featured_product.value %}
    {% if featured_product != blank %}
      {% assign featured_id_string = featured_product.id | append: ',' %}
      {% unless featured_ids contains featured_id_string %}
        {% assign featured_ids = featured_ids | append: featured_id_string %}
        {% assign has_suggestions = true %}
      {% endunless %}
    {% endif %}
  {% endfor %}

  {% if has_suggestions %}
    <h2 class="ai-cart-featured__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    <div class="ai-cart-featured__grid-{{ ai_gen_id }}">
      {% assign rendered_ids = '' %}
      {% for item in cart.items %}
        {% assign featured_product = item.product.metafields.custom.featured_product.value %}
        {% if featured_product != blank %}
          {% assign featured_id_string = featured_product.id | append: ',' %}
          {% unless rendered_ids contains featured_id_string %}
            {% assign rendered_ids = rendered_ids | append: featured_id_string %}
            <article class="ai-cart-featured__card-{{ ai_gen_id }}" data-featured-card data-product-id="{{ featured_product.id }}">
              {% if featured_product.featured_image %}
                <img
                  class="ai-cart-featured__image-{{ ai_gen_id }}"
                  src="{{ featured_product.featured_image | image_url: width: 360 }}"
                  alt="{{ featured_product.featured_image.alt | default: featured_product.title | escape }}"
                  width="360"
                  height="360"
                  loading="lazy"
                >
              {% else %}
                <div class="ai-cart-featured__image-{{ ai_gen_id }}">
                  {{ 'product-apparel-1' | placeholder_svg_tag }}
                </div>
              {% endif %}
              <div class="ai-cart-featured__details-{{ ai_gen_id }}">
                <p class="ai-cart-featured__context-{{ ai_gen_id }}">Pair with {{ item.product.title | escape }}</p>
                <a class="ai-cart-featured__title-{{ ai_gen_id }}" href="{{ featured_product.url }}">{{ featured_product.title }}</a>
                <div class="ai-cart-featured__price-{{ ai_gen_id }}">{{ featured_product.price | money }}</div>
                <button
                  class="ai-cart-featured__button-{{ ai_gen_id }}"
                  type="button"
                  data-add-featured
                  data-variant-id="{{ featured_product.selected_or_first_available_variant.id }}"
                  {% unless featured_product.available %}disabled{% endunless %}
                >
                  {% if featured_product.available %}{{ block.settings.button_label }}{% else %}Unavailable{% endif %}
                </button>
              </div>
            </article>
          {% endunless %}
        {% endif %}
      {% endfor %}
    </div>
  {% endif %}
</cart-featured-products-{{ ai_gen_id }}>

<script>
  (function() {
    class CartFeaturedProducts{{ ai_gen_id }} extends HTMLElement {
      connectedCallback() {
        this.querySelectorAll('[data-add-featured]').forEach((button) => {
          button.addEventListener('click', () => this.addProduct(button));
        });
      }

      async addProduct(button) {
        const variantId = button.dataset.variantId;
        if (!variantId || button.disabled) return;
        const originalLabel = button.textContent;
        button.disabled = true;
        button.textContent = 'Adding…';
        try {
          const response = await fetch(window.Shopify.routes.root + 'cart/add.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({ items: [{ id: Number(variantId), quantity: 1 }] })
          });
          if (!response.ok) throw new Error('Unable to add product');
          button.textContent = 'Added';
          document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));
          document.dispatchEvent(new CustomEvent('cart:update', { bubbles: true }));
        } catch (error) {
          button.textContent = 'Try again';
        } finally {
          setTimeout(() => {
            button.disabled = false;
            button.textContent = originalLabel;
          }, 1800);
        }
      }
    }
    if (!customElements.get('cart-featured-products-{{ ai_gen_id }}')) {
      customElements.define('cart-featured-products-{{ ai_gen_id }}', CartFeaturedProducts{{ ai_gen_id }});
    }
  })();
</script>

{% schema %}
{
  "name": "Cart featured products",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You may also like"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Add to cart"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "Cart featured products"
    }
  ],
  "tag": null,
  "class": "cart-featured-products-block"
}
{% endschema %}