{% doc %}
  @prompt
    Create a rotating image banner slideshow section that supports up to 15 slides. Each slide should have its own background image, heading, and subheading that can be edited individually in the theme editor. The banner should auto-rotate through slides with a smooth transition. Remove any white rectangle or background box behind the heading text — the text should display directly over the image with no opaque background panel. Keep the heading area layout and typography the same as the existing image banner section. Make the image/heading clickable to a link to a page or url
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-rotating-banner-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    display: block;
  }

  .ai-rotating-banner__slides-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: {{ block.settings.banner_height_desktop }}px;
  }

  .ai-rotating-banner__slide-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity {{ block.settings.transition_speed }}s ease-in-out;
    pointer-events: none;
  }

  .ai-rotating-banner__slide-{{ ai_gen_id }}.active {
    opacity: 1;
    pointer-events: auto;
  }

  .ai-rotating-banner__slide-link-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    height: 100%;
    position: relative;
    text-decoration: none;
  }

  .ai-rotating-banner__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-rotating-banner__placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-rotating-banner__placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
  }

  .ai-rotating-banner__content-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
    width: 90%;
    max-width: 800px;
    z-index: 2;
  }

  .ai-rotating-banner__heading-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    margin: 0 0 16px;
    font-weight: 600;
    line-height: 1.2;
  }

  .ai-rotating-banner__subheading-{{ ai_gen_id }} {
    color: {{ block.settings.subheading_color }};
    font-size: {{ block.settings.subheading_size }}px;
    margin: 0;
    line-height: 1.4;
  }

  .ai-rotating-banner__controls-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 10px;
    z-index: 3;
  }

  .ai-rotating-banner__dot-{{ ai_gen_id }} {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background-color: {{ block.settings.dot_color }};
    opacity: 0.5;
    border: none;
    cursor: pointer;
    padding: 0;
    transition: opacity 0.3s ease;
  }

  .ai-rotating-banner__dot-{{ ai_gen_id }}.active {
    opacity: 1;
  }

  .ai-rotating-banner__dot-{{ ai_gen_id }}:hover {
    opacity: 0.8;
  }

  @media screen and (max-width: 749px) {
    .ai-rotating-banner__slides-{{ ai_gen_id }} {
      height: {{ block.settings.banner_height_mobile }}px;
    }

    .ai-rotating-banner__heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.6);
    }

    .ai-rotating-banner__subheading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.subheading_size }}px * 0.7);
    }
  }
{% endstyle %}

<rotating-banner-{{ ai_gen_id }}
  class="ai-rotating-banner-{{ ai_gen_id }}"
  data-autoplay="{{ block.settings.autoplay }}"
  data-interval="{{ block.settings.autoplay_interval }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-rotating-banner__slides-{{ ai_gen_id }}">
    {% for i in (1..15) %}
      {% liquid
        assign slide_enabled_key = 'slide_' | append: i | append: '_enabled'
        assign slide_image_key = 'slide_' | append: i | append: '_image'
        assign slide_heading_key = 'slide_' | append: i | append: '_heading'
        assign slide_subheading_key = 'slide_' | append: i | append: '_subheading'
        assign slide_link_key = 'slide_' | append: i | append: '_link'

        assign slide_enabled = block.settings[slide_enabled_key]
        assign slide_image = block.settings[slide_image_key]
        assign slide_heading = block.settings[slide_heading_key]
        assign slide_subheading = block.settings[slide_subheading_key]
        assign slide_link = block.settings[slide_link_key]
      %}

      {% if slide_enabled %}
        <div
          class="ai-rotating-banner__slide-{{ ai_gen_id }} {% if forloop.first %}active{% endif %}"
          data-slide-index="{{ forloop.index }}"
        >
          {% if slide_link != blank %}
            <a href="{{ slide_link }}" class="ai-rotating-banner__slide-link-{{ ai_gen_id }}">
          {% else %}
            <div class="ai-rotating-banner__slide-link-{{ ai_gen_id }}">
          {% endif %}

            {% if slide_image %}
              <img
                src="{{ slide_image | image_url: width: 2000 }}"
                alt="{{ slide_image.alt | escape }}"
                loading="lazy"
                width="{{ slide_image.width }}"
                height="{{ slide_image.height }}"
                class="ai-rotating-banner__image-{{ ai_gen_id }}"
              >
            {% else %}
              <div class="ai-rotating-banner__placeholder-{{ ai_gen_id }}">
                {{ 'hero-apparel-1' | placeholder_svg_tag }}
              </div>
            {% endif %}

            {% if slide_heading != blank or slide_subheading != blank %}
              <div class="ai-rotating-banner__content-{{ ai_gen_id }}">
                {% if slide_heading != blank %}
                  <h2 class="ai-rotating-banner__heading-{{ ai_gen_id }}">{{ slide_heading }}</h2>
                {% endif %}
                {% if slide_subheading != blank %}
                  <p class="ai-rotating-banner__subheading-{{ ai_gen_id }}">{{ slide_subheading }}</p>
                {% endif %}
              </div>
            {% endif %}

          {% if slide_link != blank %}
            </a>
          {% else %}
            </div>
          {% endif %}
        </div>
      {% endif %}
    {% endfor %}
  </div>

  <div class="ai-rotating-banner__controls-{{ ai_gen_id }}">
    {% for i in (1..15) %}
      {% liquid
        assign slide_enabled_key = 'slide_' | append: i | append: '_enabled'
        assign slide_enabled = block.settings[slide_enabled_key]
      %}
      {% if slide_enabled %}
        <button
          class="ai-rotating-banner__dot-{{ ai_gen_id }} {% if forloop.first %}active{% endif %}"
          data-slide-index="{{ forloop.index }}"
          aria-label="Go to slide {{ forloop.index }}"
        ></button>
      {% endif %}
    {% endfor %}
  </div>
</rotating-banner-{{ ai_gen_id }}>

<script>
  (function() {
    class RotatingBanner{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentSlide = 0;
        this.autoplayTimer = null;
      }

      connectedCallback() {
        this.slides = this.querySelectorAll('.ai-rotating-banner__slide-{{ ai_gen_id }}');
        this.dots = this.querySelectorAll('.ai-rotating-banner__dot-{{ ai_gen_id }}');
        this.autoplay = this.dataset.autoplay === 'true';
        this.interval = parseInt(this.dataset.interval) * 1000;

        if (this.slides.length === 0) return;

        this.setupEventListeners();

        if (this.autoplay && this.slides.length > 1) {
          this.startAutoplay();
        }
      }

      setupEventListeners() {
        this.dots.forEach((dot, index) => {
          dot.addEventListener('click', () => {
            this.goToSlide(index);
            if (this.autoplay) {
              this.resetAutoplay();
            }
          });
        });
      }

      goToSlide(index) {
        this.slides[this.currentSlide].classList.remove('active');
        this.dots[this.currentSlide].classList.remove('active');

        this.currentSlide = index;

        this.slides[this.currentSlide].classList.add('active');
        this.dots[this.currentSlide].classList.add('active');
      }

      nextSlide() {
        const nextIndex = (this.currentSlide + 1) % this.slides.length;
        this.goToSlide(nextIndex);
      }

      startAutoplay() {
        this.autoplayTimer = setInterval(() => {
          this.nextSlide();
        }, this.interval);
      }

      resetAutoplay() {
        clearInterval(this.autoplayTimer);
        this.startAutoplay();
      }

      disconnectedCallback() {
        if (this.autoplayTimer) {
          clearInterval(this.autoplayTimer);
        }
      }
    }

    customElements.define('rotating-banner-{{ ai_gen_id }}', RotatingBanner{{ ai_gen_id }});
  })();
</script>

