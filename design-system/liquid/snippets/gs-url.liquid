{%- comment -%}
  gs-url: normalise a menu link's destination and classify it (DESIGN.md §6.1).
  Draft reference: untested until the theme is pulled.

  Output is "<href>|<external>" where external is 1 or 0. Use it like this:
    {%- capture r -%}{%- render 'gs-url', link: link -%}{%- endcapture -%}
    {%- assign r = r | strip | split: '|' -%}   r[0] = href, r[1] = '1' or '0'

  Rules
  - An absolute URL that points at this store (primary domain, with or without www,
    the myshopify domain, or the current host) becomes a relative path. The live menu's
    "https://ed35ee-ea.myshopify.com/collections/2025-fall-portfolio" becomes
    "/collections/2025-fall-portfolio" and stops sending visitors to the myshopify domain.
  - Any other absolute URL is external and gets the external cue.
  - A blank URL or "#" means "no destination" and comes back as "#".
{%- endcomment -%}
{%- liquid
  assign href = link.url | default: '#'
  assign external = '0'
  if href contains '://'
    assign bare = href | split: '://' | last
    assign host_raw = bare | split: '/' | first
    assign host = host_raw | split: '?' | first | downcase
    assign host_nowww = host | remove_first: 'www.'
    assign own = shop.domain | downcase | remove_first: 'www.'
    assign current = request.host | downcase | remove_first: 'www.'
    if host_nowww == own or host == shop.permanent_domain or host_nowww == current
      assign href = bare | remove_first: host_raw
      if href == blank
        assign href = '/'
      endif
    else
      assign external = '1'
    endif
  endif
  echo href | append: '|' | append: external
-%}
