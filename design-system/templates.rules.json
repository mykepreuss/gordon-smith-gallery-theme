{
  "$comment": "Page-template rules for the Gordon Smith Gallery theme. Human-readable version: DESIGN.md §7. Checked by scripts/lint_theme.py. The new theme (theme/, P-13) uses gs- sections only; the section types without a gs- prefix are Colorblock's, kept so the baseline (baseline/theme/) can still be linted for comparison.",
  "version": 1,
  "sectionGroups": {
    "hero": [
      "gs-hero",
      "gs-page-hero",
      "gs-exhibition-hero",
      "image-banner",
      "slideshow",
      "video"
    ],
    "pageHead": [
      "gs-page-head",
      "gs-title",
      "main-page",
      "gs-entry-head"
    ],
    "collectionHead": [
      "gs-collection-head",
      "main-collection-banner"
    ],
    "switcher": [
      "gs-switcher"
    ],
    "listing": [
      "gs-exhibition-list",
      "gs-card-grid",
      "gs-portfolio-nav",
      "gs-artwork-grid",
      "gs-exhibition-more",
      "gs-whats-on",
      "gs-portfolio-row",
      "collection-list",
      "featured-collection",
      "main-collection-product-grid",
      "main-list-collections",
      "collage",
      "multicolumn",
      "gs-work-grid",
      "gs-artist-index",
      "gs-collection-ways",
      "gs-collection-featured"
    ],
    "cards": [
      "gs-card-groups"
    ],
    "events": [
      "gs-events"
    ],
    "text": [
      "gs-rich-text",
      "gs-page-body",
      "gs-exhibition-body",
      "rich-text",
      "image-with-text",
      "multirow"
    ],
    "gallery": [
      "gs-gallery"
    ],
    "feature": [
      "gs-feature",
      "gs-shop-feature"
    ],
    "visit": [
      "gs-visit"
    ],
    "form": [
      "gs-contact",
      "contact-form"
    ],
    "commerce": [
      "main-product",
      "gs-artwork-detail"
    ],
    "related": [
      "related-products",
      "gs-related",
      "gs-work-more",
      "gs-artist-editions",
      "gs-artist-exhibitions",
      "gs-artist-documents"
    ],
    "legacy": [
      "custom-liquid",
      "apps"
    ],
    "finder": [
      "gs-collection-search"
    ],
    "work": [
      "gs-work-detail"
    ]
  },
  "global": {
    "maxSections": 8,
    "maxPerGroup": {
      "hero": 1,
      "pageHead": 1,
      "switcher": 1,
      "legacy": 0
    },
    "firstGroups": [
      "hero",
      "pageHead"
    ],
    "noRepeatedSurface": [
      "tint",
      "ink",
      "accent"
    ],
    "warnDisabledSections": true,
    "warnUnknownSectionTypes": true,
    "templatesAreClosedSet": true
  },
  "templates": {
    "index": {
      "purpose": "Home",
      "require": [
        "hero"
      ],
      "maxPerGroup": {
        "listing": 3,
        "feature": 2,
        "visit": 1
      }
    },
    "page": {
      "purpose": "Standard page: About, Our Story, Volunteer, FAQ, Upcoming Events, Engage, Donate, Gordon and Marion, Plan Your Visit, On Now, Upcoming Exhibitions and Past Exhibitions (their lists come from Theme settings, DS-48)",
      "maxPerGroup": {
        "text": 3,
        "gallery": 1,
        "feature": 1,
        "listing": 1,
        "cards": 1,
        "events": 1,
        "switcher": 1
      }
    },
    "page.programme": {
      "purpose": "Programme landing: Artists for Kids, The Smith Foundation, Public Programs, Speaker Series, Music at the Smith, Explore + Create, Art in Good Company",
      "maxPerGroup": {
        "text": 3,
        "listing": 1,
        "gallery": 1,
        "feature": 1,
        "cards": 1,
        "events": 1
      }
    },
    "metaobject/exhibition": {
      "purpose": "A single exhibition, rendered from structured exhibition data (proposals/content-model.md); its works from the collection (DS-63)",
      "require": [
        "hero",
        "text"
      ],
      "maxPerGroup": {
        "text": 1,
        "gallery": 2,
        "listing": 2
      }
    },
    "page.permanent-collection": {
      "purpose": "The Permanent Collection's front door (DS-62): introduction, search, ways in, featured works",
      "require": [
        "finder"
      ],
      "maxPerGroup": {
        "text": 1,
        "finder": 1,
        "listing": 2
      }
    },
    "page.artists": {
      "purpose": "Artists A to Z (DS-62): the page's text, then every artist entry",
      "require": [
        "listing"
      ],
      "maxPerGroup": {
        "text": 1,
        "listing": 1
      }
    },
    "metaobject/artist": {
      "purpose": "An artist in the collection (DS-62, DS-63): header, works, documents, editions in the Shop, exhibitions",
      "firstGroups": [
        "pageHead"
      ],
      "require": [
        "pageHead",
        "listing"
      ],
      "maxPerGroup": {
        "listing": 1,
        "related": 3
      }
    },
    "metaobject/artwork": {
      "purpose": "A work in the collection (DS-62): the work and its label, then more by the artist",
      "firstGroups": [
        "work"
      ],
      "require": [
        "work"
      ],
      "maxPerGroup": {
        "work": 1,
        "related": 1
      }
    },
    "metaobject/collection_group": {
      "purpose": "A category, theme or grouping in the collection (DS-62): header and its works",
      "firstGroups": [
        "pageHead"
      ],
      "require": [
        "pageHead",
        "listing"
      ],
      "maxPerGroup": {
        "listing": 1
      }
    },
    "page.shop": {
      "purpose": "Shop / Limited Editions landing (SHOP-01, SHOP-02): one introduction, one portfolio navigation, nothing that repeats it",
      "require": [
        "listing"
      ],
      "maxPerGroup": {
        "listing": 1,
        "text": 1,
        "feature": 1
      }
    },
    "page.contact": {
      "purpose": "Contact",
      "require": [
        "form"
      ],
      "maxPerGroup": {
        "text": 1
      }
    },
    "collection": {
      "purpose": "A portfolio or All Limited Editions",
      "firstGroups": [
        "collectionHead"
      ],
      "require": [
        "collectionHead",
        "switcher",
        "listing"
      ],
      "maxPerGroup": {
        "listing": 1,
        "text": 1
      }
    },
    "product": {
      "purpose": "An artwork (limited edition). Availability and framing come from product data, not separate templates.",
      "firstGroups": [
        "commerce"
      ],
      "require": [
        "commerce"
      ],
      "maxPerGroup": {
        "related": 1,
        "text": 1
      }
    },
    "list-collections": {
      "purpose": "Shopify's /collections page; redirect visitors to the Shop landing instead",
      "legacy": true
    },
    "search": {
      "purpose": "Search results",
      "legacy": true
    },
    "cart": {
      "purpose": "Cart",
      "legacy": true
    },
    "404": {
      "purpose": "Not found",
      "legacy": true
    },
    "password": {
      "purpose": "Password page",
      "legacy": true
    },
    "gift_card": {
      "purpose": "Gift card",
      "legacy": true
    },
    "customers/account": {
      "purpose": "Customer accounts (Shopify system template)",
      "legacy": true
    },
    "customers/activate_account": {
      "purpose": "Customer accounts (Shopify system template)",
      "legacy": true
    },
    "customers/addresses": {
      "purpose": "Customer accounts (Shopify system template)",
      "legacy": true
    },
    "customers/login": {
      "purpose": "Customer accounts (Shopify system template)",
      "legacy": true
    },
    "customers/order": {
      "purpose": "Customer accounts (Shopify system template)",
      "legacy": true
    },
    "customers/register": {
      "purpose": "Customer accounts (Shopify system template)",
      "legacy": true
    },
    "customers/reset_password": {
      "purpose": "Customer accounts (Shopify system template)",
      "legacy": true
    },
    "article": {
      "purpose": "Blog article (News blog is empty)",
      "legacy": true
    },
    "blog": {
      "purpose": "Blog (News blog is empty)",
      "legacy": true
    }
  },
  "lockedSettings": {
    "$comment": "Settings that hand design decisions to staff. They must not exist in gs- sections, and should be removed or hidden from theme sections kept in use.",
    "types": [
      "color",
      "color_background",
      "color_scheme",
      "font_picker",
      "text_alignment"
    ],
    "idPattern": "(^|_)(padding|margin|spacing|gap|height|font_size|text_size|heading_size|size|opacity|overlay|radius|corner|width|alignment|layout)(_|$)",
    "allowIds": [
      "menu",
      "image",
      "image_mobile",
      "heading",
      "eyebrow",
      "text",
      "deck",
      "button_label",
      "button_link",
      "surface",
      "programme",
      "collection",
      "product",
      "page",
      "blog",
      "link_list"
    ]
  },
  "codeRules": {
    "$comment": "Raw values that belong in tokens.css, checked in gs- assets, sections and snippets.",
    "files": [
      "assets/gs-*.css",
      "sections/gs-*.liquid",
      "snippets/gs-*.liquid"
    ],
    "skipFiles": [
      "assets/gs-tokens.css",
      "snippets/gs-logo-*.liquid"
    ],
    "patterns": {
      "raw colour": "#[0-9a-fA-F]{3,8}\\b",
      "raw colour function": "\\b(rgba?|hsla?)\\(",
      "px font size": "font-size:\\s*\\d+(\\.\\d+)?px",
      "inline style colour": "style=\"[^\"]*color:"
    }
  },
  "renderRules": {
    "$comment": "Snippet calls that must pass certain parameters, checked in every Liquid file of the theme.",
    "files": [
      "*.liquid"
    ],
    "snippets": {
      "gs-media": {
        "requireOneOf": [
          "preset",
          "sizes"
        ],
        "message": "pass preset: 'hero', 'card', 'tile', 'gallery' or 'full' (or an explicit sizes:), so the browser downloads the right image width"
      }
    }
  }
}
